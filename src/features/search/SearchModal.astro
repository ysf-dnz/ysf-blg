---
import { langFromUrl, useTranslations } from "@/lib/i18n/index.ts";

const lang = langFromUrl(Astro.url.pathname);
const t = useTranslations(lang);
---

<button
  id="search-open"
  type="button"
  class="flex min-h-11 min-w-11 items-center justify-center gap-1.5 rounded-full px-2 text-ink-muted transition-colors hover:bg-accent-soft hover:text-accent"
  aria-label={t("nav.ara")}
  title={t("nav.ara")}
>
  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <kbd
    class="kbd-pulse hidden rounded border border-line px-1.5 py-0.5 font-sans text-[11px] text-ink-muted md:inline"
    aria-hidden="true"
    data-search-kbd
  >
    ⌘K
  </kbd>
</button>

<dialog
  id="search-dialog"
  class="mx-auto mt-[10vh] w-[min(640px,92vw)] rounded-2xl border border-line bg-surface p-4 text-ink shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
  <div id="search-container" data-lang={lang}></div>
  <p id="search-dev-note" class="hidden py-4 text-center text-sm text-ink-muted">
    {t("arama.devUyari")}
  </p>
</dialog>

<style is:global>
  #search-dialog {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--accent-soft);
    --pagefind-ui-font: var(--font-sans);
  }
</style>

<script>
  // View Transitions uyumu: öğeler her çağrıda yeniden sorgulanır,
  // Pagefind varlıkları window bayrağıyla bir kez yüklenir,
  // UI her yeni sayfanın container'ına yeniden bağlanır.
  declare global {
    interface Window {
      __ysfPagefindAssets?: Promise<void>;
    }
  }

  function loadPagefindAssets(): Promise<void> {
    window.__ysfPagefindAssets ??= new Promise((resolve, reject) => {
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = "/pagefind/pagefind-ui.css";
      document.head.appendChild(css);
      const s = document.createElement("script");
      s.src = "/pagefind/pagefind-ui.js";
      s.onload = () => resolve();
      s.onerror = reject;
      document.head.appendChild(s);
    });
    return window.__ysfPagefindAssets;
  }

  async function openSearch() {
    const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
    if (!dialog) return;
    dialog.showModal();
    const container = document.getElementById("search-container");
    if (!container || container.dataset.init) {
      dialog.querySelector<HTMLInputElement>("input")?.focus();
      return;
    }
    container.dataset.init = "1";
    try {
      // Pagefind varlıkları (postbuild çıktısı) bir kez yüklenir; klasik
      // <script> etiketi kullanılır: import() dev'de Vite dönüşüm hattına
      // girip "/public'ten import edilemez" hatası veriyor.
      await loadPagefindAssets();
      // @ts-expect-error — global PagefindUI
      new PagefindUI({
        element: "#search-container",
        showSubResults: true,
        // dist'te sayfalar dizin (…/index.html) olarak üretilir; Pagefind da
        // linkleri "…/" ile verir. trailingSlash: "never" 404'lememesi için
        // sondaki eğik çizgi kırpılır (alt sonuç linkleri dahil).
        processResult: (result: { url?: string; sub_results?: { url?: string }[] }) => {
          const kirp = (u: string) =>
            u.replace(/\/index\.html$/, "").replace(/(.+)\/$/, "$1");
          if (result?.url) result.url = kirp(result.url);
          for (const alt of result?.sub_results ?? []) {
            if (alt.url) alt.url = kirp(alt.url);
          }
          return result;
        },
        translations:
          container.dataset.lang === "tr"
            ? {
                placeholder: "Yazılarda ve kitaplarda ara…",
                zero_results: "Sonuç yok: [SEARCH_TERM]",
              }
            : { placeholder: "Search posts & books…" },
      });
      dialog.querySelector<HTMLInputElement>("input")?.focus();
    } catch {
      document.getElementById("search-dev-note")?.classList.remove("hidden");
    }
  }

  // Delegasyon: buton/dialog her sayfada değişse de dinleyiciler kalıcı
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("#search-open")) return void openSearch();
    const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
    if (dialog && e.target === dialog) dialog.close();
  });
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
      dialog?.open ? dialog.close() : openSearch();
    }
  });
  // macOS dışında kısayol ipucunu Ctrl K olarak göster
  function fixKbd() {
    if (/Mac|iPhone|iPad/.test(navigator.userAgent)) return;
    const kbd = document.querySelector("[data-search-kbd]");
    if (kbd) kbd.textContent = "Ctrl K";
  }
  document.addEventListener("astro:page-load", fixKbd);
</script>
