---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { localizePath, useTranslations, type Lang } from "@/lib/i18n/index.ts";

interface Props {
  proje: CollectionEntry<"projeler">;
  lang: Lang;
}

const { proje, lang } = Astro.props;
const t = useTranslations(lang);
const durumEtiket = {
  aktif: t("proje.durumAktif"),
  tamamlandi: t("proje.durumTamamlandi"),
  arsiv: t("proje.durumArsiv"),
} as const;
---

<a
  href={localizePath(`/projeler/${proje.id}`, lang)}
  class="group hover-lift shine block h-full rounded-xl border border-line bg-surface-raised p-4 hover:border-accent/50"
>
  {
    proje.data.kapak && (
      <Image
        src={proje.data.kapak}
        alt={proje.data.ad}
        width={640}
        class="mb-3 aspect-video w-full rounded-lg border border-line object-cover"
      />
    )
  }
  <div class="flex items-start justify-between gap-2">
    <span class="font-display text-lg font-semibold text-ink group-hover:text-accent">
      {proje.data.ad}
    </span>
    <span class="mt-1 shrink-0 rounded bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">
      {durumEtiket[proje.data.durum]}
    </span>
  </div>
  <p class="mt-1 text-sm text-ink-muted">{proje.data.aciklama}</p>
  {
    proje.data.etiketler.length > 0 && (
      <p class="mt-3 flex flex-wrap gap-1.5">
        {proje.data.etiketler.map((etiket) => (
          <span class="rounded-full border border-line px-2 py-0.5 text-xs text-ink-muted">
            {etiket}
          </span>
        ))}
      </p>
    )
  }
</a>
