---
/**
 * Sayfa başına SEO meta'ları: canonical, hreflang, OG/Twitter, article meta.
 * Base.astro içinden render edilir.
 */
import { langFromUrl } from "@/lib/i18n/index.ts";

export interface SeoProps {
  title: string;
  description: string;
  /** Diğer dildeki karşılık path'i (varsa hreflang çifti üretilir) */
  translationPath?: string;
  ogImagePath?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  noindex?: boolean;
}

type Props = SeoProps;

const { title, description, translationPath, ogImagePath, article, noindex } =
  Astro.props;

const site = Astro.site!;
const lang = langFromUrl(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(ogImagePath ?? "/og/default.png", site).toString();

// hreflang: yalnızca çeviri varsa; x-default her zaman TR tarafı
const otherLang = lang === "tr" ? "en" : "tr";
const hreflangs = translationPath
  ? [
      { lang, href: canonical },
      { lang: otherLang, href: new URL(translationPath, site).toString() },
      {
        lang: "x-default",
        href: lang === "tr" ? canonical : new URL(translationPath, site).toString(),
      },
    ]
  : [];
---

<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
<link
  rel="alternate"
  type="application/rss+xml"
  title="RSS"
  href={lang === "en" ? "/en/rss.xml" : "/rss.xml"}
/>

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
<meta property="og:site_name" content="Yusuf Deniz" />

{
  article && (
    <>
      <meta
        property="article:published_time"
        content={article.publishedTime.toISOString()}
      />
      {article.modifiedTime && (
        <meta
          property="article:modified_time"
          content={article.modifiedTime.toISOString()}
        />
      )}
      {(article.tags ?? []).map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
