---
import { langFromUrl, useTranslations } from "@/lib/i18n/index.ts";

const t = useTranslations(langFromUrl(Astro.url.pathname));
---

<button
  id="theme-toggle"
  type="button"
  class="flex min-h-11 min-w-11 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-accent-soft hover:text-accent"
  aria-label={t("tema.degistir")}
  title={t("tema.degistir")}
>
  <!-- İkonlar data-theme-pref'e (tercihe) bakar; böylece her basış görünür
       bir değişiklik üretir — system, çözülen temanın ikonuna gizlenmez. -->
  <!-- güneş: tercih=light -->
  <svg class="size-5 hidden [html[data-theme-pref='light']_&]:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <!-- ay: tercih=dark -->
  <svg class="size-5 hidden [html[data-theme-pref='dark']_&]:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <!-- monitör: tercih=system (ilk render'da data-theme-pref yoksa da görünür) -->
  <svg class="size-5 hidden [html[data-theme-pref='system']_&]:block [html:not([data-theme-pref])_&]:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="13" rx="2"></rect>
    <path d="M8 21h8m-4-4v4"></path>
  </svg>
</button>

<script>
  const KEY = "ysf:theme";
  type Pref = "light" | "dark" | "system";
  const order: Pref[] = ["light", "dark", "system"];
  const adlar: Record<Pref, string> = {
    light: "Açık",
    dark: "Koyu",
    system: "Sistem",
  };

  const media = window.matchMedia("(prefers-color-scheme: dark)");

  function apply(pref: Pref) {
    const resolved =
      pref === "system" ? (media.matches ? "dark" : "light") : pref;
    document.documentElement.dataset.theme = resolved;
    document.documentElement.dataset.themePref = pref;
    // Etiket mevcut durumu ve sıradaki adımı söyler (görünür geri bildirim)
    const next = order[(order.indexOf(pref) + 1) % order.length]!;
    const btn = document.getElementById("theme-toggle");
    if (btn) {
      const label = `Tema: ${adlar[pref]} (sıradaki: ${adlar[next]})`;
      btn.setAttribute("aria-label", label);
      btn.setAttribute("title", label);
    }
  }

  // Delegasyon: View Transitions sonrası yeni butonda da çalışır
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("#theme-toggle")) return;
    const current = (localStorage.getItem(KEY) as Pref | null) ?? "system";
    const next = order[(order.indexOf(current) + 1) % order.length]!;
    localStorage.setItem(KEY, next);
    // Destekleyen tarayıcıda tema değişimi yumuşak cross-fade ile
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (document.startViewTransition && !reduced) {
      document.startViewTransition(() => apply(next));
    } else {
      apply(next);
    }
  });

  media.addEventListener("change", () => {
    const pref = (localStorage.getItem(KEY) as Pref | null) ?? "system";
    if (pref === "system") apply(pref);
  });

  // İlk yüklemede ve soft-nav sonrasında etiketi güncelle
  document.addEventListener("astro:page-load", () => {
    apply((localStorage.getItem(KEY) as Pref | null) ?? "system");
  });
</script>
