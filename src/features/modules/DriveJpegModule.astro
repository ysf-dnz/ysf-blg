---
/**
 * Drive'daki link-paylaşımlı bir görseli basar; dosya indirilmez, auth
 * gerekmez. drive.google.com/thumbnail KULLANILMAZ: lh3'e yönlendirmesi
 * tarayıcının ORB korumasına takılıyor — doğrudan lh3 + no-referrer gerekli.
 */
import { driveFileId } from "./parse.ts";

interface Props {
  baslik?: string;
  dosyaId: string;
  genislik: number;
}

const { baslik, dosyaId, genislik } = Astro.props;
const id = driveFileId(dosyaId);
---

{
  id && (
    <section>
      {baslik && (
        <h2 class="font-display mb-3 text-xl font-semibold text-ink">
          {baslik}
        </h2>
      )}
      <img
        src={`https://lh3.googleusercontent.com/d/${id}=w${genislik}`}
        alt={baslik ?? ""}
        loading="lazy"
        referrerpolicy="no-referrer"
        class="h-auto w-full rounded-2xl border border-line bg-surface-raised"
      />
    </section>
  )
}
