---
/**
 * Bildirim zili — SERVER ISLAND (server:defer ile kullanılır).
 *
 * NEDEN VAR: bildirimler 18 ayrı yerde üretiliyordu ama YALNIZCA /uye
 * panosunda, hiçbir okunmamış göstergesi olmadan listeleniyordu. Kullanıcı
 * panoya girmedikçe kendisine yazılan yorumdan, takipten, onaydan haberi
 * olmuyordu — geri dönüş döngüsünün en ucuz halkası kopuktu.
 *
 * Ada olduğu için üstünde durduğu sayfalar statik kalır.
 * Yanında ✉️ Mesajlar bağlantısı ve okunmamış birebir mesaj sayısı (F4-03).
 */
import { and, eq, isNull, sql } from "drizzle-orm";
import { db, schema } from "@/db/client.ts";
import { getOrCreateMember } from "@/lib/member.ts";
import { okunmamisMesaj } from "@/lib/mesaj.ts";
import { R } from "@/lib/routes.ts";

const member = await getOrCreateMember(Astro);

let okunmamis = 0;
// Okunmamış birebir mesaj (F4-03): ayrı uç yok, aynı adada tek sayı; notifications'a yazılmaz
let okunmamisDm = 0;
if (member) {
  const [[row], dm] = await Promise.all([
    db
      .select({ c: sql<number>`count(*)` })
      .from(schema.notifications)
      .where(and(eq(schema.notifications.userId, member.id), isNull(schema.notifications.readAt))),
    okunmamisMesaj(member.id),
  ]);
  okunmamis = Number(row?.c ?? 0);
  okunmamisDm = dm;
}
---

{
  member && (
    <a
      href={R.uye.mesajlar}
      class="relative flex min-h-11 min-w-11 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-accent-soft hover:text-accent"
      title={okunmamisDm > 0 ? `${okunmamisDm} okunmamış mesaj` : "Mesajlar"}
      aria-label={okunmamisDm > 0 ? `${okunmamisDm} okunmamış mesaj` : "Mesajlar"}
      data-dm-zil
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
        <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
      </svg>
      {/* Her zaman DOM'da (hidden): konuşma sayfası okundu yazınca sayıyı yerinde günceller */}
      <span
        class="absolute right-1.5 top-1.5 flex min-w-4 items-center justify-center rounded-full bg-accent px-1 text-[10px] font-bold leading-4 text-surface"
        hidden={okunmamisDm === 0}
        data-dm-rozet
      >
        {okunmamisDm > 9 ? "9+" : okunmamisDm}
      </span>
    </a>
  )
}
{
  member && (
    <a
      href="/uye#bildirimler"
      class="relative flex min-h-11 min-w-11 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-accent-soft hover:text-accent"
      title={okunmamis > 0 ? `${okunmamis} yeni bildirim` : "Bildirimler"}
      aria-label={okunmamis > 0 ? `${okunmamis} yeni bildirim` : "Bildirimler"}
    >
      <svg
        class="size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
      </svg>
      {okunmamis > 0 && (
        <span class="absolute right-1.5 top-1.5 flex min-w-4 items-center justify-center rounded-full bg-accent px-1 text-[10px] font-bold leading-4 text-surface" data-bildirim-rozet>
          {okunmamis > 9 ? "9+" : okunmamis}
        </span>
      )}
    </a>
  )
}
