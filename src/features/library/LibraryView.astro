---
import { getCollection } from "astro:content";
import NotebookCard from "./NotebookCard.astro";
import { localizePath, useTranslations, type Lang } from "@/lib/i18n/index.ts";
import { KUTUPHANEM_URL } from "@/lib/urls.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = await getCollection("libraryCategories");
const notebooks = await getCollection("libraryNotebooks");
const books = (await getCollection("books")).sort(
  (a, b) =>
    (a.data.order ?? 999) - (b.data.order ?? 999) ||
    a.data.title.localeCompare(b.data.title, "tr"),
);
const bookCategories = [...new Set(books.map((b) => b.data.category ?? "genel"))].sort(
  (a, b) => a.localeCompare(b, "tr"),
);

const byCategory = new Map(
  categories.map((c) => [
    c.data.id,
    notebooks
      .filter((n) => n.data.category === c.data.id)
      .sort((a, b) => b.data.sourceCount - a.data.sourceCount),
  ]),
);
const sorted = [...categories].sort(
  (a, b) => b.data.notebookCount - a.data.notebookCount,
);
const toplamKaynak = notebooks.reduce((s, n) => s + n.data.sourceCount, 0);
---

<section>
  <header class="girih-texture -mx-4 px-4 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">
      {t("kutuphane.baslik")}
    </h1>
    <p class="mt-3 max-w-xl text-ink-muted">{t("kutuphane.aciklama")}</p>
    <p class="mt-4 flex flex-wrap gap-4 text-sm text-ink-muted">
      <span>
        <strong class="text-accent">{notebooks.length}</strong> {t("kutuphane.defter")}
      </span>
      <span>
        <strong class="text-accent">{toplamKaynak}</strong> {t("kutuphane.kaynak")}
      </span>
      <a
        href={KUTUPHANEM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-accent hover:underline"
      >
        {t("home.zihinHaritam")} ↗
      </a>
    </p>
  </header>

  {
    books.length > 0 && (
      <section class="mt-10">
        <h2 class="font-display text-2xl font-semibold text-ink">
          {t("kutuphane.kitapRafi")}
          <span class="ml-2 text-base font-normal text-ink-muted">
            ({books.length})
          </span>
        </h2>
        {bookCategories.map((cat, i) => {
          const catBooks = books.filter(
            (b) => (b.data.category ?? "genel") === cat,
          );
          return (
            <details open={i === 0} class="group mt-4">
              <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-line bg-surface-raised px-4 py-3 font-display text-lg font-semibold text-ink hover:border-accent/50 [&::-webkit-details-marker]:hidden">
                <svg
                  class="size-4 text-ink-muted transition-transform group-open:rotate-90"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="m9 6 6 6-6 6" />
                </svg>
                {cat}
                <span class="text-sm font-normal text-ink-muted">
                  ({catBooks.length})
                </span>
              </summary>
              <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
                {catBooks.map((book) => (
                  <li>
                    <a
                      href={localizePath(`/kutuphane/kitap/${book.data.id}`, lang)}
                      class="group/book block"
                    >
                      {book.data.cover ? (
                        <img
                          src={book.data.cover}
                          alt={book.data.title}
                          loading="lazy"
                          width="320"
                          class="aspect-[3/4] w-full rounded-lg border border-line object-cover object-top shadow-sm transition-transform group-hover/book:-translate-y-1"
                        />
                      ) : (
                        <span class="flex aspect-[3/4] w-full items-center justify-center rounded-lg border border-line bg-accent-soft p-3 text-center font-display text-sm font-semibold text-accent transition-transform group-hover/book:-translate-y-1">
                          {book.data.title}
                        </span>
                      )}
                      <span class="mt-2 block truncate text-sm font-medium text-ink group-hover/book:text-accent">
                        {book.data.title}
                      </span>
                      {book.data.author && (
                        <span class="block truncate text-xs text-ink-muted">
                          {book.data.author}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          );
        })}
      </section>
    )
  }

  <div class="mt-10 space-y-10">
    {
      sorted.map((cat) => (
        <section>
          <h2 class="font-display flex items-center gap-2 text-xl font-semibold text-ink">
            <span
              class="size-3.5 rounded-full"
              style={`background-color:${cat.data.color}`}
              aria-hidden="true"
            />
            {cat.data.name}
            <span class="text-sm font-normal text-ink-muted">
              ({cat.data.notebookCount})
            </span>
          </h2>
          {cat.data.full && (
            <p class="mt-1 text-sm text-ink-muted">{cat.data.full}</p>
          )}
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {(byCategory.get(cat.data.id) ?? []).map((nb) => (
              <li>
                <NotebookCard notebook={nb.data} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>
