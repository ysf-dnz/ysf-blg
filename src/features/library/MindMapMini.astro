---
/**
 * Ana sayfadaki "Zihin Haritam" bölümü — kutuphanem neural graph
 * estetiğinde dekoratif mini SVG + kutuphanem'e link.
 */
import { langFromUrl, useTranslations } from "@/lib/i18n/index.ts";
import { KUTUPHANEM_URL } from "@/lib/urls.ts";

const t = useTranslations(langFromUrl(Astro.url.pathname));

// Deterministik dekoratif düğüm yerleşimi
const nodes = [
  { x: 150, y: 60, r: 10 },
  { x: 60, y: 110, r: 6 },
  { x: 240, y: 100, r: 7 },
  { x: 110, y: 170, r: 8 },
  { x: 210, y: 175, r: 5 },
  { x: 30, y: 50, r: 4 },
  { x: 270, y: 45, r: 5 },
  { x: 160, y: 130, r: 5 },
];
const edges: [number, number][] = [
  [0, 1], [0, 2], [0, 7], [1, 3], [2, 4], [3, 7], [4, 7], [1, 5], [2, 6],
];
---

<a
  href={KUTUPHANEM_URL}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col items-center gap-6 rounded-2xl border border-line bg-surface-raised p-8 transition-colors hover:border-accent/50 sm:flex-row"
>
  <svg
    viewBox="0 0 300 220"
    class="w-48 shrink-0 text-accent"
    aria-hidden="true"
  >
    {
      edges.map(([a, b]) => (
        <line
          x1={nodes[a]!.x}
          y1={nodes[a]!.y}
          x2={nodes[b]!.x}
          y2={nodes[b]!.y}
          stroke="currentColor"
          stroke-opacity="0.3"
          stroke-width="1.2"
          pathLength={1}
        />
      ))
    }
    {
      nodes.map((n, i) => (
        <circle
          cx={n.x}
          cy={n.y}
          r={n.r}
          fill="currentColor"
          fill-opacity={i === 0 ? 0.9 : 0.55}
          class="transition-transform group-hover:scale-105 active:scale-[0.97]"
          style={`transform-origin: ${n.x}px ${n.y}px; --i:${i}`}
        />
      ))
    }
  </svg>
  <div>
    <h2 class="font-display text-2xl font-semibold text-ink group-hover:text-accent">
      {t("home.zihinHaritam")}
    </h2>
    <p class="mt-2 text-ink-muted">{t("home.zihinHaritamAciklama")}</p>
    <span class="mt-3 inline-block text-sm font-medium text-accent">
      ysf-dnz.github.io/kutuphanem <span class="arrow-slide">→</span>
    </span>
  </div>
</a>
