---
/**
 * Kitap detay sayfası: büyük kapak, çekmece (accordion) soru-cevaplar,
 * tıkla-yükle Drive önizlemesi, NotebookLM sohbet köprüsü.
 * Akordeon native <details> — sıfır JS; embed tek küçük inline script.
 */
import type { CollectionEntry } from "astro:content";
import { marked } from "marked";
import { localizePath, useTranslations, type Lang } from "@/lib/i18n/index.ts";

interface Props {
  book: CollectionEntry<"books">["data"];
  qa?: CollectionEntry<"booksQa">["data"];
  lang: Lang;
}

const { book, qa, lang } = Astro.props;
const t = useTranslations(lang);
const notebookUrl = book.notebookId
  ? `https://notebooklm.google.com/notebook/${book.notebookId}`
  : undefined;
const previewUrl = `https://drive.google.com/file/d/${book.id}/preview`;
---

<article class="mx-auto max-w-xl">
  <a
    href={localizePath("/kutuphane", lang)}
    class="text-sm text-ink-muted hover:text-accent"
  >
    ← {t("kitap.rafaDon")}
  </a>

  <!-- Kapak kartı -->
  <header class="mt-4 overflow-hidden rounded-2xl border border-line bg-surface-raised shadow-lg">
    {
      book.cover ? (
        <img
          src={book.cover}
          alt={book.title}
          width="640"
          class="aspect-auto w-full object-cover"
        />
      ) : (
        <div class="girih-texture flex aspect-[3/2] items-center justify-center bg-accent-soft p-8">
          <span class="font-display text-center text-2xl font-semibold text-accent">
            {book.title}
          </span>
        </div>
      )
    }
    <div class="p-5">
      <h1 class="font-display text-2xl font-semibold leading-snug text-ink">
        {book.title}
      </h1>
      <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-muted">
        {book.author && <span>{book.author}</span>}
        <span class="rounded bg-accent-soft px-2 py-0.5 text-xs font-medium uppercase text-accent">
          {book.format}
        </span>
        {book.category && <span>{book.category}</span>}
      </p>
    </div>
  </header>

  <!-- Çekmeceler -->
  {
    qa && qa.bolumler.length > 0 && (
      <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5">
        <h2 class="font-display text-xl font-semibold text-ink">
          {t("kitap.sorular")}
        </h2>
        <p class="mt-1 text-xs text-ink-muted">
          {t("kitap.guncelleme")}: {qa.guncellenme.toISOString().slice(0, 10)} ·
          NotebookLM
        </p>
        {qa.bolumler.map((bolum) => (
          <div class="mt-5">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-accent">
              {bolum.baslik}
            </h3>
            <div class="mt-1 divide-y divide-line">
              {bolum.sorular.map((s) => (
                <details class="group py-3">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-[15px] font-medium text-ink hover:text-accent [&::-webkit-details-marker]:hidden">
                    {s.soru}
                    <svg
                      class="size-4 shrink-0 text-ink-muted transition-transform group-open:rotate-180"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </summary>
                  <div
                    class="prose prose-sm mt-2 max-w-none text-ink-muted dark:prose-invert prose-a:text-accent"
                    set:html={marked.parse(s.cevap)}
                  />
                </details>
              ))}
            </div>
          </div>
        ))}
      </section>
    )
  }

  <!-- Drive önizleme (tıkla-yükle) -->
  <section class="mt-8">
    <h2 class="font-display text-xl font-semibold text-ink">{t("kitap.oku")}</h2>
    <div
      id="book-embed"
      class="mt-3 overflow-hidden rounded-2xl border border-line"
      data-preview-url={previewUrl}
    >
      <button
        type="button"
        id="book-embed-load"
        class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-3 bg-surface-raised text-ink-muted transition-colors hover:text-accent"
      >
        <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4a2 2 0 0 0-2-2H6.5A2.5 2.5 0 0 0 4 4.5v15Z"></path>
          <path d="M20 17v5H6.5a2.5 2.5 0 0 1 0-5"></path>
        </svg>
        <span class="text-sm font-medium">{t("kitap.okuYukle")}</span>
      </button>
    </div>
    <p class="mt-2 text-right">
      <a
        href={book.driveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-ink-muted hover:text-accent"
      >
        {t("kitap.driveAc")} ↗
      </a>
    </p>
  </section>

  <!-- Sohbet köprüsü -->
  <section class="mt-8 rounded-2xl border border-accent/30 bg-accent-soft p-6 text-center">
    {
      notebookUrl ? (
        <>
          <a
            href={notebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-medium text-white transition-opacity hover:opacity-90"
          >
            📔 {t("kitap.sohbet")}
          </a>
          <p class="mt-3 text-sm text-ink-muted">{t("kitap.sohbetAciklama")}</p>
        </>
      ) : (
        <p class="text-sm text-ink-muted">{t("kitap.sohbetYok")}</p>
      )
    }
  </section>
</article>

<script>
  // Drive iframe'i yalnızca istek üzerine yüklenir (perf + üçüncü taraf izolasyonu)
  const wrap = document.getElementById("book-embed");
  document.getElementById("book-embed-load")?.addEventListener("click", () => {
    if (!wrap) return;
    const iframe = document.createElement("iframe");
    iframe.src = wrap.dataset.previewUrl!;
    iframe.className = "aspect-[4/3] w-full";
    iframe.allow = "autoplay";
    iframe.setAttribute("loading", "lazy");
    wrap.replaceChildren(iframe);
  });
</script>
