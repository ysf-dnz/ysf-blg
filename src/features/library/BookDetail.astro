---
/**
 * Kitap detay sayfası: büyük kapak, çekmece (accordion) soru-cevaplar,
 * Drive önizlemesi, ek pencereler, indirme planları, NotebookLM sohbeti.
 * Bölüm SIRASI panelden yönetilir (Keystatic → Kütüphane → Kitap Sayfası
 * Düzeni → src/content/site/kitap-sayfa.yaml); listeden çıkarılan bölüm
 * render edilmez. Akordeon native <details> — sıfır JS.
 */
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import { marked } from "marked";
import { localizePath, useTranslations, type Lang } from "@/lib/i18n/index.ts";
import { KATEGORILER } from "@/lib/kategorize.ts";
import OkumaKapisi from "./OkumaKapisi.astro";
import type { Modul } from "@/features/modules/schema.ts";

interface Props {
  book: CollectionEntry<"books">["data"];
  qa?: CollectionEntry<"booksQa">["data"];
  /** Panelden eklenen ek pencereler (bookExtras) — Okuma Kapısı adasında,
   *  yalnızca erişimi olana render edilir */
  moduller?: Modul[];
  lang: Lang;
}

// Sayfa STATİK ve Pagefind'de aranabilir; üyelik/erişim/puan dinamikleri
// OkumaKapisi server island'ında istek anında çözülür.
const { book, qa, moduller = [], lang } = Astro.props;
const yazYolu = `/uye/yaz?kitap=${encodeURIComponent(book.id)}`;
const t = useTranslations(lang);

// "planlar" (abonelik) kaldırıldı — erişim yalnızca emekle kazanılır.
const VARSAYILAN_SIRA = ["sorular", "ozet", "oku", "moduller", "sohbet"] as const;
const duzen = await getEntry("siteConfig", "kitap-sayfa");
const sira = duzen?.data.sira?.length ? duzen.data.sira : [...VARSAYILAN_SIRA];

// NotebookLM linki BİLİNÇLİ olarak burada kurulmaz: bu sayfa statiktir ve
// misafire de servis edilir. Link, erişim sunucuda doğrulandıktan sonra
// OkumaKapisi adasında (kilidin ardında) render edilir.

const kategori = KATEGORILER.find((k) => k.key === book.category);

// 💎 Nöropazarlama değer notu (NotebookLM'den üretilir; varsa gösterilir)
import degerNotlari from "@/data/deger-notlari.json";
const degerNotu = (
  degerNotlari as Record<string, { baslik?: string; metin?: string }>
)[book.id];
---

<article class="mx-auto max-w-xl">
  <a
    href={localizePath("/kutuphane", lang)}
    class="text-sm text-ink-muted hover:text-accent"
  >
    ← {t("kitap.rafaDon")}
  </a>

  {/* 🗝️ Hazine açılış kutlaması: puanla kilit açılınca (?acildi=1) —
      konfeti + tüm içeriğin anahtarları (oku · indir · NotebookLM) + paylaşım.

      GÜVENLİK: bu sayfa STATİKTİR, bu yüzden hiçbir Drive/NotebookLM linki
      buraya yazılmaz ve istemcide kurulmaz. Bantın linkleri
      /api/uye/kitap-linkler'den gelir; o uç erişimi SUNUCUDA doğrular.
      (Eskiden misafir `?acildi=1` yazarak çalışan indirme linki alıyordu.) */}
  <div
    id="acildi-band"
    hidden
    data-book-id={book.id}
    class="menu-pop relative mt-4 overflow-hidden rounded-2xl border border-accent bg-accent-soft p-5 text-center"
  >
    <p class="font-display text-2xl font-semibold text-ink">🗝️ Hazine açıldı!</p>
    <p class="mt-1 text-sm text-ink-muted">
      Bu kitap artık kütüphanende — okuma, indirme ve kitaptan derlenen tüm
      içerikler (özet, sorular, NotebookLM sohbeti{moduller.length > 0 && ", slayt/podcast pencereleri"}) aynı anda açıldı.
    </p>
    <div class="mt-3 flex flex-wrap justify-center gap-2">
      <a id="acildi-indir" href="#" hidden class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">📥 Bilgisayarına indir</a>
      <a id="acildi-oku" href="#" hidden target="_blank" rel="noopener noreferrer" class="rounded-full border border-accent px-5 py-2.5 text-sm font-medium text-accent transition-colors hover:bg-accent hover:text-surface">📖 Drive'da aç</a>
      <a id="acildi-notebook" href="#" hidden target="_blank" rel="noopener noreferrer" class="rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent hover:text-accent">💬 NotebookLM'de sor</a>
    </div>
    {/* 📣 Kutlama anı = paylaşım anı: kazanımı paylaşmanın en doğal yeri */}
    <div class="mt-4 border-t border-accent/30 pt-3">
      <p class="text-xs text-ink-muted">Bu hazineyi emekle açtın — arkadaşını da çağır, ilk kitabı hediye:</p>
      <span class="mt-2 flex flex-wrap justify-center gap-1.5">
        <button type="button" id="acildi-davet" data-davet-karti data-kitap={book.titleTr ?? book.title} data-kapak={book.cover ?? ""} data-ref="" class="pill-pop cursor-pointer rounded-full bg-accent px-3 py-1 text-xs font-medium text-surface">🎴 Davet kartı oluştur</button>
        <a id="acildi-wa" href="#" hidden target="_blank" rel="noopener noreferrer" class="pill-pop rounded-full border border-line px-3 py-1 text-xs font-medium hover:border-accent hover:text-accent">WhatsApp</a>
        <button type="button" id="acildi-kopyala" data-ref-kopyala="" class="pill-pop cursor-pointer rounded-full border border-line px-3 py-1 text-xs font-medium hover:border-accent hover:text-accent">Instagram için kopyala</button>
      </span>
    </div>
  </div>

  {/* Hediye kutlaması: ?hediye=1 ile gelindiğinde görünür. Drive linki
      statik HTML'e YAZILMAZ ve istemcide KURULMAZ — auth'lu uçtan gelir. */}
  <div
    id="hediye-band"
    hidden
    data-book-id={book.id}
    class="menu-pop mt-4 rounded-2xl border border-accent bg-accent-soft p-5 text-center"
  >
    <p class="font-display text-xl font-semibold text-ink">🎁 Hediyen açıldı!</p>
    <p class="mt-1 text-sm text-ink-muted">
      Kitap artık senin — hemen okumaya başla, bitirince ilk yazını yaz.
    </p>
    <div class="mt-3 flex flex-wrap justify-center gap-2">
      <a
        id="hediye-drive"
        href="#"
        hidden
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]"
      >
        📖 Drive'da hemen aç
      </a>
      <a
        href={yazYolu}
        class="rounded-full border border-accent px-5 py-2.5 text-sm font-medium text-accent transition-colors hover:bg-accent hover:text-surface"
      >
        ✍️ Yazını başlat (+100)
      </a>
    </div>
  </div>
  <script>
    // Ref linkini panoya kopyala (Instagram paylaşımı için) — island
    // içeriği sonradan geldiğinden delegasyonla dinlenir
    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-ref-kopyala]");
      if (!btn) return;
      await navigator.clipboard.writeText(btn.dataset.refKopyala ?? "");
      btn.textContent = "Kopyalandı ✓";
      setTimeout(() => (btn.textContent = "Instagram için kopyala"), 2000);
    });

    // 📖 İlk-10-sayfa önizlemesi: panel İLK açıldığında iframe'e src atanır
    // (ağır önizleme ucu görüntülenmeden tetiklenmesin) — island delegasyonu
    document.addEventListener("click", (e) => {
      const ozet = (e.target as HTMLElement).closest("[data-onizleme] summary");
      if (!ozet) return;
      const panel = ozet.parentElement as HTMLElement;
      const frame = panel.querySelector<HTMLIFrameElement>("[data-onizleme-frame]");
      if (frame && !frame.src) {
        frame.src = `/api/kitap-onizleme?bookId=${encodeURIComponent(panel.dataset.kitap ?? "")}`;
      }
    });
    // 🎊 Konfeti: hazine açılışında ekrana emoji parçacıkları yağar
    // (WAAPI, CSS reduced-motion kuralına girmez — burada elle atlanır)
    function konfeti(hedef: HTMLElement) {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const parcalar = ["🎉", "✨", "🗝️", "📚", "⭐"];
      for (let i = 0; i < 36; i++) {
        const p = document.createElement("span");
        p.textContent = parcalar[i % parcalar.length]!;
        p.style.cssText = `position:absolute;top:-24px;left:${Math.random() * 100}%;font-size:${14 + Math.random() * 14}px;pointer-events:none;z-index:5`;
        hedef.appendChild(p);
        p.animate(
          [
            { transform: "translateY(0) rotate(0deg)", opacity: 1 },
            { transform: `translateY(${180 + Math.random() * 160}px) rotate(${Math.random() > 0.5 ? "" : "-"}${180 + Math.random() * 360}deg)`, opacity: 0 },
          ],
          { duration: 1600 + Math.random() * 1400, delay: Math.random() * 600, easing: "cubic-bezier(0.16,1,0.3,1)", fill: "forwards" },
        );
        setTimeout(() => p.remove(), 4000);
      }
    }

    /**
     * Kutlama bandının linkleri SUNUCUDAN alınır. Erişimi olmayan (misafir
     * dahil) 403 alır ve bant hiç açılmaz — `?acildi=1` yazmak tek başına
     * hiçbir şey açmaz. Statik HTML'de hiçbir Drive linki yoktur.
     */
    async function bandiDoldur(band: HTMLElement) {
      const bookId = band.dataset.bookId;
      if (!bookId) return false;
      let veri: {
        indir: string; oku: string; notebook: string | null;
        ref: string; kitapAdi: string; kapak: string | null;
      };
      try {
        const yanit = await fetch(
          `/api/uye/kitap-linkler?bookId=${encodeURIComponent(bookId)}`,
          { credentials: "same-origin" },
        );
        if (!yanit.ok) return false;
        veri = await yanit.json();
      } catch {
        return false;
      }
      const kur = (id: string, href: string | null) => {
        const el = document.getElementById(id) as HTMLAnchorElement | null;
        if (!el || !href) return;
        el.href = href;
        el.removeAttribute("hidden");
      };
      kur("acildi-indir", veri.indir);
      kur("acildi-oku", veri.oku);
      kur("acildi-notebook", veri.notebook);
      kur("hediye-drive", veri.oku);

      // Paylaşım kancaları da aynı yanıttan beslenir (ref link üyeye özel)
      const metin = encodeURIComponent(
        `"${veri.kitapAdi}" kitabını emekle açtım — burada kitaplar parayla değil emekle açılıyor. Sen de katıl, ilk kitabın hediye: ${veri.ref}`,
      );
      kur("acildi-wa", `https://wa.me/?text=${metin}`);
      const davet = document.getElementById("acildi-davet");
      if (davet) davet.dataset.ref = veri.ref;
      const kopyala = document.getElementById("acildi-kopyala");
      if (kopyala) kopyala.dataset.refKopyala = veri.ref;
      return true;
    }

    document.addEventListener("astro:page-load", async () => {
      const params = new URLSearchParams(location.search);

      const band = document.getElementById("hediye-band");
      if (band && params.get("hediye") === "1" && (await bandiDoldur(band))) {
        band.removeAttribute("hidden");
        konfeti(band);
      }

      const acildi = document.getElementById("acildi-band");
      if (acildi && params.get("acildi") === "1" && (await bandiDoldur(acildi))) {
        acildi.removeAttribute("hidden");
        konfeti(acildi);
      }
    });

    // 🎴 Davet kartı: kitap kapaklı, nöropazarlama metinli 1080×1350 PNG
    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-davet-karti]");
      if (!btn) return;
      btn.textContent = "Hazırlanıyor…";
      const W = 1080, H = 1350;
      const c = document.createElement("canvas");
      c.width = W; c.height = H;
      const ctx = c.getContext("2d")!;
      // Çini degrade zemin
      const g = ctx.createLinearGradient(0, 0, W, H);
      g.addColorStop(0, "#0a2b33"); g.addColorStop(0.6, "#19646d"); g.addColorStop(1, "#239ba1");
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
      // Kapak (CORS izinliyse)
      const kapak = btn.dataset.kapak;
      if (kapak) {
        try {
          const img = new Image();
          img.crossOrigin = "anonymous";
          await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = kapak; });
          const kw = 460, kh = (kw * img.height) / img.width;
          ctx.save();
          ctx.shadowColor = "rgba(0,0,0,0.5)"; ctx.shadowBlur = 40; ctx.shadowOffsetY = 16;
          ctx.drawImage(img, (W - kw) / 2, 130, kw, kh);
          ctx.restore();
        } catch { /* kapak çizilemedi — metinle devam */ }
      }
      ctx.fillStyle = "#ffffff"; ctx.textAlign = "center";
      ctx.font = "600 52px Georgia, serif";
      const baslik = btn.dataset.kitap ?? "";
      // Uzun başlığı iki satıra böl
      const kelimeler = baslik.split(" ");
      let satir = "", satirlar: string[] = [];
      for (const k of kelimeler) {
        if ((satir + " " + k).length > 28) { satirlar.push(satir.trim()); satir = k; }
        else satir += " " + k;
      }
      satirlar.push(satir.trim());
      satirlar.slice(0, 2).forEach((s, i) => ctx.fillText(s, W / 2, 880 + i * 62));
      ctx.font = "34px Georgia, serif"; ctx.fillStyle = "#d5f4f2";
      ctx.fillText("Bu bilgi hazinesi seni bekliyor.", W / 2, 1030);
      ctx.fillText("Katıl — ilk kitabın hediye 🎁", W / 2, 1082);
      ctx.font = "600 30px monospace"; ctx.fillStyle = "#79d5d6";
      ctx.fillText((btn.dataset.ref ?? "").replace(/^https?:\/\//, ""), W / 2, 1190);
      // İndir / paylaş
      c.toBlob(async (blob) => {
        if (!blob) return;
        const dosya = new File([blob], "davet-karti.png", { type: "image/png" });
        if (navigator.canShare?.({ files: [dosya] })) {
          try { await navigator.share({ files: [dosya], text: btn.dataset.ref }); } catch {}
        } else {
          const a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = "davet-karti.png";
          a.click();
        }
        btn.textContent = "🎴 Davet kartı oluştur";
      }, "image/png");
    });
  </script>

  <!-- Kapak kartı -->
  <header class="mt-4 overflow-hidden rounded-2xl border border-line bg-surface-raised shadow-lg">
    {
      book.cover ? (
        <img
          src={book.cover}
          alt={book.title}
          width="640"
          class="cover-float aspect-auto w-full object-cover"
        />
      ) : (
        <div class="girih-texture flex aspect-[3/2] items-center justify-center bg-accent-soft p-8">
          <span class="font-display text-center text-2xl font-semibold text-accent">
            {book.title}
          </span>
        </div>
      )
    }
    <!-- data-pagefind-body: kitap TR+EN adı ve yazarıyla aramada bulunur;
         özet/soru metinleri bilinçli olarak indeks dışıdır -->
    <div class="p-5" data-pagefind-body>
      <h1 class="font-display text-2xl font-semibold leading-snug text-ink">
        {book.titleTr ?? book.title}
      </h1>
      {book.titleTr && book.titleTr !== book.title && (
        <p class="mt-1 text-sm italic text-ink-muted">{book.title}</p>
      )}
      <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-muted">
        {book.author && <span>{book.author}</span>}
        <span class="rounded bg-accent-soft px-2 py-0.5 text-xs font-medium uppercase text-accent">
          {book.format}
        </span>
        {kategori && (
          <span class="flex items-center gap-1.5" data-pagefind-filter="kategori">
            <span
              class="size-2.5 rounded-full"
              style={`background-color:${kategori.renk}`}
              aria-hidden="true"
            />
            {kategori.ad}
          </span>
        )}
      </p>
    </div>
  </header>

  {
    degerNotu?.metin && (
      <section class="shine mt-4 rounded-2xl border border-accent/40 bg-accent-soft/40 p-5" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-wide text-accent">
          💎 Bu kitap sana ne katacak?
        </p>
        {degerNotu.baslik && (
          <h2 class="font-display mt-1 text-lg font-semibold text-ink">{degerNotu.baslik}</h2>
        )}
        <p class="mt-2 text-[15px] leading-relaxed text-ink">{degerNotu.metin}</p>
      </section>
    )
  }

  {
    sira.map((bolum) => {
      if (bolum === "sorular")
        return (
          qa &&
          qa.bolumler.length > 0 && (
            <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5">
              <h2 class="font-display text-xl font-semibold text-ink">
                {t("kitap.sorular")}
              </h2>
              <p class="mt-1 text-xs text-ink-muted">
                {t("kitap.guncelleme")}: {qa.guncellenme.toISOString().slice(0, 10)} ·
                NotebookLM
              </p>
              {qa.bolumler.map((qaBolum) => (
                <div class="mt-5">
                  <h3 class="text-xs font-semibold uppercase tracking-wider text-accent">
                    {qaBolum.baslik}
                  </h3>
                  <div class="mt-1 divide-y divide-line">
                    {qaBolum.sorular.map((s) => (
                      <details class="group py-3">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-[15px] font-medium text-ink hover:text-accent [&::-webkit-details-marker]:hidden">
                          {s.soru}
                          <svg
                            class="size-4 shrink-0 text-ink-muted transition-transform group-open:rotate-180"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            aria-hidden="true"
                          >
                            <path d="m6 9 6 6 6-6" />
                          </svg>
                        </summary>
                        <div
                          class="prose prose-sm mt-2 max-w-none text-ink-muted dark:prose-invert prose-a:text-accent"
                          set:html={marked.parse(s.cevap)}
                        />
                      </details>
                    ))}
                  </div>
                </div>
              ))}
            </section>
          )
        );

      if (bolum === "ozet")
        return (
          qa?.ozet &&
          qa.ozet.length > 0 && (
            <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5">
              <h2 class="font-display text-xl font-semibold text-ink">
                {t("kitap.ozet")}
              </h2>
              <p class="mt-1 text-xs text-ink-muted">{t("kitap.ozetAciklama")}</p>
              <div class="mt-3 divide-y divide-line">
                {qa.ozet.map((parca) => (
                  <details class="group py-3">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-display text-[16px] font-semibold text-ink hover:text-accent [&::-webkit-details-marker]:hidden">
                      {parca.baslik}
                      <svg
                        class="size-4 shrink-0 text-ink-muted transition-transform group-open:rotate-180"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        aria-hidden="true"
                      >
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </summary>
                    <div
                      class="prose prose-sm mt-3 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-accent"
                      set:html={marked.parse(parca.icerik)}
                    />
                  </details>
                ))}
              </div>
            </section>
          )
        );

      if (bolum === "oku")
        return (
          // Okuma Kapısı: dinamik erişim server island'da; sayfa statik kalır
          <OkumaKapisi
            server:defer
            bookId={book.id}
            bookTitle={book.title}
            lang={lang}
            moduller={moduller}
            cover={book.cover ?? null}
            notebookId={book.notebookId ?? null}
          >
            <section slot="fallback" class="mt-8" aria-busy="true">
              <h2 class="font-display text-xl font-semibold text-ink">
                {t("kitap.oku")}
              </h2>
              <div class="mt-3 h-40 animate-pulse rounded-2xl border border-line bg-surface-raised" />
            </section>
          </OkumaKapisi>
        );

      if (bolum === "moduller") return null; // Okuma Kapısı adasında

      // "planlar" bölümü kaldırıldı: abonelik/indirme planları yok —
      // erişim yalnızca emekle (puan/hediye) kazanılır.
      if (bolum === "planlar") return null;

      // sohbet — NotebookLM linki KİLİDİN ARDINDADIR (Okuma Kapısı adasında
      // render edilir). Burada yalnız vitrin durur: link statik HTML'e
      // yazılırsa misafir kitabı hiç açmadan tam metin üzerinden soru sorabilir.
      return (
        <section class="mt-8 rounded-2xl border border-accent/30 bg-accent-soft p-6 text-center">
          {book.notebookId ? (
            <p class="text-sm text-ink-muted">📔 {t("kitap.sohbetAciklama")}</p>
          ) : (
            <p class="text-sm text-ink-muted">{t("kitap.sohbetYok")}</p>
          )}
        </section>
      );
    })
  }
</article>
