---
/**
 * Kitap detay sayfası: büyük kapak, çekmece (accordion) soru-cevaplar,
 * Drive önizlemesi, ek pencereler, indirme planları, NotebookLM sohbeti.
 * Bölüm SIRASI panelden yönetilir (Keystatic → Kütüphane → Kitap Sayfası
 * Düzeni → src/content/site/kitap-sayfa.yaml); listeden çıkarılan bölüm
 * render edilmez. Akordeon native <details> — sıfır JS.
 */
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import { marked } from "marked";
import { localizePath, useTranslations, type Lang } from "@/lib/i18n/index.ts";
import { KATEGORILER } from "@/lib/kategorize.ts";
import DriveEmbed from "./DriveEmbed.astro";
import ModuleList from "@/features/modules/ModuleList.astro";
import type { Modul } from "@/features/modules/schema.ts";

interface Props {
  book: CollectionEntry<"books">["data"];
  qa?: CollectionEntry<"booksQa">["data"];
  /** Panelden eklenen ek pencereler (bookExtras) */
  moduller?: Modul[];
  lang: Lang;
}

const { book, qa, moduller = [], lang } = Astro.props;
const t = useTranslations(lang);

const VARSAYILAN_SIRA = [
  "sorular",
  "ozet",
  "oku",
  "moduller",
  "planlar",
  "sohbet",
] as const;
const duzen = await getEntry("siteConfig", "kitap-sayfa");
const sira = duzen?.data.sira?.length ? duzen.data.sira : [...VARSAYILAN_SIRA];

const notebookUrl = book.notebookId
  ? `https://notebooklm.google.com/notebook/${book.notebookId}`
  : undefined;
// İndirme erişimi e-postayla istenir; limitler Drive tarafında uygulanır
const requestMail =
  `mailto:sn.yusufdeniz@gmail.com` +
  `?subject=${encodeURIComponent(`Kitap erişim isteği: ${book.title}`)}` +
  `&body=${encodeURIComponent(
    `Merhaba,\n\n"${book.title}" kitabı için indirme erişimi istiyorum.\n` +
      `Kitap ID: ${book.id}\nPlanım: Abone / Pro / Max (birini bırakın)\n\nTeşekkürler.`,
  )}`;

const kategori = KATEGORILER.find((k) => k.key === book.category);

const planlar = [
  { ad: t("kitap.planStandart"), limit: t("kitap.planStandartLimit") },
  { ad: t("kitap.planPro"), limit: t("kitap.planProLimit"), one: true },
  { ad: t("kitap.planMax"), limit: t("kitap.planMaxLimit") },
];
---

<article class="mx-auto max-w-xl">
  <a
    href={localizePath("/kutuphane", lang)}
    class="text-sm text-ink-muted hover:text-accent"
  >
    ← {t("kitap.rafaDon")}
  </a>

  <!-- Kapak kartı -->
  <header class="mt-4 overflow-hidden rounded-2xl border border-line bg-surface-raised shadow-lg">
    {
      book.cover ? (
        <img
          src={book.cover}
          alt={book.title}
          width="640"
          class="aspect-auto w-full object-cover"
        />
      ) : (
        <div class="girih-texture flex aspect-[3/2] items-center justify-center bg-accent-soft p-8">
          <span class="font-display text-center text-2xl font-semibold text-accent">
            {book.title}
          </span>
        </div>
      )
    }
    <!-- data-pagefind-body: kitap TR+EN adı ve yazarıyla aramada bulunur;
         özet/soru metinleri bilinçli olarak indeks dışıdır -->
    <div class="p-5" data-pagefind-body>
      <h1 class="font-display text-2xl font-semibold leading-snug text-ink">
        {book.titleTr ?? book.title}
      </h1>
      {book.titleTr && book.titleTr !== book.title && (
        <p class="mt-1 text-sm italic text-ink-muted">{book.title}</p>
      )}
      <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-muted">
        {book.author && <span>{book.author}</span>}
        <span class="rounded bg-accent-soft px-2 py-0.5 text-xs font-medium uppercase text-accent">
          {book.format}
        </span>
        {kategori && (
          <span class="flex items-center gap-1.5" data-pagefind-filter="kategori">
            <span
              class="size-2.5 rounded-full"
              style={`background-color:${kategori.renk}`}
              aria-hidden="true"
            />
            {kategori.ad}
          </span>
        )}
      </p>
    </div>
  </header>

  {
    sira.map((bolum) => {
      if (bolum === "sorular")
        return (
          qa &&
          qa.bolumler.length > 0 && (
            <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5">
              <h2 class="font-display text-xl font-semibold text-ink">
                {t("kitap.sorular")}
              </h2>
              <p class="mt-1 text-xs text-ink-muted">
                {t("kitap.guncelleme")}: {qa.guncellenme.toISOString().slice(0, 10)} ·
                NotebookLM
              </p>
              {qa.bolumler.map((qaBolum) => (
                <div class="mt-5">
                  <h3 class="text-xs font-semibold uppercase tracking-wider text-accent">
                    {qaBolum.baslik}
                  </h3>
                  <div class="mt-1 divide-y divide-line">
                    {qaBolum.sorular.map((s) => (
                      <details class="group py-3">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-[15px] font-medium text-ink hover:text-accent [&::-webkit-details-marker]:hidden">
                          {s.soru}
                          <svg
                            class="size-4 shrink-0 text-ink-muted transition-transform group-open:rotate-180"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            aria-hidden="true"
                          >
                            <path d="m6 9 6 6 6-6" />
                          </svg>
                        </summary>
                        <div
                          class="prose prose-sm mt-2 max-w-none text-ink-muted dark:prose-invert prose-a:text-accent"
                          set:html={marked.parse(s.cevap)}
                        />
                      </details>
                    ))}
                  </div>
                </div>
              ))}
            </section>
          )
        );

      if (bolum === "ozet")
        return (
          qa?.ozet &&
          qa.ozet.length > 0 && (
            <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5">
              <h2 class="font-display text-xl font-semibold text-ink">
                {t("kitap.ozet")}
              </h2>
              <p class="mt-1 text-xs text-ink-muted">{t("kitap.ozetAciklama")}</p>
              <div class="mt-3 divide-y divide-line">
                {qa.ozet.map((parca) => (
                  <details class="group py-3">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-display text-[16px] font-semibold text-ink hover:text-accent [&::-webkit-details-marker]:hidden">
                      {parca.baslik}
                      <svg
                        class="size-4 shrink-0 text-ink-muted transition-transform group-open:rotate-180"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        aria-hidden="true"
                      >
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </summary>
                    <div
                      class="prose prose-sm mt-3 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-accent"
                      set:html={marked.parse(parca.icerik)}
                    />
                  </details>
                ))}
              </div>
            </section>
          )
        );

      if (bolum === "oku")
        return (
          <section class="mt-8">
            <h2 class="font-display text-xl font-semibold text-ink">
              {t("kitap.oku")}
            </h2>
            <div class="mt-3">
              <DriveEmbed fileId={book.id} title={book.title} />
            </div>
          </section>
        );

      if (bolum === "moduller")
        return (
          moduller.length > 0 && (
            <div class="mt-8">
              <ModuleList moduller={moduller} />
            </div>
          )
        );

      if (bolum === "planlar")
        return (
          <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-6">
            <h2 class="font-display text-xl font-semibold text-ink">
              {t("kitap.planBaslik")}
            </h2>
            <p class="mt-1 text-sm text-ink-muted">{t("kitap.indirAciklama")}</p>
            <div class="mt-4 grid gap-3 sm:grid-cols-3">
              {planlar.map((plan) => (
                <div
                  class:list={[
                    "rounded-xl border p-4 text-center",
                    plan.one ? "border-accent bg-accent-soft" : "border-line",
                  ]}
                >
                  <p class="font-display text-lg font-semibold text-ink">
                    {plan.ad}
                  </p>
                  <p class="mt-1 text-sm text-ink-muted">{plan.limit}</p>
                </div>
              ))}
            </div>
            <div class="mt-5 text-center">
              <a
                href={requestMail}
                class="inline-flex items-center gap-2 rounded-full border border-accent px-6 py-2.5 font-medium text-accent transition-colors hover:bg-accent hover:text-white"
              >
                ✉️ {t("kitap.indir")}
              </a>
              <p class="mt-2 text-xs text-ink-muted">{t("kitap.planNot")}</p>
            </div>
          </section>
        );

      // sohbet
      return (
        <section class="mt-8 rounded-2xl border border-accent/30 bg-accent-soft p-6 text-center">
          {notebookUrl ? (
            <>
              <a
                href={notebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-medium text-white transition-opacity hover:opacity-90"
              >
                📔 {t("kitap.sohbet")}
              </a>
              <p class="mt-3 text-sm text-ink-muted">{t("kitap.sohbetAciklama")}</p>
            </>
          ) : (
            <p class="text-sm text-ink-muted">{t("kitap.sohbetYok")}</p>
          )}
        </section>
      );
    })
  }
</article>
