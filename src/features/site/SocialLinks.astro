const ETIKETLER: Record<string, string> = {
  github: "GitHub",
  x: "X",
  linkedin: "LinkedIn",
  instagram: "Instagram",
  youtube: "YouTube",
  medium: "Medium",
  mail: "E-posta",
  rss: "RSS",
  website: "Web",
};
---

{
  linkler.length > 0 && (
    <ul class="flex flex-wrap items-center justify-center gap-1">
      {linkler.map((link) => (
        <li>
          <a
            href={link.url}
            {...(link.url.startsWith("http")
              ? { target: "_blank", rel: "me noopener noreferrer" }
              : {})}
            title={link.etiket || ETIKETLER[link.platform]}
            aria-label={link.etiket || ETIKETLER[link.platform]}
            class="flex size-9 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-accent-soft hover:text-accent"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={IKONLAR[link.platform]} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  )
}
