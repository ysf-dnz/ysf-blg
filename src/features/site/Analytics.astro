---
/**
 * Google Analytics 4 — yalnızca PUBLIC_GA_ID tanımlıysa render edilir
 * (.env / Vercel env: PUBLIC_GA_ID=G-XXXXXXXXXX). Boşken sayfaya tek bayt
 * eklenmez. Vercel Web Analytics bundan bağımsız, adapter'da açık.
 */
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;
---

{
  gaId && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", gaId, { anonymize_ip: true });
      </script>
    </>
  )
}
