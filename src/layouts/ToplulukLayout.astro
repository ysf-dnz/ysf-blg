---
/**
 * Topluluk alanı çatısı — Skool tarzı yapışkan sekme çubuğu.
 * 8 topluluk sayfası tek bağlamda: "neredeyim" hissi her sayfada aynı.
 */
import Base from "@/layouts/Base.astro";
import { R } from "@/lib/routes.ts";
import type { SeoProps } from "@/features/seo/Seo.astro";

interface Props {
  title: string;
  description?: string;
  seo?: Partial<SeoProps>;
  /** true ise sayfa kendi JsonLd'sini basar (Base varsayılanı atlanır) */
  ownJsonLd?: boolean;
}
const { title, description, seo, ownJsonLd } = Astro.props;

// `ek`: detay sayfası liste sayfasının altında değilse (/kulup/x, /etkinlik/x) sekmeyi o da yakar
const sekmeler: { href: string; label: string; ikon: string; ek?: string }[] = [
  { href: R.topluluk, label: "Akış", ikon: "💬" },
  { href: R.gundem, label: "Gündem", ikon: "🔥" },
  { href: R.kulupler, label: "Topluluklarımız", ikon: "🏛️", ek: "/kulup" },
  { href: R.kurslar, label: "Kurslar", ikon: "🎓" },
  { href: R.lider, label: "Liderlik", ikon: "🏆" },
  { href: R.etkinlikler, label: "Etkinlikler", ikon: "📅", ek: "/etkinlik" },
  { href: R.uyeler, label: "Üyeler", ikon: "👥" },
  { href: R.harita, label: "Harita", ikon: "🗺️" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const aktifMi = (s: (typeof sekmeler)[number]) =>
  [s.href, s.ek].some((h) => !!h && (path === h || path.startsWith(h + "/")));
---

<Base title={title} description={description} seo={seo} ownJsonLd={ownJsonLd}>
  <slot name="below-header" slot="below-header" />
  <nav
    class="sticky top-[65px] z-20 -mx-4 border-b border-line bg-surface/85 px-4 backdrop-blur"
    aria-label="Topluluk bölümleri"
  >
    <div
      class="flex gap-1 overflow-x-auto py-2 [scrollbar-width:none] [-webkit-overflow-scrolling:touch]"
    >
      {
        sekmeler.map((s) => (
          <a
            href={s.href}
            aria-current={aktifMi(s) ? "page" : undefined}
            class:list={[
              "flex shrink-0 items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm transition-colors",
              aktifMi(s)
                ? "bg-accent font-semibold text-surface"
                : "text-ink-muted hover:bg-accent-soft hover:text-accent",
            ]}
          >
            <span aria-hidden="true">{s.ikon}</span>
            {s.label}
          </a>
        ))
      }
    </div>
  </nav>

  <div class="pt-6">
    <slot />
  </div>
</Base>
