---
/**
 * Üye panosu: puan, seviye, açılan kitaplar, bildirimler, davet linki.
 */
import { desc, eq } from "drizzle-orm";
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import { db, schema } from "@/db/client.ts";
import { langFromUrl, useTranslations } from "@/lib/i18n/index.ts";
import {
  earnedPoints,
  getOrCreateMember,
  pointBalance,
} from "@/lib/member.ts";
import { levelFor, pointsToNextLevel } from "@/lib/levels.ts";
import { PUAN } from "@/lib/points.ts";

export const prerender = false;

const t = useTranslations(langFromUrl(Astro.url.pathname));
const member = await getOrCreateMember(Astro);
if (!member) return Astro.redirect("/");

const [balance, earned, access, notifs, yaziSayisi, kulubum] = await Promise.all([
  pointBalance(member.id),
  earnedPoints(member.id),
  db.query.bookAccess.findMany({
    where: eq(schema.bookAccess.userId, member.id),
  }),
  db.query.notifications.findMany({
    where: eq(schema.notifications.userId, member.id),
    orderBy: desc(schema.notifications.createdAt),
    limit: 10,
  }),
  db.query.memberPosts.findMany({
    where: eq(schema.memberPosts.userId, member.id),
  }),
  db.query.clubMembers.findFirst({
    where: eq(schema.clubMembers.userId, member.id),
  }),
]);


// Yolculuk görevleri: eksik algıla, sıradaki adımı göster (Zeigarnik)
const hediye = access.find((a) => a.source === "gift");
const gorevler = [
  {
    ok: !!hediye,
    baslik: "Hediye kitabını seç",
    aciklama: "İlk kitabın bizden — 884 kitaptan birini seç.",
    href: "/uye/hosgeldin",
    odul: "🎁",
  },
  {
    ok: yaziSayisi.length > 0,
    baslik: "İlk yazını yaz",
    aciklama: "Şablon hazır; okuduğun kitabı anlat.",
    href: hediye ? `/uye/yaz?kitap=${hediye.bookId}` : "/uye/yaz",
    odul: "+100",
  },
  {
    ok: !!(member.city || member.university),
    baslik: "Profilini tamamla",
    aciklama: "Şehrini seç, haritada görün; üniversiteni yaz, takımına puan kazandır.",
    href: "/uye/profil",
    odul: "🗺️",
  },
  {
    ok: !!kulubum,
    baslik: "Bir kulübe katıl",
    aciklama: "Okulundaki topluluğa katıl veya kendi kulübünü kur.",
    href: "/kulupler",
    odul: "🏛️",
  },
];
const tamamlanan = gorevler.filter((g) => g.ok).length;
const level = levelFor(earned);
const toNext = pointsToNextLevel(earned);
const books = await getCollection("books");
// 🗝️ Bilgi Hazinesi: 5 kitaplık hedef listesi (açılanlar ✓, kalanlar kilitli)
const hazine = await db.query.learningList.findMany({
  where: eq(schema.learningList.userId, member.id),
  orderBy: schema.learningList.order,
});
const acikIdler = new Set(access.map((a) => a.bookId));
const hazineDurum = hazine.map((h) => ({
  ...h,
  book: books.find((b) => b.data.id === h.bookId)?.data,
  acik: acikIdler.has(h.bookId),
}));
const kilitliHazine = hazineDurum.filter((h) => !h.acik).length;
const siradakiKalan = Math.max(PUAN.bookUnlockCost - balance, 0);

const myBooks = access
  .map((a) => books.find((b) => b.data.id === a.bookId)?.data)
  .filter(Boolean);
const inviteUrl = `${Astro.site ?? Astro.url.origin}?ref=${member.handle}`;
---

<Base title={t("uye.panel")}>
  <section class="girih-texture -mx-4 flex flex-wrap items-center gap-6 px-4 py-10">
    {member.avatarUrl && (
      <img src={member.avatarUrl} alt="" width="72" height="72" class="size-18 rounded-full border-2 border-accent" />
    )}
    <div>
      <h1 class="font-display text-3xl font-semibold text-ink">{member.name}</h1>
      <p class="mt-1 text-ink-muted">@{member.handle}</p>
    </div>
    <div class="ml-auto flex gap-4 text-center">
      <div class="rounded-xl border border-line bg-surface-raised px-5 py-3">
        <p class="font-display text-2xl font-semibold text-accent" data-ticker>{balance}</p>
        <p class="text-xs text-ink-muted">{t("uye.puan")}</p>
      </div>
      <div class="rounded-xl border border-line bg-surface-raised px-5 py-3">
        <p class="font-display text-2xl font-semibold text-accent">Sv {level}</p>
        {toNext !== null && (
          <p class="text-xs text-ink-muted">{t("uye.sonrakiSeviye")}: {toNext}</p>
        )}
      </div>
    </div>
  </section>

  {
    tamamlanan < gorevler.length && (
      <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5" data-reveal>
        <div class="flex items-baseline justify-between">
          <h2 class="font-display text-lg font-semibold text-ink">🧭 Yolculuğun</h2>
          <span class="text-sm text-ink-muted">{tamamlanan}/{gorevler.length}</span>
        </div>
        <div class="mt-2 h-2 overflow-hidden rounded-full bg-accent-soft">
          <div class="h-full bg-accent transition-all" style={`width:${(tamamlanan / gorevler.length) * 100}%`} />
        </div>
        <ul class="mt-4 space-y-2">
          {gorevler.map((g) => (
            <li>
              {g.ok ? (
                <div class="flex items-center gap-3 rounded-xl border border-line px-4 py-2.5 opacity-60">
                  <span>✅</span>
                  <span class="text-sm font-medium text-ink line-through">{g.baslik}</span>
                </div>
              ) : (
                <a href={g.href} class="hover-lift flex items-center gap-3 rounded-xl border border-accent/40 bg-accent-soft/40 px-4 py-2.5 hover:border-accent">
                  <span>⬜</span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium text-ink">{g.baslik}</span>
                    <span class="text-xs text-ink-muted">{g.aciklama}</span>
                  </span>
                  <span class="shrink-0 text-sm font-semibold text-accent">{g.odul}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    hazineDurum.length > 0 && (
      <section class="mt-8 rounded-2xl border border-accent/40 bg-accent-soft/30 p-5" data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-display text-xl font-semibold text-ink">🗝️ Bilgi Hazinen</h2>
          {kilitliHazine > 0 ? (
            <p class="text-sm text-ink-muted">
              Sıradaki hazinene <strong class="text-accent">{siradakiKalan} puan</strong> — bir yazı + bir quiz yeter ✍️
            </p>
          ) : (
            <a href="/uye/hosgeldin" class="text-sm font-medium text-accent hover:underline">
              Hazinen tamamlandı 🏆 — yeni 5'li seç →
            </a>
          )}
        </div>
        <ul class="mt-4 grid grid-cols-5 gap-3">
          {hazineDurum.map((h) => (
            <li>
              <a href={`/kutuphane/kitap/${h.bookId}`} class="book-3d block" title={h.book?.titleTr ?? h.book?.title}>
                <span class="relative block">
                  {h.book?.cover ? (
                    <img
                      src={h.book.cover}
                      alt=""
                      width="160"
                      height="213"
                      loading="lazy"
                      class:list={["aspect-[3/4] w-full rounded-lg border object-cover", h.acik ? "border-accent" : "border-line opacity-45 grayscale"]}
                    />
                  ) : (
                    <span class:list={["flex aspect-[3/4] w-full items-center justify-center rounded-lg border bg-accent-soft p-1 text-center text-[10px] font-semibold", h.acik ? "border-accent text-accent" : "border-line text-ink-muted opacity-60"]}>
                      {h.book?.title}
                    </span>
                  )}
                  <span class="absolute right-1 top-1 text-sm">{h.acik ? "✅" : "🔒"}</span>
                </span>
                {!h.acik && (
                  <span class="mt-1 block h-1.5 overflow-hidden rounded-full bg-surface">
                    <span class="block h-full bg-accent" style={`width:${Math.min(Math.round((balance / PUAN.bookUnlockCost) * 100), 100)}%`} />
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-8" data-reveal>
    <h2 class="font-display text-xl font-semibold text-ink">{t("kutuphane.kitapRafi")}</h2>
    <ul class="mt-4 grid grid-cols-3 gap-4 sm:grid-cols-4 lg:grid-cols-6" data-stagger>
      {
        myBooks.map((b) => (
          <li>
            <a href={`/kutuphane/kitap/${b!.id}`} class="book-3d group/book block">
              {b!.cover ? (
                <img src={b!.cover} alt={b!.title} width="320" height="427" loading="lazy" class="aspect-[3/4] w-full rounded-lg border border-line object-cover" />
              ) : (
                <span class="flex aspect-[3/4] w-full items-center justify-center rounded-lg border border-line bg-accent-soft p-2 text-center font-display text-xs font-semibold text-accent">
                  {b!.title}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10 grid gap-6 lg:grid-cols-2">
    <div class="rounded-2xl border border-line bg-surface-raised p-6" data-reveal>
      <h2 class="font-display text-xl font-semibold text-ink">🎁 Kitap hediye et</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Rafındaki bir kitabı arkadaşına aç — <strong class="text-accent">{PUAN.giftBookCost} puan</strong> (kendine açmanın yarısı).
      </p>
      <form method="post" action="/api/uye/hediye-et" class="mt-3 grid gap-2">
        <select name="bookId" required class="rounded-lg border border-line bg-surface px-3 py-2 text-sm">
          {myBooks.map((b) => <option value={b!.id}>{b!.titleTr ?? b!.title}</option>)}
        </select>
        <div class="flex gap-2">
          <input name="handle" required placeholder="@kullanici-adi" class="w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm" />
          <button class="cursor-pointer rounded-full bg-accent px-5 py-2 text-sm font-medium text-surface transition-transform hover:scale-105">Gönder</button>
        </div>
      </form>
      <a href="/uye/magaza" class="mt-3 inline-block text-sm font-medium text-accent hover:underline">✨ Puan mağazası →</a>
    </div>
    <div class="rounded-2xl border border-line bg-surface-raised p-6" data-reveal>
      <h2 class="font-display text-xl font-semibold text-ink">🤝 Davet linkin</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Arkadaşın katılınca +25, ilk yazısı onaylanınca +75 puan.
      </p>
      <code class="mt-3 block select-all overflow-x-auto rounded-lg border border-line bg-surface px-3 py-2 text-sm text-accent">
        {inviteUrl}
      </code>
    </div>
    <div class="rounded-2xl border border-line bg-surface-raised p-6" data-reveal>
      <h2 class="font-display text-xl font-semibold text-ink">🔔 Bildirimler</h2>
      {
        notifs.length === 0 ? (
          <p class="mt-2 text-sm text-ink-muted">Henüz bildirim yok.</p>
        ) : (
          <ul class="mt-3 space-y-2 text-sm">
            {notifs.map((n) => (
              <li class="rounded-lg border border-line px-3 py-2 text-ink-muted">
                {n.href ? (
                  <a href={n.href} class="hover:text-accent">{n.body}</a>
                ) : (
                  n.body
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
