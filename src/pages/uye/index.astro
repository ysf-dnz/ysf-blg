---
/**
 * Üye panosu: puan, seviye, açılan kitaplar, bildirimler, davet linki.
 */
import { and, desc, eq, inArray, isNull, sql } from "drizzle-orm";
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import { db, schema } from "@/db/client.ts";
import { langFromUrl, useTranslations } from "@/lib/i18n/index.ts";
import {
  earnedPoints,
  getOrCreateMember,
  pointBalance,
} from "@/lib/member.ts";
import { levelFor, pointsToNextLevel } from "@/lib/levels.ts";
import { PUAN } from "@/lib/points.ts";
import { DAVET_REASONLARI, UNLOCKS, bekleyenleriIsle } from "@/lib/rewards.ts";
import { R } from "@/lib/routes.ts";
import { hostBekleyenleri } from "@/lib/etkinlik.ts";

export const prerender = false;

const t = useTranslations(langFromUrl(Astro.url.pathname));
const member = await getOrCreateMember(Astro);
if (!member) return Astro.redirect("/");

// ⏳ Olgunlaşan bekleyen puanlar ÖNCE kesinleşir ki bakiye/seviye bu görüntülemede doğru olsun
await bekleyenleriIsle(new Date(), member.id);

const [balance, earned, access, notifs, yaziSayisi, kulubum] = await Promise.all([
  pointBalance(member.id),
  earnedPoints(member.id),
  db.query.bookAccess.findMany({
    where: eq(schema.bookAccess.userId, member.id),
  }),
  db.query.notifications.findMany({
    where: eq(schema.notifications.userId, member.id),
    orderBy: desc(schema.notifications.createdAt),
    limit: 10,
  }),
  db.query.memberPosts.findMany({
    where: eq(schema.memberPosts.userId, member.id),
  }),
  db.query.clubMembers.findFirst({
    where: eq(schema.clubMembers.userId, member.id),
  }),
]);

// Bildirimler görüldü → okundu işaretle. readAt sütunu şemada vardı ama
// HİÇ yazılmıyordu; bu yüzden zil sayacı hiç sıfırlanamazdı.
const okunmamisSayisi = notifs.filter((n) => !n.readAt).length;
if (okunmamisSayisi > 0) {
  await db
    .update(schema.notifications)
    .set({ readAt: new Date() })
    .where(
      and(
        eq(schema.notifications.userId, member.id),
        isNull(schema.notifications.readAt),
      ),
    );
}


// Yolculuk görevleri: eksik algıla, sıradaki adımı göster (Zeigarnik)
const hediye = access.find((a) => a.source === "gift");
const gorevler = [
  {
    ok: !!hediye,
    baslik: "Hediye kitabını seç",
    aciklama: "İlk kitabın bizden — 884 kitaptan birini seç.",
    href: "/uye/hosgeldin",
    odul: "🎁",
  },
  {
    ok: yaziSayisi.length > 0,
    baslik: "İlk yazını yaz",
    aciklama: "Şablon hazır; okuduğun kitabı anlat.",
    href: hediye ? `/uye/yaz?kitap=${hediye.bookId}` : "/uye/yaz",
    odul: "+100",
  },
  {
    ok: !!(member.city || member.university),
    baslik: "Profilini tamamla",
    aciklama: "Şehrini seç, haritada görün; üniversiteni yaz, takımına puan kazandır.",
    href: "/uye/profil",
    odul: "🗺️",
  },
  {
    ok: !!kulubum,
    baslik: "Bir kulübe katıl",
    aciklama: "Okulundaki topluluğa katıl veya kendi kulübünü kur.",
    href: "/kulupler",
    odul: "🏛️",
  },
];
const tamamlanan = gorevler.filter((g) => g.ok).length;
const level = levelFor(earned);
const toNext = pointsToNextLevel(earned);

// ⏳ Bekleyen puan (ADR 0001 K2): bekleyenler + son 7 günde kırpılanlar
const bekleyenler = await db.query.pendingPoints.findMany({
  where: and(eq(schema.pendingPoints.userId, member.id), eq(schema.pendingPoints.status, "pending")),
  orderBy: desc(schema.pendingPoints.createdAt),
  limit: 10,
});
const kirpilanlar = (
  await db.query.pendingPoints.findMany({
    where: and(eq(schema.pendingPoints.userId, member.id), eq(schema.pendingPoints.status, "confirmed")),
    orderBy: desc(schema.pendingPoints.resolvedAt),
    limit: 20,
  })
).filter((b) => b.yazilan < b.delta && b.resolvedAt && b.resolvedAt.getTime() > Date.now() - 7 * 864e5);
const bekleyenToplam = bekleyenler.reduce((t, b) => t + b.delta, 0);
// 🎤 Düzenleyen payı (ADR K2): bekleyen SATIRI yoktur — canlı giriş sayımından tahmin, toplamın dışında
const [hostBek, [biletSayi]] = await Promise.all([
  hostBekleyenleri(member.id),
  db
    .select({ n: sql<number>`count(*)` })
    .from(schema.eventRsvps)
    .where(and(eq(schema.eventRsvps.userId, member.id), isNull(schema.eventRsvps.checkedInAt))),
]);
const tarihKisa = (d: Date) => d.toLocaleDateString("tr-TR", { day: "numeric", month: "short" });
const bekleyenZaman = (b: (typeof bekleyenler)[number]) =>
  b.maturesAt
    ? `${tarihKisa(b.maturesAt)} kesinleşir (hesap yaşı 24 s)`
    : b.expiresAt
      ? `son gün ${tarihKisa(b.expiresAt)}`
      : "koşul bekliyor";

// 🤝 Davetlerim (Faz 2-3): kod başına görüntülenme (kanal) → katılım → aktivasyon; kazanılan/bekleyen.
// Kurs kodu: course_enrollments; etkinlik kodu: event_rsvps (aktive = girişi doğrulanan).
// (yalnız davet EDEN olarak kazanılanlar: welcome davetlinin kendi puanıdır, tavan listesinde kalır)
const DAVET_EDEN_REASONLARI = DAVET_REASONLARI.filter((r) => r !== "course_invite_welcome");
const davetKodlarim = await db.query.inviteCodes.findMany({
  where: and(eq(schema.inviteCodes.inviterId, member.id), isNull(schema.inviteCodes.revokedAt)),
});
const kodIdler = davetKodlarim.map((k) => k.id);
const kursKodlari = davetKodlarim.filter((k) => k.targetType === "course");
const etkinlikKodlari = davetKodlarim.filter((k) => k.targetType === "event");
const [davetZiyaret, davetKatilim, davetKurslar, davetEtkinlikKatilim, davetEtkinlikler, [davetKazanc], [davetBekleyen]] = await Promise.all([
  kodIdler.length
    ? db
        .select({ codeId: schema.inviteVisits.inviteCodeId, kanal: schema.inviteVisits.kanal, n: sql<number>`count(*)` })
        .from(schema.inviteVisits)
        .where(inArray(schema.inviteVisits.inviteCodeId, kodIdler))
        .groupBy(schema.inviteVisits.inviteCodeId, schema.inviteVisits.kanal)
    : [],
  kodIdler.length
    ? db
        .select({
          codeId: schema.courseEnrollments.inviteCodeId,
          katilan: sql<number>`count(*)`,
          aktif: sql<number>`count(${schema.courseEnrollments.activatedAt})`,
          bitiren: sql<number>`count(${schema.courseEnrollments.completedAt})`,
        })
        .from(schema.courseEnrollments)
        .where(inArray(schema.courseEnrollments.inviteCodeId, kodIdler))
        .groupBy(schema.courseEnrollments.inviteCodeId)
    : [],
  // Tür ayrımı ŞART: etkinlik kodunun target_id'si aynı sayısal id'li KURSU bulmasın
  kursKodlari.length
    ? db.query.courses.findMany({ where: inArray(schema.courses.id, kursKodlari.map((k) => k.targetId)) })
    : [],
  etkinlikKodlari.length
    ? db
        .select({
          codeId: schema.eventRsvps.inviteCodeId,
          katilan: sql<number>`count(*)`,
          aktif: sql<number>`count(${schema.eventRsvps.checkedInAt})`,
        })
        .from(schema.eventRsvps)
        .where(inArray(schema.eventRsvps.inviteCodeId, etkinlikKodlari.map((k) => k.id)))
        .groupBy(schema.eventRsvps.inviteCodeId)
    : [],
  etkinlikKodlari.length
    ? db.query.events.findMany({ where: inArray(schema.events.id, etkinlikKodlari.map((k) => k.targetId)) })
    : [],
  db
    .select({ t: sql<number>`coalesce(sum(${schema.pointsLedger.delta}), 0)` })
    .from(schema.pointsLedger)
    .where(and(eq(schema.pointsLedger.userId, member.id), inArray(schema.pointsLedger.reason, DAVET_EDEN_REASONLARI))),
  db
    .select({ t: sql<number>`coalesce(sum(${schema.pendingPoints.delta}), 0)` })
    .from(schema.pendingPoints)
    .where(
      and(
        eq(schema.pendingPoints.userId, member.id),
        eq(schema.pendingPoints.status, "pending"),
        inArray(schema.pendingPoints.reason, DAVET_EDEN_REASONLARI),
      ),
    ),
]);
const davetKursMap = new Map(davetKurslar.map((c) => [c.id, c]));
const davetEtkinlikMap = new Map(davetEtkinlikler.map((e) => [e.id, e]));
const ziyaretMap = new Map<number, { qr: number; link: number }>();
for (const z of davetZiyaret) {
  const g = ziyaretMap.get(z.codeId) ?? { qr: 0, link: 0 };
  g[z.kanal] += Number(z.n);
  ziyaretMap.set(z.codeId, g);
}
const katilimMap = new Map<number | null, { katilan: number; aktif: number; bitiren: number | null }>([
  ...davetKatilim.map((k) => [k.codeId, { katilan: Number(k.katilan), aktif: Number(k.aktif), bitiren: Number(k.bitiren) }] as const),
  ...davetEtkinlikKatilim.map((k) => [k.codeId, { katilan: Number(k.katilan), aktif: Number(k.aktif), bitiren: null }] as const),
]);
const kFaktor = [...katilimMap.values()].reduce((t, k) => t + k.aktif, 0);

// 🔨 Görevlerim: üstlenilen kampanya görevleri + son tarih
const uzerimdeki = await db
  .select({
    id: schema.campaignTasks.id,
    title: schema.campaignTasks.title,
    status: schema.campaignTasks.status,
    dueAt: schema.campaignTasks.dueAt,
    rewardPoints: schema.campaignTasks.rewardPoints,
    campaignId: schema.campaignTasks.campaignId,
  })
  .from(schema.campaignTasks)
  .where(
    and(
      eq(schema.campaignTasks.assigneeId, member.id),
      inArray(schema.campaignTasks.status, ["claimed", "review"]),
    ),
  );
const books = await getCollection("books");
// 🗝️ Bilgi Hazinesi: 5 kitaplık hedef listesi (açılanlar ✓, kalanlar kilitli)
const hazine = await db.query.learningList.findMany({
  where: eq(schema.learningList.userId, member.id),
  orderBy: schema.learningList.order,
});
const acikIdler = new Set(access.map((a) => a.bookId));
const hazineDurum = hazine.map((h) => ({
  ...h,
  book: books.find((b) => b.data.id === h.bookId)?.data,
  acik: acikIdler.has(h.bookId),
}));
const kilitliHazine = hazineDurum.filter((h) => !h.acik).length;
const siradakiKalan = Math.max(PUAN.bookUnlockCost - balance, 0);
// Yalnız SIRADAKİ kilitli kitap gerçek ilerlemeyi gösterir; diğerleri
// "sırada bekliyor"dur. Eskiden dört kilitli slot da aynı yüzdeyi çizdiği
// için ilerleme hissi yoktu (hangisine yaklaştığın belli olmuyordu).
const siradakiKilitliIndex = hazineDurum.findIndex((h) => !h.acik);
// Hediye akışının geri bildirimi (api/uye/hediye-et ?hediye=<kod> ile döner)
const hediyeDurumu = Astro.url.searchParams.get("hediye");
const HEDIYE_MESAJLARI: Record<string, string> = {
  ok: "Hediyen ulaştı 🎁 Arkadaşının kütüphanesine eklendi.",
  eksik: "Kitap ve kullanıcı adı gerekli — hediye gönderilmedi.",
  sahipdegil: "Bu kitap senin rafında değil; yalnız sahip olduğun kitapları hediye edebilirsin.",
  kisiyok: "Bu kullanıcı adını bulamadık — yazımını kontrol et (puanın harcanmadı).",
  kendine: "Kendine hediye edemezsin 🙂",
  zatensahip: "Arkadaşın bu kitaba zaten sahip — puanın harcanmadı.",
  puan: `Yeterli puanın yok (${PUAN.giftBookCost} gerekli) — hediye gönderilmedi.`,
};
const hediyeMesaji = hediyeDurumu ? HEDIYE_MESAJLARI[hediyeDurumu] : undefined;
const siradakiYuzde = Math.min(
  Math.round((balance / PUAN.bookUnlockCost) * 100),
  100,
);

const myBooks = access
  .map((a) => books.find((b) => b.data.id === a.bookId)?.data)
  .filter(Boolean);
const inviteUrl = `${Astro.site ?? Astro.url.origin}?ref=${member.handle}`;
const davetMetni = encodeURIComponent(
  `Burada kitaplar parayla değil emekle açılıyor — oku, yaz, öğret, yeni kitap aç. Sen de katıl, ilk kitabın hediye: ${inviteUrl}`,
);

// 🏅 Rozetler + 🔥 streak + sıradaki seviye açılımı
const rozetler = await db.query.badges.findMany({
  where: eq(schema.badges.userId, member.id),
});
const ROZET_META: Record<string, { ikon: string; ad: string }> = {
  "ilk-yazi": { ikon: "✍️", ad: "İlk Yazı" },
  "streak-7": { ikon: "🔥", ad: "7 Gün Seri" },
  "streak-30": { ikon: "🔥🔥", ad: "30 Gün Seri" },
  "gorev-10": { ikon: "🔨", ad: "10 Görev" },
  "quiz-ustasi": { ikon: "🧠", ad: "Quiz Ustası" },
  "davetci-5": { ikon: "🤝", ad: "Davetçi" },
  "kulup-kurucu": { ikon: "🏛️", ad: "Kulüp Kurucu" },
  "sezon-sampiyonu": { ikon: "🏆", ad: "Sezon Şampiyonu" },
  "lig-birincisi": { ikon: "🥇", ad: "Lig Birincisi" },
  "usta-okur": { ikon: "📚", ad: "Usta Okur" },
};
// Streak bugün/dün aktifse canlı sayılır; değilse görsel olarak sıfır göster
const bugunKey = new Date();
const gk = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
const streakCanli =
  member.streakLastDay === gk(bugunKey) ||
  member.streakLastDay === gk(new Date(Date.now() - 864e5));
const streakGoster = streakCanli ? member.streakCount : 0;
const siradakiAcilim = UNLOCKS[[3, 5, 7].find((lv) => lv > level) ?? 0] ?? null;
const siradakiAcilimSeviye = [3, 5, 7].find((lv) => lv > level);
---

<Base title={t("uye.panel")}>
  <section class="girih-texture -mx-4 flex flex-wrap items-center gap-6 px-4 py-10">
    {member.avatarUrl && (
      <img src={member.avatarUrl} alt="" width="72" height="72" class="size-18 rounded-full border-2 border-accent" />
    )}
    <div>
      <h1 class="font-display text-3xl font-semibold text-ink">{member.name}</h1>
      <p class="mt-1 flex items-center gap-2 text-ink-muted">
        @{member.handle}
        {member.role === "admin" && (
          <a
            href="/uye/admin"
            class="pill-pop rounded-full border border-accent px-3 py-0.5 text-xs font-medium text-accent transition-colors hover:bg-accent hover:text-surface"
          >
            🛡️ Admin paneli
          </a>
        )}
        {Number(biletSayi?.n ?? 0) > 0 && (
          <a
            href={R.uye.biletler}
            class="pill-pop rounded-full border border-accent px-3 py-0.5 text-xs font-medium text-accent transition-colors hover:bg-accent hover:text-surface"
          >
            🎟️ Biletlerim ({Number(biletSayi!.n)})
          </a>
        )}
      </p>
    </div>
    <div class="ml-auto flex flex-wrap gap-4 text-center">
      <div class="rounded-xl border border-line bg-surface-raised px-5 py-3">
        <p class="font-display text-2xl font-semibold text-accent" data-ticker>{balance}</p>
        <p class="text-xs text-ink-muted">{t("uye.puan")}</p>
      </div>
      <div class="rounded-xl border border-line bg-surface-raised px-5 py-3">
        <p class="font-display text-2xl font-semibold text-accent">Sv {level}</p>
        {toNext !== null && (
          <p class="text-xs text-ink-muted">{t("uye.sonrakiSeviye")}: {toNext}</p>
        )}
      </div>
      <div class="rounded-xl border border-line bg-surface-raised px-5 py-3" title="Her gün puan kazandıran bir şey yap, serin büyüsün. 7 gün: +25p · 30 gün: +150p">
        <p class="font-display text-2xl font-semibold text-accent">🔥 {streakGoster}</p>
        <p class="text-xs text-ink-muted">günlük seri</p>
      </div>
    </div>
  </section>

  {
    siradakiAcilim && (
      <p class="mt-6 rounded-xl border border-accent/40 bg-accent-soft/40 px-4 py-2.5 text-sm text-ink" data-reveal>
        ✨ <strong>Seviye {siradakiAcilimSeviye}</strong>'te seni ne bekliyor: {siradakiAcilim}
        {toNext !== null && <span class="text-ink-muted"> — sonraki seviyeye {toNext} puan</span>}
      </p>
    )
  }

  {
    rozetler.length > 0 && (
      <section class="mt-6 flex flex-wrap gap-2" data-reveal aria-label="Rozetler">
        {rozetler.map((r) => {
          const m = ROZET_META[r.kind];
          return (
            <span class="rounded-full border border-line bg-surface-raised px-3 py-1.5 text-sm" title={m?.ad}>
              {m?.ikon} <span class="text-xs text-ink-muted">{m?.ad}</span>
            </span>
          );
        })}
      </section>
    )
  }

  {
    tamamlanan < gorevler.length && (
      <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5" data-reveal>
        <div class="flex items-baseline justify-between">
          <h2 class="font-display text-lg font-semibold text-ink">🧭 Yolculuğun</h2>
          <span class="text-sm text-ink-muted">{tamamlanan}/{gorevler.length}</span>
        </div>
        <div class="mt-2 h-2 overflow-hidden rounded-full bg-accent-soft">
          <div class="h-full bg-accent transition-all" style={`width:${(tamamlanan / gorevler.length) * 100}%`} />
        </div>
        <ul class="mt-4 space-y-2">
          {gorevler.map((g) => (
            <li>
              {g.ok ? (
                <div class="flex items-center gap-3 rounded-xl border border-line px-4 py-2.5 opacity-60">
                  <span>✅</span>
                  <span class="text-sm font-medium text-ink line-through">{g.baslik}</span>
                </div>
              ) : (
                <a href={g.href} class="hover-lift flex items-center gap-3 rounded-xl border border-accent/40 bg-accent-soft/40 px-4 py-2.5 hover:border-accent">
                  <span>⬜</span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium text-ink">{g.baslik}</span>
                    <span class="text-xs text-ink-muted">{g.aciklama}</span>
                  </span>
                  <span class="shrink-0 text-sm font-semibold text-accent">{g.odul}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    hazineDurum.length > 0 && (
      <section class="mt-8 rounded-2xl border border-accent/40 bg-accent-soft/30 p-5" data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-display text-xl font-semibold text-ink">🗝️ Bilgi Hazinen</h2>
          {kilitliHazine > 0 ? (
            <p class="text-sm text-ink-muted">
              Sıradaki hazinene <strong class="text-accent">{siradakiKalan} puan</strong> — bir yazı + bir quiz yeter ✍️
            </p>
          ) : (
            /* ?ek=1: hazine büyütme modu — bu parametre olmadan hosgeldin
               sayfası panoya geri yönlendirir (ölü döngü) */
            <a href="/uye/hosgeldin?ek=1" class="text-sm font-medium text-accent hover:underline">
              Hazinen tamamlandı 🏆 — yeni 5'li seç →
            </a>
          )}
        </div>
        <ul class="mt-4 grid grid-cols-5 gap-3">
          {hazineDurum.map((h, i) => (
            <li>
              <a
                href={`/kutuphane/kitap/${h.bookId}`}
                class="book-3d block"
                title={
                  h.acik
                    ? (h.book?.titleTr ?? h.book?.title)
                    : i === siradakiKilitliIndex
                      ? `${h.book?.titleTr ?? h.book?.title} — sıradaki hedefin: ${siradakiKalan} puan kaldı`
                      : `${h.book?.titleTr ?? h.book?.title} — sırada bekliyor`
                }
              >
                <span class="relative block">
                  {h.book?.cover ? (
                    <img
                      src={h.book.cover}
                      alt=""
                      width="160"
                      height="213"
                      loading="lazy"
                      class:list={["aspect-[3/4] w-full rounded-lg border object-cover", h.acik ? "border-accent" : "border-line opacity-45 grayscale"]}
                    />
                  ) : (
                    <span class:list={["flex aspect-[3/4] w-full items-center justify-center rounded-lg border bg-accent-soft p-1 text-center text-[10px] font-semibold", h.acik ? "border-accent text-accent" : "border-line text-ink-muted opacity-60"]}>
                      {h.book?.title}
                    </span>
                  )}
                  <span class="absolute right-1 top-1 text-sm">{h.acik ? "✅" : "🔒"}</span>
                </span>
                {!h.acik && (
                  <span class="mt-1 block h-1.5 overflow-hidden rounded-full bg-surface">
                    {/* Yalnız sıradaki hedef dolar; sonrakiler boş bekler */}
                    <span
                      class="block h-full bg-accent transition-all"
                      style={`width:${i === siradakiKilitliIndex ? siradakiYuzde : 0}%`}
                    />
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

      <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5" data-reveal aria-label="Davetlerim">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="font-display text-xl font-semibold text-ink">🤝 Davetlerim</h2>
      <p class="text-xs text-ink-muted">
        Kazanılan <strong class="text-accent">+{Number(davetKazanc?.t ?? 0)}</strong>
        {Number(davetBekleyen?.t ?? 0) > 0 && <> · bekleyen +{Number(davetBekleyen.t)}</>}
        {" "}· aktive olan davetli <strong class="text-ink">{kFaktor}</strong> · haftalık davet tavanı {PUAN.inviteWeeklyCap}
      </p>
    </div>
    {davetKodlarim.length === 0 ? (
      <p class="mt-2 text-sm text-ink-muted">Katıldığın bir kursun ya da kaydolduğun bir etkinliğin sayfasındaki <strong>🎴 Davet kartın</strong>ı paylaş: arkadaşın QR'ı okutunca kursta o +{PUAN.inviteWelcome}, sen +{PUAN.inviteActivated}; etkinlikte o +{PUAN.eventInviteWelcome}, sen +{PUAN.eventInviteAttended} kazanırsın.</p>
    ) : (
      <table class="mt-3 w-full text-sm">
        <thead class="text-left text-xs text-ink-muted"><tr><th class="py-1 font-medium">Kurs / etkinlik</th><th class="py-1 font-medium">Görüntülenme</th><th class="py-1 font-medium">Katılan</th><th class="py-1 font-medium" title="Kursta ilk öğeyi bitiren; etkinlikte girişi doğrulanan">Aktive</th><th class="py-1 font-medium">Bitiren</th></tr></thead>
        <tbody>
          {davetKodlarim.map((k) => {
            const z = ziyaretMap.get(k.id) ?? { qr: 0, link: 0 };
            const etkinlikMi = k.targetType === "event";
            const kt = katilimMap.get(k.id) ?? { katilan: 0, aktif: 0, bitiren: etkinlikMi ? null : 0 };
            const kurs = etkinlikMi ? undefined : davetKursMap.get(k.targetId);
            const etkinlik = etkinlikMi ? davetEtkinlikMap.get(k.targetId) : undefined;
            const baslik = kurs?.title ?? etkinlik?.title;
            // Hedefi silinmiş kod (ör. yeniden kurulan demo veri) listelenmez
            if (!baslik) return null;
            const href = kurs ? `${R.kurs(kurs.slug)}#davet` : `${R.etkinlik(etkinlik!.slug ?? String(etkinlik!.id))}#davet`;
            return (
              <tr class="border-t border-line">
                <td class="py-1.5 pr-2">{etkinlikMi ? "📅 " : "🎓 "}<a href={href} class="text-accent hover:underline">{baslik}</a> <span class="font-mono text-xs text-ink-muted">{k.code}</span></td>
                <td class="py-1.5">{z.qr + z.link} <span class="text-xs text-ink-muted">(QR {z.qr} · link {z.link})</span></td>
                <td class="py-1.5">{kt.katilan}</td>
                <td class="py-1.5">{kt.aktif}</td>
                <td class="py-1.5">{kt.bitiren ?? "—"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </section>

  {(bekleyenler.length > 0 || kirpilanlar.length > 0 || hostBek.length > 0) && (
      <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5" data-reveal aria-label="Bekleyen puan">
        <h2 class="font-display text-xl font-semibold text-ink">⏳ Bekleyen puan {bekleyenToplam > 0 && <span class="text-accent">+{bekleyenToplam}</span>}</h2>
        <p class="mt-1 text-xs text-ink-muted">Ledger'a henüz girmedi, seviyeye sayılmaz; koşulu gerçekleşince kesinleşir.</p>
        <ul class="mt-3 space-y-2 text-sm">
          {bekleyenler.map((b) => (
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-line px-3 py-2">
              <span class="text-ink">{b.note ?? b.reason}</span>
              <span class="text-xs text-ink-muted">+{b.delta} · {bekleyenZaman(b)}</span>
            </li>
          ))}
          {hostBek.map((h) => (
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-line px-3 py-2" data-host-bekleyen>
              <span class="text-ink">🎤 <a href={R.etkinlik(h.etkinlik.slug ?? String(h.etkinlik.id))} class="hover:text-accent">{h.etkinlik.title}</a> — düzenleyen payı ({h.katilimci} doğrulanmış katılımcı)</span>
              <span class="text-xs text-ink-muted">≈ +{h.tahmini} · {tarihKisa(h.dagitim)} sonrası dağıtılır</span>
            </li>
          ))}
          {kirpilanlar.map((b) => (
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-dashed border-line px-3 py-2 text-ink-muted">
              <span>{b.note ?? b.reason}</span>
              <span class="text-xs">+{b.yazilan} yazıldı / +{b.delta} ({b.yazilan === 0 ? "tavan dolu, kırpıldı" : "tavana kırpıldı"})</span>
            </li>
          ))}
        </ul>
      </section>
    )}

  {
    uzerimdeki.length > 0 && (
      <section class="mt-8 rounded-2xl border border-line bg-surface-raised p-5" data-reveal>
        <h2 class="font-display text-xl font-semibold text-ink">🔨 Görevlerim</h2>
        <p class="mt-1 text-xs text-ink-muted">Üstlendiğin kampanya görevleri — teslim ettikçe puan kazanırsın (×1.5).</p>
        <ul class="mt-3 divide-y divide-line">
          {uzerimdeki.map((g) => {
            const kalanMs = g.dueAt ? g.dueAt.getTime() - Date.now() : null;
            const acil = kalanMs !== null && kalanMs < 864e5;
            return (
              <li class="flex flex-wrap items-center justify-between gap-2 py-2.5">
                <a href={`/kampanya/${g.campaignId}`} class="min-w-0 flex-1 truncate text-sm font-medium text-ink hover:text-accent">
                  {g.title}
                </a>
                <span class="flex items-center gap-2 text-xs">
                  {g.dueAt && (
                    <span class:list={[acil ? "font-medium text-amber-600" : "text-ink-muted"]}>
                      {kalanMs! < 0 ? "⏰ süresi geçti" : acil ? `⏳ ${Math.ceil(kalanMs! / 36e5)} saat` : `📆 ${Math.ceil(kalanMs! / 864e5)} gün`}
                    </span>
                  )}
                  {g.status === "review" ? (
                    <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-accent">🔍 İncelemede</span>
                  ) : (
                    <a href={`/kampanya/${g.campaignId}`} class="rounded-full bg-accent px-3 py-1 font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">
                      Teslim et →
                    </a>
                  )}
                  <span class="font-semibold text-accent">+{Math.round(g.rewardPoints * 1.5)}p</span>
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <section class="mt-8" data-reveal>
    <h2 class="font-display text-xl font-semibold text-ink">{t("kutuphane.kitapRafi")}</h2>
    <ul class="mt-4 grid grid-cols-3 gap-4 sm:grid-cols-4 lg:grid-cols-6" data-stagger>
      {
        myBooks.map((b) => (
          <li>
            <a href={`/kutuphane/kitap/${b!.id}`} class="book-3d group/book block">
              {b!.cover ? (
                <img src={b!.cover} alt={b!.title} width="320" height="427" loading="lazy" class="aspect-[3/4] w-full rounded-lg border border-line object-cover" />
              ) : (
                <span class="flex aspect-[3/4] w-full items-center justify-center rounded-lg border border-line bg-accent-soft p-2 text-center font-display text-xs font-semibold text-accent">
                  {b!.title}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10 grid gap-6 lg:grid-cols-2">
    <div class="rounded-2xl border border-line bg-surface-raised p-6" data-reveal>
      <h2 class="font-display text-xl font-semibold text-ink">🎁 Kitap hediye et</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Rafındaki bir kitabı arkadaşına aç — <strong class="text-accent">{PUAN.giftBookCost} puan</strong> (kendine açmanın yarısı).
      </p>
      {/* Hediye sonucu: başarısız dallar eskiden SESSİZDİ — üye yanlış
          handle yazsa bile hediyenin gittiğini sanıyordu. */}
      {hediyeMesaji && (
        <p
          class:list={[
            "mt-3 rounded-lg border px-3 py-2 text-sm",
            hediyeDurumu === "ok"
              ? "border-accent bg-accent-soft text-ink"
              : "border-line bg-surface text-ink-muted",
          ]}
          role="status"
        >
          {hediyeMesaji}
        </p>
      )}
      <form method="post" action="/api/uye/hediye-et" class="mt-3 grid gap-2">
        <select name="bookId" required class="rounded-lg border border-line bg-surface px-3 py-2 text-sm">
          {myBooks.map((b) => <option value={b!.id}>{b!.titleTr ?? b!.title}</option>)}
        </select>
        <div class="flex gap-2">
          <input name="handle" required placeholder="@kullanici-adi" class="w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm" />
          <button class="cursor-pointer rounded-full bg-accent px-5 py-2 text-sm font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">Gönder</button>
        </div>
      </form>
      <a href="/uye/magaza" class="mt-3 inline-block text-sm font-medium text-accent hover:underline">✨ Puan mağazası →</a>
    </div>
    <div class="rounded-2xl border border-line bg-surface-raised p-6" data-reveal>
      <h2 class="font-display text-xl font-semibold text-ink">🤝 Davet linkin</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Arkadaşın katılınca +25, ilk yazısı onaylanınca +75 puan.
      </p>
      <code class="mt-3 block select-all overflow-x-auto rounded-lg border border-line bg-surface px-3 py-2 text-sm text-accent">
        {inviteUrl}
      </code>
      {/* Link tek başına paylaşılmaz: kopyalama ve hazır paylaşım kanalları
          olmadan davet kutusu ölü bir metin bloğuydu. */}
      <div class="mt-3 flex flex-wrap gap-1.5">
        <button
          type="button"
          data-ref-kopyala={inviteUrl}
          class="pill-pop cursor-pointer rounded-full bg-accent px-4 py-1.5 text-xs font-medium text-surface"
        >
          🔗 Linki kopyala
        </button>
        <a
          href={`https://wa.me/?text=${davetMetni}`}
          target="_blank"
          rel="noopener noreferrer"
          class="pill-pop rounded-full border border-line px-4 py-1.5 text-xs font-medium hover:border-accent hover:text-accent"
        >
          WhatsApp
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(inviteUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="pill-pop rounded-full border border-line px-4 py-1.5 text-xs font-medium hover:border-accent hover:text-accent"
        >
          LinkedIn
        </a>
      </div>
      <script>
        // Panodaki kopyala düğmesi (kitap sayfasındaki desenle aynı)
        document.addEventListener("click", async (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-ref-kopyala]");
          if (!btn) return;
          await navigator.clipboard.writeText(btn.dataset.refKopyala ?? "");
          const eski = btn.textContent;
          btn.textContent = "Kopyalandı ✓";
          setTimeout(() => (btn.textContent = eski), 2000);
        });
      </script>
    </div>
    <div id="bildirimler" class="scroll-mt-24 rounded-2xl border border-line bg-surface-raised p-6" data-reveal>
      <h2 class="font-display text-xl font-semibold text-ink">
        🔔 Bildirimler
        {okunmamisSayisi > 0 && (
          <span class="ml-2 rounded-full bg-accent px-2 py-0.5 align-middle text-xs font-bold text-surface">
            {okunmamisSayisi} yeni
          </span>
        )}
      </h2>
      {
        notifs.length === 0 ? (
          <p class="mt-2 text-sm text-ink-muted">Henüz bildirim yok.</p>
        ) : (
          <ul class="mt-3 space-y-2 text-sm">
            {notifs.map((n) => (
              <li
                class:list={[
                  "rounded-lg border px-3 py-2",
                  n.readAt
                    ? "border-line text-ink-muted"
                    : "border-accent bg-accent-soft/40 text-ink",
                ]}
              >
                {n.href ? (
                  <a href={n.href} class="hover:text-accent">{n.body}</a>
                ) : (
                  n.body
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
