---
/** Admin paneli: bekleyen yazılar + başvurular (yalnızca role=admin). */
import { asc, desc, eq, inArray, sql } from "drizzle-orm";
import Base from "@/layouts/Base.astro";
import { db, schema } from "@/db/client.ts";
import { getOrCreateMember } from "@/lib/member.ts";
import { turEtiketi } from "@/lib/topluluk.ts";
import { renderMemberMarkdown } from "@/lib/markdown.ts";
import EkonomiKarti from "@/features/admin/EkonomiKarti.astro";
import { ekonomiKarti, isaretliHesaplar } from "@/lib/ekonomi.ts";

export const prerender = false;

const member = await getOrCreateMember(Astro);
if (!member || member.role !== "admin") return Astro.redirect("/uye");

const pendingPosts = await db.query.memberPosts.findMany({
  where: eq(schema.memberPosts.status, "pending"),
  orderBy: desc(schema.memberPosts.createdAt),
});
const authors = new Map(
  (await db.query.users.findMany()).map((u) => [u.id, u]),
);
const pendingClubs = await db.query.clubs.findMany({
  where: eq(schema.clubs.status, "pending"),
});
const pendingQuizzes = await db.query.quizzes.findMany({
  where: eq(schema.quizzes.status, "pending"),
});
// Kurs onayı (F1-01) — eskiden pending kurs hiç yayınlanamıyordu
const pendingCourses = await db.query.courses.findMany({
  where: eq(schema.courses.status, "pending"),
  orderBy: desc(schema.courses.createdAt),
});
// Şikâyet kuyruğu (F1-10): hedef başına grupla
// En ESKİ açık kayıttan başlar (FIFO): yeni şikâyet seli eski gerçek şikâyeti 200'lük pencereden itemesin
const acikSikayetler = await db.query.reports.findMany({
  where: eq(schema.reports.status, "open"),
  orderBy: asc(schema.reports.createdAt),
  limit: 200,
});
const sikayetGruplari = [
  ...acikSikayetler
    .reduce((m, r) => {
      const k = `${r.targetType}:${r.targetId}`;
      const g = m.get(k) ?? { targetType: r.targetType, targetId: r.targetId, adet: 0, nedenler: [] as string[], edenler: [] as number[] };
      g.adet++;
      g.edenler.push(r.reporterId);
      if (r.reason) g.nedenler.push(r.reason);
      return m.set(k, g);
    }, new Map<string, { targetType: string; targetId: number; adet: number; nedenler: string[]; edenler: number[] }>())
    .values(),
];
const sikayetliKurslar = new Map(
  (
    await db.query.courses.findMany({
      where: inArray(
        schema.courses.id,
        sikayetGruplari.filter((g) => g.targetType === "course").map((g) => g.targetId).concat([0]),
      ),
    })
  ).map((c) => [c.id, c]),
);
const sikayetliYorumlar = new Map(
  (
    await db.query.comments.findMany({
      where: inArray(
        schema.comments.id,
        sikayetGruplari.filter((g) => g.targetType === "comment").map((g) => g.targetId).concat([0]),
      ),
    })
  ).map((c) => [c.id, c]),
);
// Üye / mesaj şikâyetleri (F4-04): yalnız ŞİKÂYET EDİLEN mesajın gövdesi okunur (konuşmanın tamamı değil)
const sikayetliMesajlar = new Map(
  (
    await db.query.messages.findMany({
      where: inArray(
        schema.messages.id,
        sikayetGruplari.filter((g) => g.targetType === "message").map((g) => g.targetId).concat([0]),
      ),
    })
  ).map((m) => [m.id, m]),
);
const sikayetliUyeler = new Map(
  (
    await db.query.users.findMany({
      where: inArray(
        schema.users.id,
        sikayetGruplari
          .filter((g) => g.targetType === "user")
          .map((g) => g.targetId)
          .concat(
            [...sikayetliMesajlar.values()].map((m) => m.senderId),
            // Üye/mesaj şikâyetinde şikâyet eden de gösterilir (toplu/kötü niyetli şikâyet ayırt edilsin)
            sikayetGruplari.filter((g) => g.targetType === "user" || g.targetType === "message").flatMap((g) => g.edenler),
            [0],
          ),
      ),
      columns: { id: true, handle: true, name: true },
    })
  ).map((u) => [u.id, u]),
);
const SIKAYET_TURU: Record<string, string> = { course: "Kurs", comment: "Yorum", user: "Üye", message: "Mesaj" };
// Faz 4 ölçümleri (PRD §8: "haritada görünme oranı, mesaj şikâyetleri")
const [olcum] = await db
  .select({
    konumlu: sql<number>`count(*) filter (where ${schema.users.city} is not null)`,
    gorunen: sql<number>`count(*) filter (where ${schema.users.mapVisibleAt} is not null)`,
  })
  .from(schema.users);
const [mesajOlcum] = await db
  .select({
    mesaj: sql<number>`count(*) filter (where ${schema.messages.createdAt} > now() - interval '7 days')`,
    yazan: sql<number>`count(distinct ${schema.messages.senderId}) filter (where ${schema.messages.createdAt} > now() - interval '7 days')`,
  })
  .from(schema.messages);
// Kuyruk listesinin 200'lük penceresinden değil DB'den: pencere dolunca eksik sayardı
const [sikayetOlcum] = await db
  .select({ n: sql<number>`count(*) filter (where ${schema.reports.targetType} in ('user', 'message'))` })
  .from(schema.reports)
  .where(eq(schema.reports.status, "open"));
const kisiselSikayet = Number(sikayetOlcum?.n ?? 0);
// Faz 5: ekonomi kartı (tek SQL) + suistimal kuyruğu
const [kart, isaretliler] = await Promise.all([ekonomiKarti(), isaretliHesaplar()]);
const pendingApps = await db.query.applications.findMany({
  where: eq(schema.applications.status, "pending"),
  orderBy: desc(schema.applications.createdAt),
});
---

<Base title="Admin">
  <h1 class="font-display text-3xl font-semibold text-ink">Admin paneli</h1>

  <EkonomiKarti kart={kart} />

  <section class="mt-10" data-suistimal-kuyrugu>
    <h2 class="font-display text-xl font-semibold text-ink">Suistimal kuyruğu ({isaretliler.length})</h2>
    <p class="mt-1 text-sm text-ink-muted">
      İşaretli hesap lider ve lig tablolarında görünmez; ona ya da ondan doğan bekleyen puan olgunlaşmaz.
      İşaret: davet çiftliği taraması (günlük) ya da "Haklı" bulunan üye / mesaj şikâyeti.
      "Temiz" tutulan puanı serbest bırakır; "Suistimal" işareti korur ve tutulan puanı düşürür.
    </p>
    {isaretliler.length === 0 && <p class="mt-2 text-ink-muted">İşaretli hesap yok.</p>}
    <ul class="mt-4 space-y-3">
      {
        isaretliler.map((u) => (
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface-raised px-4 py-3">
            <span class="text-sm text-ink">
              <a href={`/u/${u.handle}`} class="font-medium hover:text-accent">{u.name} (@{u.handle})</a>
              <span class="block text-xs text-ink-muted">
                hesap {u.acilis} · işaret {u.isaret}
                {u.davet_eden && <> · davet eden @{u.davet_eden}</>}
                {u.tutulan > 0 && <> · tutulan bekleyen <strong class="text-ink">+{u.tutulan}</strong></>}
              </span>
            </span>
            <form method="post" action="/api/uye/admin" class="flex gap-2">
              <input type="hidden" name="userId" value={u.id} />
              {u.tutulan > 0 && (
                <button name="action" value="flag_confirm" class="cursor-pointer rounded-full border border-red-400 px-4 py-1.5 text-sm text-red-500 transition-colors hover:bg-red-500 hover:text-white">Suistimal (bekleyeni düşür)</button>
              )}
              <button name="action" value="flag_clear" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted transition-colors hover:border-accent hover:text-accent">Temiz (işareti kaldır)</button>
            </form>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="font-display text-xl font-semibold text-ink">
      Onay bekleyen yazılar ({pendingPosts.length})
    </h2>
    {pendingPosts.length === 0 && <p class="mt-2 text-ink-muted">Bekleyen yazı yok.</p>}
    <div class="mt-4 space-y-6">
      {
        pendingPosts.map((p) => (
          <article class="rounded-2xl border border-line bg-surface-raised p-5">
            <header class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 class="font-display text-lg font-semibold text-ink">{p.title}</h3>
                <p class="text-sm text-ink-muted">
                  @{authors.get(p.userId)?.handle} · {p.bookId ?? "kitapsız"}
                </p>
              </div>
              <form method="post" action="/api/uye/admin" class="flex gap-2">
                <input type="hidden" name="postId" value={p.id} />
                <button name="action" value="approve" class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface hover:scale-105 active:scale-[0.97] transition-transform">
                  Onayla (+100)
                </button>
                <button name="action" value="reject" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted hover:border-red-400 hover:text-red-500 transition-colors">
                  Reddet
                </button>
              </form>
            </header>
            <details class="mt-3">
              <summary class="cursor-pointer text-sm text-accent">İçeriği göster</summary>
              <div class="prose prose-sm mt-2 max-w-none dark:prose-invert" set:html={renderMemberMarkdown(p.markdown)} />
            </details>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-xl font-semibold text-ink">
      Onay bekleyen kulüpler ({pendingClubs.length})
    </h2>
    <ul class="mt-4 space-y-3">
      {
        pendingClubs.map((c) => (
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface-raised px-4 py-3">
            <span class="text-sm text-ink">
              <strong>{c.name}</strong> — {turEtiketi(c.kind)} · {c.place}, {c.il} · 👑 @{authors.get(c.presidentId)?.handle}
              {c.description && <span class="block text-ink-muted">{c.description}</span>}
            </span>
            <form method="post" action="/api/uye/admin" class="flex gap-2">
              <input type="hidden" name="clubId" value={c.id} />
              <button name="action" value="club_approve" class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface">Onayla</button>
              <button name="action" value="club_reject" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted">Reddet</button>
            </form>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-xl font-semibold text-ink">
      Onay bekleyen quiz'ler ({pendingQuizzes.length})
    </h2>
    <ul class="mt-4 space-y-3">
      {
        pendingQuizzes.map((q) => (
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface-raised px-4 py-3">
            <span class="text-sm text-ink">
              <strong>{q.title}</strong> — {q.bookId} · @{q.createdBy ? authors.get(q.createdBy)?.handle : "?"}
            </span>
            <form method="post" action="/api/uye/admin" class="flex gap-2">
              <input type="hidden" name="quizId" value={q.id} />
              <button name="action" value="quiz_approve" class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface">Yayınla (+75)</button>
              <button name="action" value="quiz_reject" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted">Reddet</button>
            </form>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-xl font-semibold text-ink">
      Başvurular ({pendingApps.length})
    </h2>
    {pendingApps.length === 0 && <p class="mt-2 text-ink-muted">Bekleyen başvuru yok.</p>}
    <ul class="mt-4 space-y-3">
      {
        pendingApps.map((a) => (
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface-raised px-4 py-3">
            <span class="text-sm text-ink">
              <strong>@{authors.get(a.userId)?.handle}</strong> — {a.kind}: {a.place}
              {a.message && <span class="block text-ink-muted">{a.message}</span>}
            </span>
            <form method="post" action="/api/uye/admin" class="flex gap-2">
              <input type="hidden" name="appId" value={a.id} />
              <button name="action" value="app_approve" class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface">Onayla</button>
              <button name="action" value="app_reject" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted">Reddet</button>
            </form>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="mt-10">
    <h2 class="font-display text-xl font-semibold text-ink">
      Onay bekleyen kurslar ({pendingCourses.length})
    </h2>
    {pendingCourses.length === 0 && <p class="mt-2 text-ink-muted">Bekleyen kurs yok.</p>}
    <div class="mt-4 space-y-4">
      {pendingCourses.map((c) => (
        <article class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-line bg-surface-raised p-5">
          <div>
            <h3 class="font-display text-lg font-semibold text-ink">
              <a href={`/kurslar/${c.slug}`} class="hover:text-accent">{c.title}</a>
            </h3>
            <p class="text-sm text-ink-muted">@{authors.get(c.createdBy)?.handle} · {c.summary ?? c.description ?? "açıklama yok"}</p>
          </div>
          <form method="post" action="/api/uye/admin" class="flex gap-2">
            <input type="hidden" name="courseId" value={c.id} />
            <button name="action" value="course_approve" class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">Yayınla</button>
            <button name="action" value="course_reject" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted transition-colors hover:border-red-400 hover:text-red-500">Reddet</button>
          </form>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-xl font-semibold text-ink">Şikâyet kuyruğu ({sikayetGruplari.length})</h2>
    <p class="mt-1 text-sm text-ink-muted" data-faz4-olcum>
      Haritada görünen <strong class="text-ink">{Number(olcum?.gorunen ?? 0)}</strong> / konumlu {Number(olcum?.konumlu ?? 0)} üye ·
      son 7 günde <strong class="text-ink">{Number(mesajOlcum?.mesaj ?? 0)}</strong> mesaj ({Number(mesajOlcum?.yazan ?? 0)} gönderen) ·
      açık üye/mesaj şikâyeti <strong class="text-ink">{kisiselSikayet}</strong>
    </p>
    {sikayetGruplari.length === 0 && <p class="mt-2 text-ink-muted">Açık şikâyet yok.</p>}
    <div class="mt-4 space-y-4">
      {sikayetGruplari.map((g) => {
        const kurs = g.targetType === "course" ? sikayetliKurslar.get(g.targetId) : undefined;
        const yorum = g.targetType === "comment" ? sikayetliYorumlar.get(g.targetId) : undefined;
        const gizli = kurs ? kurs.status === "hidden" : !!yorum?.hiddenAt;
        const mesaj = g.targetType === "message" ? sikayetliMesajlar.get(g.targetId) : undefined;
        const uye = sikayetliUyeler.get(g.targetType === "user" ? g.targetId : (mesaj?.senderId ?? 0));
        // Üye/mesajda otomatik etki yok: düğmeler yalnız kuyruk kaydını kapatır
        const kisisel = g.targetType === "user" || g.targetType === "message";
        return (
          <article class="rounded-2xl border border-line bg-surface-raised p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="text-xs text-ink-muted">{SIKAYET_TURU[g.targetType] ?? g.targetType} · {g.adet} şikâyet {gizli && <span class="rounded-full bg-amber-100 px-2 py-0.5 text-amber-800">gizlendi</span>}</p>
                <p class="mt-1 font-medium text-ink">
                  {kurs ? (
                    <a href={`/kurslar/${kurs.slug}`} class="hover:text-accent">{kurs.title}</a>
                  ) : yorum ? (
                    yorum.body.slice(0, 160)
                  ) : uye ? (
                    <a href={`/u/${uye.handle}`} class="hover:text-accent">{uye.name} (@{uye.handle})</a>
                  ) : (
                    `#${g.targetId}`
                  )}
                </p>
                {/* Mesaj gövdesi düz metin: yalnız Astro kaçışı, bağlantıya ÇEVRİLMEZ (admin oturumu) */}
                {mesaj && <p class="mt-1 max-h-60 overflow-y-auto whitespace-pre-wrap break-words rounded-lg bg-surface p-2 text-sm text-ink">{mesaj.body}</p>}
                {kisisel && (
                  <p class="mt-1 text-xs text-ink-muted">
                    Şikâyet eden: {g.edenler.map((id) => sikayetliUyeler.get(id)).filter(Boolean).map((u) => `@${u!.handle}`).join(", ") || "—"}
                  </p>
                )}
                {g.nedenler.length > 0 && <p class="mt-1 text-sm text-ink-muted">{g.nedenler.slice(0, 3).join(" · ")}</p>}
              </div>
              <form method="post" action="/api/uye/admin" class="flex gap-2">
                <input type="hidden" name="reportTarget" value={g.targetType} />
                <input type="hidden" name="reportTargetId" value={g.targetId} />
                <button name="action" value="report_remove" class="cursor-pointer rounded-full border border-red-400 px-4 py-1.5 text-sm text-red-500 transition-colors hover:bg-red-500 hover:text-white">{kisisel ? "Haklı (üyeyi işaretle)" : "Kaldır"}{g.targetType === "course" && " (+iade)"}</button>
                <button name="action" value="report_restore" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted transition-colors hover:border-accent hover:text-accent">{kisisel ? "Reddet" : "Geri aç"}</button>
              </form>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Base>
