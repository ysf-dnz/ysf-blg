---
/** Admin paneli: bekleyen yazılar + başvurular (yalnızca role=admin). */
import { desc, eq } from "drizzle-orm";
import Base from "@/layouts/Base.astro";
import { db, schema } from "@/db/client.ts";
import { getOrCreateMember } from "@/lib/member.ts";
import { renderMemberMarkdown } from "@/lib/markdown.ts";

export const prerender = false;

const member = await getOrCreateMember(Astro);
if (!member || member.role !== "admin") return Astro.redirect("/uye");

const pendingPosts = await db.query.memberPosts.findMany({
  where: eq(schema.memberPosts.status, "pending"),
  orderBy: desc(schema.memberPosts.createdAt),
});
const authors = new Map(
  (await db.query.users.findMany()).map((u) => [u.id, u]),
);
const pendingClubs = await db.query.clubs.findMany({
  where: eq(schema.clubs.status, "pending"),
});
const pendingQuizzes = await db.query.quizzes.findMany({
  where: eq(schema.quizzes.status, "pending"),
});
const pendingApps = await db.query.applications.findMany({
  where: eq(schema.applications.status, "pending"),
  orderBy: desc(schema.applications.createdAt),
});
---

<Base title="Admin">
  <h1 class="font-display text-3xl font-semibold text-ink">Admin paneli</h1>

  <section class="mt-8">
    <h2 class="font-display text-xl font-semibold text-ink">
      Onay bekleyen yazılar ({pendingPosts.length})
    </h2>
    {pendingPosts.length === 0 && <p class="mt-2 text-ink-muted">Bekleyen yazı yok.</p>}
    <div class="mt-4 space-y-6">
      {
        pendingPosts.map((p) => (
          <article class="rounded-2xl border border-line bg-surface-raised p-5">
            <header class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 class="font-display text-lg font-semibold text-ink">{p.title}</h3>
                <p class="text-sm text-ink-muted">
                  @{authors.get(p.userId)?.handle} · {p.bookId ?? "kitapsız"}
                </p>
              </div>
              <form method="post" action="/api/uye/admin" class="flex gap-2">
                <input type="hidden" name="postId" value={p.id} />
                <button name="action" value="approve" class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface hover:scale-105 active:scale-[0.97] transition-transform">
                  Onayla (+100)
                </button>
                <button name="action" value="reject" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted hover:border-red-400 hover:text-red-500 transition-colors">
                  Reddet
                </button>
              </form>
            </header>
            <details class="mt-3">
              <summary class="cursor-pointer text-sm text-accent">İçeriği göster</summary>
              <div class="prose prose-sm mt-2 max-w-none dark:prose-invert" set:html={renderMemberMarkdown(p.markdown)} />
            </details>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-xl font-semibold text-ink">
      Onay bekleyen kulüpler ({pendingClubs.length})
    </h2>
    <ul class="mt-4 space-y-3">
      {
        pendingClubs.map((c) => (
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface-raised px-4 py-3">
            <span class="text-sm text-ink">
              <strong>{c.name}</strong> — {c.kind} · {c.place}, {c.il} · 👑 @{authors.get(c.presidentId)?.handle}
              {c.description && <span class="block text-ink-muted">{c.description}</span>}
            </span>
            <form method="post" action="/api/uye/admin" class="flex gap-2">
              <input type="hidden" name="clubId" value={c.id} />
              <button name="action" value="club_approve" class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface">Onayla</button>
              <button name="action" value="club_reject" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted">Reddet</button>
            </form>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-xl font-semibold text-ink">
      Onay bekleyen quiz'ler ({pendingQuizzes.length})
    </h2>
    <ul class="mt-4 space-y-3">
      {
        pendingQuizzes.map((q) => (
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface-raised px-4 py-3">
            <span class="text-sm text-ink">
              <strong>{q.title}</strong> — {q.bookId} · @{q.createdBy ? authors.get(q.createdBy)?.handle : "?"}
            </span>
            <form method="post" action="/api/uye/admin" class="flex gap-2">
              <input type="hidden" name="quizId" value={q.id} />
              <button name="action" value="quiz_approve" class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface">Yayınla (+75)</button>
              <button name="action" value="quiz_reject" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted">Reddet</button>
            </form>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-xl font-semibold text-ink">
      Başvurular ({pendingApps.length})
    </h2>
    {pendingApps.length === 0 && <p class="mt-2 text-ink-muted">Bekleyen başvuru yok.</p>}
    <ul class="mt-4 space-y-3">
      {
        pendingApps.map((a) => (
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface-raised px-4 py-3">
            <span class="text-sm text-ink">
              <strong>@{authors.get(a.userId)?.handle}</strong> — {a.kind}: {a.place}
              {a.message && <span class="block text-ink-muted">{a.message}</span>}
            </span>
            <form method="post" action="/api/uye/admin" class="flex gap-2">
              <input type="hidden" name="appId" value={a.id} />
              <button name="action" value="app_approve" class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface">Onayla</button>
              <button name="action" value="app_reject" class="cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted">Reddet</button>
            </form>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
