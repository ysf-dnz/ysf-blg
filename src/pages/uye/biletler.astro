---
/**
 * Biletlerim — kayıtlı olduğum etkinliklerin kişisel bilet QR'ları (ADR K6: kolonsuz,
 * {rsvpId}.{imza}). QR sunucuda SVG; içerik HTTPS://HOST/T/{TOKEN}. Kapıda görevli okutur.
 */
import { asc, eq, inArray } from "drizzle-orm";
import { renderSVG } from "uqr";
import Base from "@/layouts/Base.astro";
import { db, schema } from "@/db/client.ts";
import { biletQrIcerigi, biletToken, etkinlikBitis, trAralik, trSaat } from "@/lib/etkinlik-kural.ts";
import { getOrCreateMember } from "@/lib/member.ts";
import { PUAN } from "@/lib/points.ts";
import { R } from "@/lib/routes.ts";
import { siteKok } from "@/lib/urls.ts";

export const prerender = false;

const member = await getOrCreateMember(Astro);
if (!member) return Astro.redirect("/");

const kayitlar = await db.query.eventRsvps.findMany({ where: eq(schema.eventRsvps.userId, member.id) });
const etkinlikler = kayitlar.length
  ? await db.query.events.findMany({
      where: inArray(schema.events.id, kayitlar.map((k) => k.eventId)),
      orderBy: asc(schema.events.startsAt),
    })
  : [];
const kayit = new Map(kayitlar.map((k) => [k.eventId, k]));
const simdi = new Date();
const kok = siteKok(Astro.site, Astro.url);
// Bitişinden 1 gün geçmiş etkinliğin bileti listelenmez
const biletler = etkinlikler
  .filter((e) => etkinlikBitis(e).getTime() > simdi.getTime() - 864e5)
  .map((e) => {
    const r = kayit.get(e.id)!;
    const token = biletToken(r.id);
    return { e, r, token, qr: renderSVG(biletQrIcerigi(kok, token), { ecc: "M", border: 2 }) };
  });
---

<Base title="Biletlerim" description="Kayıtlı olduğun etkinliklerin giriş biletleri." seo={{ noindex: true }}>
  <section class="girih-texture -mx-4 px-4 py-10">
    <h1 class="font-display text-3xl font-semibold text-ink">🎟️ Biletlerim</h1>
    <p class="mt-2 text-ink-muted">
      Kapıda görevliye QR'ını göster. Girişin doğrulanınca <strong class="text-ink">+{PUAN.eventAttended} puan</strong>; kayıt tek başına puan üretmez.
    </p>
  </section>

  {biletler.length === 0 ? (
    <div class="mt-8 rounded-xl border border-line bg-surface-raised px-6 py-10 text-center">
      <p class="text-ink-muted">Yaklaşan etkinlik biletin yok.</p>
      <a href={R.etkinlikler} class="mt-3 inline-block font-medium text-accent hover:underline">Etkinliklere göz at →</a>
    </div>
  ) : (
    <ul class="mt-8 grid gap-5 sm:grid-cols-2" data-biletler>
      {biletler.map(({ e, r, token, qr }) => (
        <li id={`bilet-${r.id}`} class="rounded-2xl border border-line bg-surface-raised p-5" data-bilet={token}>
          <a href={R.etkinlik(e.slug ?? String(e.id))} class="font-display text-lg font-semibold text-ink hover:text-accent">{e.title}</a>
          <p class="mt-1 text-sm text-ink-muted">🕐 {trAralik(e)}</p>
          {e.location && <p class="text-sm text-ink-muted">📍 {e.location}</p>}
          <div class="mx-auto mt-4 w-52 rounded-xl bg-white p-2 [&_svg]:h-auto [&_svg]:w-full" set:html={qr} />
          <p class="mt-2 text-center font-mono text-xs text-ink-muted">{token}</p>
          {r.checkedInAt ? (
            <p class="mt-3 rounded-full bg-accent-soft px-4 py-2 text-center text-sm font-medium text-accent">Girişin doğrulandı ✓ ({trSaat(r.checkedInAt)})</p>
          ) : (
            <p class="mt-3 text-center text-xs text-ink-muted">{r.priority && "⭐ Öncelikli koltuk · "}Bu QR kişiseldir; ekran görüntüsünü paylaşma.</p>
          )}
        </li>
      ))}
    </ul>
  )}
</Base>
