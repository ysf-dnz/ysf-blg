---
/**
 * Topluluklarımız — onaylı toplulukların (kulüp · vakıf · dernek · kurum…) kart ızgarası.
 * Tür ve il filtresi sorgu parametresiyle (SSR; istemci JS yok). Sayımlar gruplu tek
 * sorgularla: üye, yayındaki kurs, sıradaki etkinlik.
 */
import { and, asc, eq, gte, inArray, sql } from "drizzle-orm";
import ToplulukLayout from "@/layouts/ToplulukLayout.astro";
import { db, schema } from "@/db/client.ts";
import { R } from "@/lib/routes.ts";
import { ilBul, KULUP_TUR, kulupTuruMu, turEtiketi } from "@/lib/topluluk.ts";
import { trSaat, trTarih } from "@/lib/etkinlik-kural.ts";

export const prerender = false;

const q = Astro.url.searchParams;
const tur = kulupTuruMu(q.get("tur") ?? "") ? (q.get("tur") as keyof typeof KULUP_TUR) : null;
const il = ilBul(q.get("il"));

const tumu = await db.query.clubs.findMany({ where: eq(schema.clubs.status, "approved") });
// Eski satırlarda il serbest metin olabilir ("ankara ") → karşılaştırma kanonik ad üzerinden
const ilAdi = (c: (typeof tumu)[number]) => ilBul(c.il) ?? c.il;
const clubsHam = tumu.filter((c) => (!tur || c.kind === tur) && (!il || ilAdi(c) === il));
const ids = clubsHam.map((c) => c.id);

const [uyeSatir, kursSatir, etkinlikler] = await Promise.all([
  ids.length
    ? db
        .select({ clubId: schema.clubMembers.clubId, n: sql<number>`count(*)` })
        .from(schema.clubMembers)
        .where(inArray(schema.clubMembers.clubId, ids))
        .groupBy(schema.clubMembers.clubId)
    : [],
  ids.length
    ? db
        .select({ clubId: schema.courses.clubId, n: sql<number>`count(*)` })
        .from(schema.courses)
        .where(and(inArray(schema.courses.clubId, ids), eq(schema.courses.status, "published")))
        .groupBy(schema.courses.clubId)
    : [],
  ids.length
    ? db.query.events.findMany({
        where: and(inArray(schema.events.clubId, ids), gte(schema.events.startsAt, new Date())),
        orderBy: asc(schema.events.startsAt),
      })
    : [],
]);
const uye = new Map(uyeSatir.map((r) => [r.clubId, Number(r.n)]));
const kurs = new Map(kursSatir.map((r) => [r.clubId, Number(r.n)]));
const siradaki = new Map<number, (typeof etkinlikler)[number]>();
for (const e of etkinlikler) if (e.clubId && !siradaki.has(e.clubId)) siradaki.set(e.clubId, e);
const clubs = [...clubsHam].sort((a, b) => (uye.get(b.id) ?? 0) - (uye.get(a.id) ?? 0));

// Filtre seçenekleri yalnız VAR OLAN tür ve illerden (81 boş seçenek yerine)
const mevcutTurler = Object.keys(KULUP_TUR).filter((k) => tumu.some((c) => c.kind === k));
const mevcutIller = [...new Set(tumu.map(ilAdi))].sort((a, b) => a.localeCompare(b, "tr"));
const link = (ek: Record<string, string | null>) => {
  const p = new URLSearchParams(q);
  for (const [k, v] of Object.entries(ek)) v ? p.set(k, v) : p.delete(k);
  const s = p.toString();
  return `${R.kulupler}${s ? `?${s}` : ""}`;
};
const pill = (aktif: boolean) => [
  "rounded-full px-3.5 py-1.5 transition-colors",
  aktif ? "bg-accent font-semibold text-surface" : "border border-line text-ink-muted hover:border-accent hover:text-accent",
];
---

<ToplulukLayout
  title="Topluluklarımız"
  description="Şehir, üniversite, lise toplulukları; vakıf, dernek ve kurumların okuma grupları. Birlikte oku, üret, etkinlik düzenle."
>
  <section class="girih-texture -mx-4 px-4 py-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">🏛️ Topluluklarımız</h1>
        <p class="mt-2 text-ink-muted">
          {tumu.length} topluluk birlikte okuyor, kurs açıyor, etkinlik düzenliyor — <a href={R.harita} class="text-accent hover:underline">haritada gör</a>.
        </p>
      </div>
      <a href={R.kulupKur} class="rounded-full bg-accent px-6 py-3 font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">
        Topluluk kur <span class="arrow-slide">→</span>
      </a>
    </div>
  </section>

  {tumu.length > 0 && (
    <nav class="mt-6 flex flex-wrap items-center gap-2 text-sm" aria-label="Topluluk filtreleri">
      <a href={link({ tur: null })} aria-current={!tur ? "page" : undefined} class:list={pill(!tur)}>Tümü</a>
      {mevcutTurler.map((k) => (
        <a href={link({ tur: k })} aria-current={tur === k ? "page" : undefined} class:list={pill(tur === k)}>{turEtiketi(k)}</a>
      ))}
      {mevcutIller.length > 1 && <span class="mx-1 h-5 w-px bg-line" aria-hidden="true"></span>}
      {mevcutIller.length > 1 && mevcutIller.map((ad) => (
        <a
          href={link({ il: il === ad ? null : ad })}
          aria-current={il === ad ? "page" : undefined}
          class:list={["rounded-full px-3 py-1.5 text-xs transition-colors", il === ad ? "bg-accent-soft font-semibold text-accent" : "border border-line text-ink-muted hover:text-accent"]}
        >📍 {ad}{il === ad && " ✕"}</a>
      ))}
    </nav>
  )}

  {
    clubs.length === 0 ? (
      <div class="mt-10 rounded-xl border border-line bg-surface-raised px-6 py-10 text-center" data-reveal>
        <p class="empty-float text-ink-muted">
          {tumu.length === 0 ? "Henüz onaylı topluluk yok — ilkini sen kur, haritaya adını yaz." : "Bu filtrede topluluk yok."}
        </p>
        <a href={tumu.length === 0 ? R.kulupKur : R.kulupler} class="mt-3 inline-block font-medium text-accent hover:underline">
          {tumu.length === 0 ? "Başvur →" : "Filtreyi temizle →"}
        </a>
      </div>
    ) : (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger data-topluluklar>
        {clubs.map((c) => {
          const e = siradaki.get(c.id);
          return (
            <li>
              <a href={R.kulup(c.slug)} class="hover-lift shine flex h-full flex-col rounded-xl border border-line bg-surface-raised p-5 hover:border-accent/50">
                <p class="text-xs font-medium text-accent">{turEtiketi(c.kind)}</p>
                <h2 class="font-display mt-1 text-lg font-semibold text-ink">{c.name}</h2>
                <p class="mt-1 text-sm text-ink-muted">{c.place} · 📍 {ilAdi(c)}</p>
                <p class="mt-3 text-sm text-ink-muted">
                  👥 {uye.get(c.id) ?? 0} üye · 🎓 {kurs.get(c.id) ?? 0} kurs
                </p>
                {e && (
                  <p class="mt-auto pt-3 text-xs text-ink">
                    <span class="text-ink-muted">Sıradaki etkinlik:</span> 📅 {e.title} · {trTarih(e.startsAt)} {trSaat(e.startsAt)}
                  </p>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</ToplulukLayout>
