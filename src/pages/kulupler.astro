---
/** Kulüp dizini. */
import { desc, eq, sql } from "drizzle-orm";
import ToplulukLayout from "@/layouts/ToplulukLayout.astro";
import { db, schema } from "@/db/client.ts";

export const prerender = false;

const memberCount = sql<number>`(select count(*) from ${schema.clubMembers} where ${schema.clubMembers.clubId} = ${schema.clubs.id})`;
const clubs = await db
  .select({
    id: schema.clubs.id,
    slug: schema.clubs.slug,
    name: schema.clubs.name,
    kind: schema.clubs.kind,
    place: schema.clubs.place,
    il: schema.clubs.il,
    members: memberCount,
  })
  .from(schema.clubs)
  .where(eq(schema.clubs.status, "approved"))
  .orderBy(desc(memberCount));

const TUR: Record<string, string> = {
  universite: "🎓 Üniversite",
  lise: "🏫 Lise",
  sehir: "🏙️ Şehir",
};
---

<ToplulukLayout title="Kulüpler" description="Şehir, üniversite ve lise okuma toplulukları.">
  <section class="girih-texture -mx-4 px-4 py-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">Kulüpler</h1>
        <p class="mt-2 text-ink-muted">Topluluğun hücreleri — <a href="/harita" class="text-accent hover:underline">haritada gör</a>.</p>
      </div>
      <a href="/kulup-kur" class="rounded-full bg-accent px-6 py-3 font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">
        Kulüp kur <span class="arrow-slide">→</span>
      </a>
    </div>
  </section>

  {
    clubs.length === 0 ? (
      <div class="mt-10 rounded-xl border border-line bg-surface-raised px-6 py-10 text-center" data-reveal>
        <p class="empty-float text-ink-muted">Henüz onaylı kulüp yok — ilkini sen kur, haritaya adını yaz.</p>
        <a href="/kulup-kur" class="mt-3 inline-block font-medium text-accent hover:underline">Başvur →</a>
      </div>
    ) : (
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {clubs.map((c) => (
          <li>
            <a href={`/kulup/${c.slug}`} class="hover-lift shine block h-full rounded-xl border border-line bg-surface-raised p-5 hover:border-accent/50">
              <p class="text-xs font-medium text-accent">{TUR[c.kind]}</p>
              <h2 class="font-display mt-1 text-lg font-semibold text-ink">{c.name}</h2>
              <p class="mt-1 text-sm text-ink-muted">{c.place} · {c.il}</p>
              <p class="mt-3 text-sm text-ink-muted">👥 {c.members} üye</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</ToplulukLayout>
