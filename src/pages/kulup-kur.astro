---
/** Kulüp kuruluş başvurusu: üniversite kulüp başkanları + lise temsilcileri. */
import Base from "@/layouts/Base.astro";
import { getOrCreateMember } from "@/lib/member.ts";

export const prerender = false;
const member = await getOrCreateMember(Astro);
---

<Base title="Kulüp kur" description="Şehrinde veya okulunda okuma topluluğu kur.">
  <section class="girih-texture -mx-4 px-4 py-12 text-center">
    <h1 class="word-reveal font-display text-3xl font-semibold text-ink sm:text-4xl">
      <span style="--i:0">Topluluğunu</span>
      <span style="--i:1" class="gradient-text">kur,</span>
      <span style="--i:2">birlikte</span>
      <span style="--i:3">büyüyün.</span>
    </h1>
    <p class="hero-sub mx-auto mt-3 max-w-lg text-ink-muted">
      Üniversite kulübü başkanıysan veya lisende temsilci olmak istiyorsan başvur;
      onaylanınca kendi panonla görev dağıt, etkinlik ve eğitim aç, haritada görün.
    </p>
  </section>

  {
    !member ? (
      <p class="mt-8 rounded-xl border border-line bg-surface-raised px-6 py-8 text-center text-ink-muted">
        Başvurmak için önce üye ol — sağ üstten <strong class="text-accent">Katıl</strong>.
      </p>
    ) : (
      <form method="post" action="/api/uye/kulup" class="mx-auto mt-8 grid max-w-lg gap-4" data-reveal>
        <input type="hidden" name="action" value="apply" />
        <label class="grid gap-1">
          <span class="text-sm font-medium text-ink">Kulüp adı</span>
          <input name="name" required maxlength="60" placeholder="Örn. ODTÜ Yapay Zekâ Okuma Kulübü" class="rounded-lg border border-line bg-surface-raised px-3 py-2" />
        </label>
        <label class="grid gap-1">
          <span class="text-sm font-medium text-ink">Tür</span>
          <select name="kind" class="rounded-lg border border-line bg-surface-raised px-3 py-2">
            <option value="universite">Üniversite kulübü</option>
            <option value="lise">Lise temsilciliği</option>
            <option value="sehir">Şehir topluluğu</option>
          </select>
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-1">
            <span class="text-sm font-medium text-ink">Okul / yer</span>
            <input name="place" required maxlength="80" placeholder="ODTÜ" class="rounded-lg border border-line bg-surface-raised px-3 py-2" />
          </label>
          <label class="grid gap-1">
            <span class="text-sm font-medium text-ink">İl</span>
            <input name="il" required maxlength="30" placeholder="Ankara" class="rounded-lg border border-line bg-surface-raised px-3 py-2" />
          </label>
        </div>
        <label class="grid gap-1">
          <span class="text-sm font-medium text-ink">Kendini ve planını anlat</span>
          <textarea name="message" rows="4" maxlength="1000" class="rounded-lg border border-line bg-surface-raised px-3 py-2" />
        </label>
        <button class="cursor-pointer rounded-full bg-accent px-6 py-3 font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">
          Başvur
        </button>
      </form>
    )
  }
</Base>
