---
/**
 * Kitap sayfası — STATİK ve Pagefind'de aranabilir (884 sayfa build'de).
 * Erişim kapısı, köprüler ve modüller BookDetail içindeki OkumaKapisi
 * server island'ında istek anında çözülür.
 */
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import BookDetail from "@/features/library/BookDetail.astro";

export const prerender = true;

export async function getStaticPaths() {
  const books = await getCollection("books");
  const qas = await getCollection("booksQa");
  const extras = await getCollection("bookExtras");
  return books.map((book) => ({
    params: { id: book.data.id },
    props: {
      book: book.data,
      qa: qas.find((q) => q.data.bookId === book.data.id)?.data,
      moduller:
        extras.find((e) => e.data.bookId === book.data.id)?.data.moduller ?? [],
    },
  }));
}

const { book, qa, moduller } = Astro.props;
---

<Base title={book.title} description={`${book.title} — kitap notları, soru-cevap analizi ve NotebookLM sohbeti.`}>
  <BookDetail book={book} qa={qa} moduller={moduller} lang="tr" />
</Base>
