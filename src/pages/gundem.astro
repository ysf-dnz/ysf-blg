---
/** Gündem: aktif kampanyalar + sonraki kitap oylaması. */
import { desc, eq, sql } from "drizzle-orm";
import { getCollection } from "astro:content";
import ToplulukLayout from "@/layouts/ToplulukLayout.astro";
import { db, schema } from "@/db/client.ts";
import { getOrCreateMember } from "@/lib/member.ts";
import { canManageGlobal } from "@/lib/permissions.ts";

export const prerender = false;

const member = await getOrCreateMember(Astro);
const campaigns = await db.query.campaigns.findMany({
  orderBy: desc(schema.campaigns.createdAt),
  limit: 20,
});
const clubIds = [...new Set(campaigns.map((c) => c.clubId).filter(Boolean) as number[])];
const clubs = new Map(
  clubIds.length
    ? (await db.query.clubs.findMany()).map((c) => [c.id, c])
    : [],
);

// Oylama: en çok oy alan aday kitaplar
const votes = await db
  .select({ bookId: schema.campaignVotes.bookId, c: sql<number>`count(*)` })
  .from(schema.campaignVotes)
  .groupBy(schema.campaignVotes.bookId)
  .orderBy(desc(sql`count(*)`))
  .limit(5);

const books = await getCollection("books");
const bookOf = (id: string) => books.find((b) => b.data.id === id)?.data;
const myBooks = member
  ? (
      await db.query.bookAccess.findMany({
        where: eq(schema.bookAccess.userId, member.id),
      })
    )
      .map((a) => bookOf(a.bookId))
      .filter(Boolean)
  : [];

const aktif = campaigns.find((c) => c.status === "active" && !c.clubId) ?? campaigns[0];
const aktifKitap = aktif ? bookOf(aktif.bookId) : undefined;
---

<ToplulukLayout title="Gündem" description="Topluluğun bu ayki kitabı ve aktif kampanyalar.">
  {
    aktif && (
      <section class="girih-texture -mx-4 px-4 py-12">
        <p class="text-sm font-medium uppercase tracking-wide text-accent">Gündemde</p>
        <h1 class="word-reveal font-display mt-1 text-3xl font-semibold text-ink sm:text-4xl">
          <span style="--i:0">{aktif.title}</span>
        </h1>
        <p class="hero-sub mt-2 text-ink-muted">
          📖 {aktifKitap?.titleTr ?? aktifKitap?.title ?? aktif.bookId} · üretimler ×1.5 puan
        </p>
        <a href={`/kampanya/${aktif.id}`} class="mt-4 inline-block rounded-full bg-accent px-6 py-3 font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">
          Panoya git <span class="arrow-slide">→</span>
        </a>
      </section>
    )
  }

  <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_340px]">
    <section>
      <div class="flex items-center justify-between">
        <h2 class="font-display text-xl font-semibold text-ink">Kampanyalar</h2>
        {canManageGlobal(member) && myBooks.length > 0 && (
          <details class="relative">
            <summary class="cursor-pointer list-none rounded-full border border-line px-4 py-1.5 text-sm text-ink-muted hover:border-accent hover:text-accent [&::-webkit-details-marker]:hidden">+ Kampanya aç</summary>
            <form method="post" action="/api/uye/kampanya" class="menu-pop absolute right-0 z-30 mt-2 grid w-72 gap-2 rounded-xl border border-line bg-surface-raised p-3 shadow-lg">
              <input name="title" required maxlength="80" placeholder="Başlık" class="rounded-lg border border-line bg-surface px-3 py-2 text-sm" />
              <select name="bookId" class="rounded-lg border border-line bg-surface px-3 py-2 text-sm">
                {myBooks.map((b) => <option value={b!.id}>{b!.titleTr ?? b!.title}</option>)}
              </select>
              <button class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface">Aç</button>
            </form>
          </details>
        )}
      </div>
      <ul class="mt-4 space-y-3" data-stagger>
        {campaigns.length === 0 && <p class="text-ink-muted">Henüz kampanya yok.</p>}
        {
          campaigns.map((c) => (
            <li>
              <a href={`/kampanya/${c.id}`} class="hover-lift flex flex-wrap items-center justify-between gap-2 rounded-xl border border-line bg-surface-raised px-5 py-3 hover:border-accent/50">
                <span>
                  <span class="block font-medium text-ink">{c.title}</span>
                  <span class="text-xs text-ink-muted">
                    {c.clubId ? clubs.get(c.clubId)?.name : "Site geneli"} · 📖 {bookOf(c.bookId)?.titleTr ?? bookOf(c.bookId)?.title}
                  </span>
                </span>
                <span class:list={["rounded-full px-3 py-1 text-xs font-medium", c.status === "active" ? "bg-accent-soft text-accent" : "border border-line text-ink-muted"]}>
                  {c.status === "active" ? "Aktif" : c.status === "done" ? "Bitti" : "Planlanıyor"}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <aside class="rounded-2xl border border-line bg-surface-raised p-5" data-reveal>
      <h2 class="font-display text-lg font-semibold text-ink">🗳️ Sonraki kitap?</h2>
      <p class="mt-1 text-sm text-ink-muted">Oyla; en çok oyu alan gündeme girer.</p>
      <ol class="mt-3 space-y-2 text-sm">
        {votes.length === 0 && <li class="text-ink-muted">İlk oyu sen ver.</li>}
        {
          votes.map((v, i) => (
            <li class="flex items-center justify-between rounded-lg border border-line px-3 py-2">
              <span class="truncate text-ink">{i + 1}. {bookOf(v.bookId)?.titleTr ?? bookOf(v.bookId)?.title ?? v.bookId}</span>
              <span class="ml-2 shrink-0 font-semibold text-accent">{v.c} oy</span>
            </li>
          ))
        }
      </ol>
      {
        member && myBooks.length > 0 && (
          <form method="post" action="/api/uye/oy" class="mt-4 flex gap-2">
            <select name="bookId" class="w-full rounded-lg border border-line bg-surface px-2 py-1.5 text-sm">
              {myBooks.map((b) => <option value={b!.id}>{b!.titleTr ?? b!.title}</option>)}
            </select>
            <button class="cursor-pointer rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-surface">Oyla</button>
          </form>
        )
      }
    </aside>
  </div>
</ToplulukLayout>
