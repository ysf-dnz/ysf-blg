---
/**
 * Liderlik tabloları (Skool formatı): 7 gün / 30 gün / tüm zamanlar,
 * üniversiteler arası takım tablosu. Yalnızca pozitif kazanımlar sayılır.
 */
import { and, desc, gte, isNotNull, sql } from "drizzle-orm";
import ToplulukLayout from "@/layouts/ToplulukLayout.astro";
import { db, schema } from "@/db/client.ts";
import { levelFor } from "@/lib/levels.ts";

export const prerender = false;

const tab = Astro.url.searchParams.get("t") ?? "7";
const since =
  tab === "7"
    ? new Date(Date.now() - 7 * 864e5)
    : tab === "30"
      ? new Date(Date.now() - 30 * 864e5)
      : null;

const earnedExpr = sql<number>`sum(case when ${schema.pointsLedger.delta} > 0 then ${schema.pointsLedger.delta} else 0 end)`;
const conds = [sql`${schema.pointsLedger.delta} > 0`];
if (since) conds.push(gte(schema.pointsLedger.createdAt, since));

const rows = await db
  .select({
    userId: schema.pointsLedger.userId,
    total: earnedExpr,
    name: schema.users.name,
    handle: schema.users.handle,
    avatarUrl: schema.users.avatarUrl,
    university: schema.users.university,
  })
  .from(schema.pointsLedger)
  .innerJoin(schema.users, sql`${schema.users.id} = ${schema.pointsLedger.userId}`)
  .where(and(...conds))
  .groupBy(
    schema.pointsLedger.userId,
    schema.users.name,
    schema.users.handle,
    schema.users.avatarUrl,
    schema.users.university,
  )
  .orderBy(desc(earnedExpr))
  .limit(20);

// Üniversite takım tablosu (tüm zamanlar)
const uniRows = await db
  .select({
    university: schema.users.university,
    total: earnedExpr,
    members: sql<number>`count(distinct ${schema.users.id})`,
  })
  .from(schema.pointsLedger)
  .innerJoin(schema.users, sql`${schema.users.id} = ${schema.pointsLedger.userId}`)
  .where(and(sql`${schema.pointsLedger.delta} > 0`, isNotNull(schema.users.university)))
  .groupBy(schema.users.university)
  .orderBy(desc(earnedExpr))
  .limit(10);

const tabs = [
  { key: "7", label: "7 gün" },
  { key: "30", label: "30 gün" },
  { key: "all", label: "Tüm zamanlar" },
];
const madalya = ["🥇", "🥈", "🥉"];
---

<ToplulukLayout title="Liderlik" description="Topluluğun en çok katkı verenleri.">
  <section class="girih-texture -mx-4 px-4 py-12">
    <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">🏆 Liderlik</h1>
    <p class="mt-2 text-ink-muted">Katkı puanla, puan kitapla ödüllenir. İlk 10'a dönem sonu kitap ödülü.</p>
  </section>

  <nav class="mt-6 flex gap-2" aria-label="Dönem">
    {
      tabs.map((x) => (
        <a
          href={`/lider?t=${x.key}`}
          aria-current={tab === x.key ? "page" : undefined}
          class:list={[
            "pill-pop rounded-full border px-4 py-1.5 text-sm",
            tab === x.key
              ? "border-accent bg-accent-soft font-semibold text-accent"
              : "border-line text-ink-muted hover:border-accent hover:text-accent",
          ]}
        >
          {x.label}
        </a>
      ))
    }
  </nav>

  <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_320px]">
    <ol class="space-y-2" data-stagger>
      {rows.length === 0 && <p class="text-ink-muted">Bu dönemde henüz puan kazanılmadı.</p>}
      {
        rows.map((r, i) => (
          <li>
            <a
              href={`/u/${r.handle}`}
              class="hover-lift flex items-center gap-4 rounded-xl border border-line bg-surface-raised px-4 py-3 hover:border-accent/50"
            >
              <span class="w-8 text-center font-display text-lg font-bold text-ink-muted">
                {madalya[i] ?? i + 1}
              </span>
              {r.avatarUrl && <img src={r.avatarUrl} alt="" width="36" height="36" class="size-9 rounded-full" />}
              <span class="min-w-0 flex-1">
                <span class="block truncate font-medium text-ink">{r.name}</span>
                <span class="text-xs text-ink-muted">
                  @{r.handle} · Sv {levelFor(Number(r.total))}
                  {r.university && ` · ${r.university}`}
                </span>
              </span>
              <span class="font-display text-lg font-semibold text-accent">{r.total}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <aside class="rounded-2xl border border-line bg-surface-raised p-5" data-reveal>
      <h2 class="font-display text-lg font-semibold text-ink">🎓 Üniversiteler</h2>
      {uniRows.length === 0 && <p class="mt-2 text-sm text-ink-muted">Profilinde üniversiteni belirt, takımına puan kazandır.</p>}
      <ol class="mt-3 space-y-2 text-sm">
        {
          uniRows.map((u, i) => (
            <li class="flex items-center justify-between rounded-lg border border-line px-3 py-2">
              <span class="truncate text-ink">{madalya[i] ?? i + 1} {u.university}</span>
              <span class="ml-2 shrink-0 text-ink-muted">{u.total} p · {u.members} üye</span>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</ToplulukLayout>
