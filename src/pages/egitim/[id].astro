---
/** Eski adres: /egitim/[id] → /kurslar/[slug] (301). Astro.redirect varsayılanı 302'dir. */
import { eq } from "drizzle-orm";
import { db, schema } from "@/db/client.ts";
import { R } from "@/lib/routes.ts";

export const prerender = false;

const raw = Astro.params.id ?? "";
const id = /^\d{1,9}$/.test(raw) ? Number(raw) : 0; // "1e400"/"1.5" → Postgres hatası yerine 301
const kurs = id
  ? await db.query.courses.findFirst({ where: eq(schema.courses.id, id) })
  : undefined;
return Astro.redirect(kurs ? `${R.kurs(kurs.slug)}${Astro.url.search}` : R.kurslar, 301);
---
