---
/** Üye profili: seviye, puan, yazılar, açılan kitaplar (sosyal kanıt). */
import { desc, eq, and } from "drizzle-orm";
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import { db, schema } from "@/db/client.ts";
import { levelFor, pointsToNextLevel } from "@/lib/levels.ts";
import { earnedPoints, getOrCreateMember } from "@/lib/member.ts";
import { engelDurumu } from "@/lib/mesaj.ts";
import { R } from "@/lib/routes.ts";

export const prerender = false;

const { handle } = Astro.params;
const user = await db.query.users.findFirst({
  where: eq(schema.users.handle, handle ?? ""),
});
if (!user) return Astro.redirect("/topluluk");

const [earned, posts, access] = await Promise.all([
  earnedPoints(user.id),
  db.query.memberPosts.findMany({
    where: and(
      eq(schema.memberPosts.userId, user.id),
      eq(schema.memberPosts.status, "published"),
    ),
    orderBy: desc(schema.memberPosts.publishedAt),
  }),
  db.query.bookAccess.findMany({ where: eq(schema.bookAccess.userId, user.id) }),
]);
const level = levelFor(earned);
const toNext = pointsToNextLevel(earned);

// Takip durumu (Medium tarzı)
const ziyaretci = await getOrCreateMember(Astro);
const [takipciler, takipEdiyorMu] = await Promise.all([
  db.query.follows.findMany({ where: eq(schema.follows.followedId, user.id) }),
  ziyaretci
    ? db.query.follows.findFirst({
        where: and(
          eq(schema.follows.followerId, ziyaretci.id),
          eq(schema.follows.followedId, user.id),
        ),
      })
    : Promise.resolve(undefined),
]);
// Engel iki yönlü etkir: biri diğerini engellediyse Mesaj düğmesi yok (F4-04, PRD §4.6). Düğme ayarı
// "kimse" olan üyede de yoktur: yokluğu tek başına engeli ele vermesin (konuşma sayfası iki durumda da
// "şu an yeni mesaj almıyor" der). Engelleyen kendi engelini "Engeli kaldır" olarak görür.
const baskasi = !!ziyaretci && ziyaretci.id !== user.id;
const engel = baskasi ? await engelDurumu(ziyaretci!.id, user.id) : { benim: false, karsi: false };
const sikayetBandi = Astro.url.searchParams.get("sikayet");
const books = await getCollection("books");

// 🏅 Rozet vitrini (kalıcı DB rozetleri)
const dbRozetler = await db.query.badges.findMany({
  where: eq(schema.badges.userId, user.id),
});
const ROZET_META: Record<string, string> = {
  "ilk-yazi": "✍️ İlk Yazı",
  "streak-7": "🔥 7 Gün Seri",
  "streak-30": "🔥🔥 30 Gün Seri",
  "gorev-10": "🔨 10 Görev",
  "quiz-ustasi": "🧠 Quiz Ustası",
  "davetci-5": "🤝 Davetçi",
  "kulup-kurucu": "🏛️ Kulüp Kurucu",
  "sezon-sampiyonu": "🏆 Sezon Şampiyonu",
  "lig-birincisi": "🥇 Lig Birincisi",
  "usta-okur": "📚 Usta Okur",
};
const shelf = access
  .map((a) => books.find((b) => b.data.id === a.bookId)?.data)
  .filter(Boolean);

// Türetilen + kalıcı rozetler tek vitrinde (tekrarlar elenir)
const rozetler = [
  ...new Set([
    ...dbRozetler.map((r) => ROZET_META[r.kind] ?? r.kind),
    posts.length >= 3 && "🔗 Zincir (3 yazı)",
    user.role === "rep" && "🏛️ Temsilci",
    user.role === "admin" && "⭐ Kurucu",
  ]),
].filter(Boolean) as string[];

const socials = (() => {
  try {
    return JSON.parse(user.socials ?? "{}") as Record<string, string>;
  } catch {
    return {};
  }
})();
const SOSYAL_ETIKET: Record<string, string> = {
  linkedin: "in",
  github: "gh",
  instagram: "ig",
  youtube: "yt",
  x: "𝕏",
  website: "🌐",
};
---

<Base title={`@${user.handle}`} description={`${user.name} — topluluk profili`}>
  {sikayetBandi && (
    <p class="menu-pop mb-4 rounded-2xl border border-accent bg-accent-soft p-3 text-center text-sm text-ink" data-sikayet-bandi>
      {sikayetBandi === "hiz" ? "Saatte en çok 10 şikâyet gönderebilirsin; biraz sonra yeniden dene." : sikayetBandi === "var" ? "Bu şikâyetin zaten inceleme kuyruğunda." : "Şikâyetin alındı; inceleme kuyruğuna düştü."}
    </p>
  )}
  <section class="girih-texture -mx-4 flex flex-wrap items-center gap-6 px-4 py-12">
    {user.avatarUrl && (
      <span class="relative">
        <img src={user.avatarUrl} alt="" width="88" height="88" class="size-22 rounded-full border-2 border-accent" />
        <span class="absolute -bottom-1 -right-1 flex size-8 items-center justify-center rounded-full bg-accent font-display text-sm font-bold text-surface">{level}</span>
      </span>
    )}
    <div>
      <h1 class="font-display text-3xl font-semibold text-ink">{user.name}</h1>
      <p class="text-ink-muted">@{user.handle}{user.university && ` · ${user.university}`}{user.city && ` · ${user.city}`}</p>
      {user.bio && <p class="mt-1 max-w-md text-sm text-ink-muted">{user.bio}</p>}
      {
        Object.keys(socials).length > 0 && (
          <p class="mt-2 flex flex-wrap gap-2">
            {Object.entries(socials).map(([key, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer nofollow"
                title={key}
                class="pill-pop flex size-8 items-center justify-center rounded-full border border-line bg-surface-raised text-xs font-bold text-ink-muted hover:border-accent hover:text-accent"
              >
                {SOSYAL_ETIKET[key] ?? "↗"}
              </a>
            ))}
          </p>
        )
      }
      {rozetler.length > 0 && (
        <p class="mt-2 flex flex-wrap gap-2">
          {rozetler.map((r) => (
            <span class="rounded-full border border-line bg-surface-raised px-3 py-1 text-xs font-medium text-ink">{r}</span>
          ))}
        </p>
      )}
    </div>
    <div class="ml-auto flex flex-wrap items-center justify-end gap-4">
      {
        baskasi && !engel.benim && !engel.karsi && user.dmPolicy !== "nobody" && (
          <a
            href={R.uye.mesaj(user.handle)}
            class="rounded-full border border-accent px-5 py-2 text-sm font-medium text-accent transition-colors hover:bg-accent hover:text-surface"
            data-mesaj-gonder
          >
            ✉️ Mesaj gönder
          </a>
        )
      }
      {
        baskasi && (
          <form method="post" action="/api/uye/takip">
            <input type="hidden" name="action" value={takipEdiyorMu ? "unfollow" : "follow"} />
            <input type="hidden" name="handle" value={user.handle} />
            <button
              class:list={[
                "cursor-pointer rounded-full px-5 py-2 text-sm font-medium transition-transform hover:scale-105 active:scale-[0.97]",
                takipEdiyorMu
                  ? "border border-line text-ink-muted"
                  : "bg-accent text-surface shadow-lg shadow-accent/25",
              ]}
            >
              {takipEdiyorMu ? "Takiptesin ✓" : "Takip et"}
            </button>
          </form>
        )
      }
      <div class="rounded-xl border border-line bg-surface-raised px-5 py-3 text-center">
        <p class="font-display text-2xl font-semibold text-accent" data-ticker>{earned}</p>
        <p class="text-xs text-ink-muted">
          kazanılan puan · {takipciler.length} takipçi{toNext !== null && ` · sonraki seviyeye ${toNext}`}
        </p>
      </div>
    </div>
  </section>

  {
    baskasi && (
      <div class="mt-3 flex flex-wrap items-center justify-end gap-4 text-xs text-ink-muted" data-profil-islemler>
        <form method="post" action="/api/uye/mesaj">
          <input type="hidden" name="kisi" value={user.handle} />
          <input type="hidden" name="next" value={R.profil(user.handle)} />
          <button name="action" value={engel.benim ? "engel-kaldir" : "engelle"} class="cursor-pointer hover:text-red-500" data-engel-dugmesi>
            {engel.benim ? "Engeli kaldır" : "Engelle"}
          </button>
        </form>
        <details class="relative">
          <summary class="cursor-pointer list-none hover:text-red-500" data-sikayet-ac>Şikâyet et</summary>
          <form method="post" action="/api/uye/sikayet" class="absolute right-0 z-10 mt-2 grid w-64 gap-2 rounded-xl border border-line bg-surface-raised p-3 shadow-lg">
            <input type="hidden" name="targetType" value="user" />
            <input type="hidden" name="targetId" value={user.id} />
            <input type="hidden" name="next" value={R.profil(user.handle)} />
            <input name="reason" maxlength="300" placeholder="Neden? (isteğe bağlı)" class="rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-ink" />
            <button class="cursor-pointer rounded-full border border-red-400 px-3 py-1.5 text-sm text-red-500 transition-colors hover:bg-red-500 hover:text-white">Şikâyeti gönder</button>
          </form>
        </details>
      </div>
    )
  }

  <section class="mt-8 grid gap-8 lg:grid-cols-[1fr_280px]">
    <div>
      <h2 class="font-display text-xl font-semibold text-ink">Yazılar ({posts.length})</h2>
      {posts.length === 0 ? (
        <p class="mt-3 text-ink-muted">Henüz yayınlanmış yazısı yok.</p>
      ) : (
        <ul class="mt-3 space-y-2" data-stagger>
          {posts.map((p) => (
            <li>
              <a href={`/topluluk/${p.slug}`} class="hover-lift block rounded-lg border border-line bg-surface-raised px-4 py-3 font-medium text-ink hover:border-accent/50 hover:text-accent">
                {p.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    <aside>
      <h2 class="font-display text-xl font-semibold text-ink">Okuma rafı ({shelf.length})</h2>
      <ul class="mt-3 grid grid-cols-3 gap-2">
        {shelf.slice(0, 9).map((b) => (
          <li>
            <a href={`/kutuphane/kitap/${b!.id}`} class="book-3d block" title={b!.titleTr ?? b!.title}>
              {b!.cover ? (
                <img src={b!.cover} alt={b!.title} width="160" height="213" loading="lazy" class="aspect-[3/4] w-full rounded border border-line object-cover" />
              ) : (
                <span class="flex aspect-[3/4] items-center justify-center rounded border border-line bg-accent-soft p-1 text-center text-[10px] font-semibold text-accent">{b!.title}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </section>
</Base>
