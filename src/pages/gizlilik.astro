---
/**
 * Gizlilik ve kişisel veriler — KVKK aydınlatma TASLAĞI (Faz 5 hesap imzası incelemesi #8; merge incelemesi #17–#22).
 * Metin hukuki danışmanlık değildir; yayından önce Yusuf okur / düzeltir. Veri kalemleri KODDAN türetildi
 * (users, learning_list/book_access, points_ledger, invite_visits, events/event_rsvps/event_staff, messages, blocks,
 * reports, applications, notifications); saklama süreleri `SAKLAMA_GUN` sabitinden okunur (cron aynı sayıyı kullanır).
 * Yeni bir kişisel veri kalemi eklenirse bu tabloya da eklenir. Hesap silme akışı YOK (FK'ler) → talep elle anonimleştirilir.
 */
import Base from "@/layouts/Base.astro";
import { SAKLAMA_GUN } from "@/lib/economy.ts";

const UYELIK = "Üyelik süresince (silme talebinde elle anonimleştirilir)";
const kalemler = [
  ["Hesap bilgileri", "Ad, e-posta, profil görseli ve Google kimliği (Clerk üzerinden giriş); ilk girişte Clerk kaydından alınır", "Üyelik, giriş, bildirim", "Sözleşme (üyelik)", UYELIK],
  ["Profil", "Kullanıcı adı, biyografi, sosyal bağlantılar, üniversite ve il", "Topluluk profili; il yalnız açık rızanızla üye haritasında", "Rıza / sözleşme", "Siz silene kadar"],
  ["Topluluk içeriği", "Yazılar, yorumlar, beğeniler, takipler, quiz denemeleri, kitaplık ve açılan kitaplar, kampanya oyları, günlük seri", "Topluluk işleyişi, puan", "Sözleşme", UYELIK],
  ["Puan defteri", "Kazanılan / harcanan puan, bekleyen puan, seviye, rozet, kurs ilerlemesi", "Topluluk ekonomisi, liderlik ve lig sıralaması", "Sözleşme", UYELIK],
  ["Kayıt imzası", "Kayıt anındaki IP adresinin gizli anahtarla özetlenmiş kısa hash'i (ham IP saklanmaz; ziyaret kayıtlarıyla eşleştirilemez)", "Davet puanı suistimalinin (aynı ağdan açılan çok sayıda hesap) tespiti", "Meşru menfaat", `${SAKLAMA_GUN.kayitImzasi} gün (inceleme süren hesapta karar verilene kadar)`],
  ["Davet ziyareti", "Davet bağlantısına tıklayan cihazın IP ve tarayıcı özetinin hash'i (kimlikle bağlanmaz)", "Hız sınırı, davet istatistiği", "Meşru menfaat", `${SAKLAMA_GUN.davetZiyareti} gün`],
  ["Suistimal işareti", "Kayıt imzası taramasının (aynı davet eden + aynı imzayla 24 saatte 5 ve üzeri hesap) sonucu ve yönetici kararı", "Liderlik / lig sıralaması, bekleyen puanın tutulması", "Meşru menfaat", "Yönetici kaldırana kadar"],
  ["Etkinlik", "Kayıt, giriş zamanı ve yöntemi, okutan görevli, davet eden, öncelikli koltuk, değerlendirmeniz", "Etkinlik katılımı ve puan; katılımcı listesi (ad, kullanıcı adı, giriş zamanı) etkinliği düzenleyen üyeye ve yöneticiye CSV olarak verilir", "Sözleşme", UYELIK],
  ["Mesajlar", "Üyeler arası özel mesaj metni ve okunma anı", "Üyeler arası iletişim, şikâyet incelemesi", "Sözleşme", UYELIK],
  ["Engel ve şikâyet", "Engellediğiniz üyeler; şikâyet ettiğiniz içerik / üye ve gerekçeniz", "Güvenlik, moderasyon", "Meşru menfaat", UYELIK],
  ["Başvuru ve bildirim", "Temsilcilik başvurusu (tür, yer, mesaj); size gönderilen bildirimler", "Başvuru değerlendirme, bilgilendirme", "Sözleşme", UYELIK],
] as const;
---

<Base title="Gizlilik ve kişisel veriler">
  <article class="mx-auto max-w-3xl">
    <h1 class="font-display text-3xl font-semibold text-ink">Gizlilik ve kişisel veriler</h1>
    <div class="prose prose-lg mt-6 dark:prose-invert prose-a:text-accent">
      <p>
        Bu sayfa, 6698 sayılı Kişisel Verilerin Korunması Kanunu kapsamında hangi verinizi neden ve ne kadar süreyle
        işlediğimizi açıklar. Veri sorumlusu site sahibidir; iletişim için <a href="/hakkimda">Hakkımda</a> sayfasındaki
        kanalları kullanabilirsiniz.
      </p>
      <p>
        Kişisel verileriniz satılmaz ve reklam amacıyla üçüncü kişilerle paylaşılmaz. Giriş hizmeti Clerk, veri tabanı
        Neon ve barındırma Vercel yurt dışında sunucu kullanır; aktarım bu hizmetlerin sözleşmeleriyle sınırlıdır.
        Harita karoları OpenStreetMap'ten, kurs videoları YouTube'dan (çerezsiz oynatıcı), kitaplar Google Drive ve
        NotebookLM'den doğrudan tarayıcınıza yüklenir; bu servisler isteği yapan IP adresinizi görür.
      </p>
    </div>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-line text-left text-ink-muted">
            <th class="py-2 pr-3 font-medium">Veri</th>
            <th class="py-2 pr-3 font-medium">İçerik</th>
            <th class="py-2 pr-3 font-medium">Amaç</th>
            <th class="py-2 pr-3 font-medium">Dayanak</th>
            <th class="py-2 font-medium">Süre</th>
          </tr>
        </thead>
        <tbody>
          {kalemler.map(([veri, icerik, amac, dayanak, sure]) => (
            <tr class="border-b border-line align-top text-ink">
              <th scope="row" class="py-2 pr-3 text-left font-medium">{veri}</th>
              <td class="py-2 pr-3">{icerik}</td>
              <td class="py-2 pr-3">{amac}</td>
              <td class="py-2 pr-3">{dayanak}</td>
              <td class="py-2">{sure}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="prose prose-lg mt-8 dark:prose-invert prose-a:text-accent">
      <h2>Çerezler</h2>
      <p>
        Oturum çerezi Clerk tarafından giriş için kurulur. Bir davet bağlantısıyla geldiyseniz davet çerezleri
        (<code>ysf_ref</code>, <code>ysf_davet</code>) {SAKLAMA_GUN.davetZiyareti} gün tutulur ve yalnız davet edeni
        eşlemek için okunur. Tema tercihiniz tarayıcınızda saklanır. Reklam ya da izleme çerezi yoktur.
      </p>
      <h2>Haklarınız</h2>
      <p>
        KVKK'nın 11. maddesi uyarınca verilerinize erişme, düzeltme, silme, işlemeye itiraz etme ve işlemenin
        kapsamını öğrenme hakkınız vardır. Profil alanlarını, harita görünürlüğünü ve mesaj ayarını
        <a href="/uye/profil">profil ayarlarından</a> değiştirebilirsiniz. Hesabınızın kapatılmasını iletişim
        kanallarından isteyebilirsiniz; talep elle işlenir ve kişisel alanlar anonimleştirilir.
      </p>
      <p class="text-sm text-ink-muted">Son güncelleme: 12 Ekim 2026.</p>
    </div>
  </article>
</Base>
