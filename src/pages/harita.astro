---
/**
 * Türkiye haritası — Leaflet + OpenStreetMap karoları (başlangıç görünümü zoom 6, 39.03/35.25).
 * Sunucu: il başına ANONİM üye sayısı + onaylı kulüpler + ildeki yaklaşan etkinlikler → JSON veri bloğu.
 * Üye ızgarası (F4-02): yalnız "Haritada görün" rızası vermiş üyeler ve YALNIZ girişli üyeye
 * (lib/harita.ts haritaUyeleri: rıza + iki yönlü engel SQL'de — AC-21/AC-22). Filtreler sorgu
 * parametresi: ?topluluk=<slug> · ?kurs=<slug> · ?takip=1 (ızgarayı süzer; anonim sayım süzülmez).
 * Sayfa bakana özeldir: CDN'de paylaşımlı önbelleğe ALINMAZ (cache başlığı ekleme).
 * İstemci: il rozet işaretçileri, DOM ile kurulan popup (kullanıcı metni yalnız textContent —
 * innerHTML YOK) ve autoPan: popup daima görünür (mobilde kesilme yok). Karolar ziyaretçinin
 * tarayıcısından tile.openstreetmap.org'a gider (OSMF karo politikası: hafif kullanım + atıf).
 * İl sınırları: src/data/il-sinirlari.json (OSM/Nominatim, ODbL; scripts/il-sinirlari-cek.ts) → ton = kulüp sayısı.
 * JS'siz yedek: kulüp olan illerin listesi (/kulupler?il=).
 */
import { asc, eq, sql } from "drizzle-orm";
import { SignInButton } from "@clerk/astro/components";
import ToplulukLayout from "@/layouts/ToplulukLayout.astro";
import { db, schema } from "@/db/client.ts";
import { haritaEtkinlikleri, haritaUyeleri, type HaritaIl } from "@/lib/harita.ts";
import { getOrCreateMember } from "@/lib/member.ts";
import { R } from "@/lib/routes.ts";
import { ilBul } from "@/lib/topluluk.ts";
import iller from "@/data/il-koordinatlari.json";
import "leaflet/dist/leaflet.css";

export const prerender = false;

const member = await getOrCreateMember(Astro);

// İl başına üye sayısı (gizlilik: yalnızca il düzeyi, anonim — filtreden bağımsız)
const cityRows = await db
  .select({ city: schema.users.city, c: sql<number>`count(*)` })
  .from(schema.users)
  .groupBy(schema.users.city);
const memberByIl = new Map<string, number>();
for (const r of cityRows) {
  const match = ilBul(r.city);
  if (match) memberByIl.set(match, (memberByIl.get(match) ?? 0) + Number(r.c));
}

// DİKKAT: tek tablolu select'te Drizzle, seçim listesindeki sql`` içinde kolonların tablo adını ATAR
// (${schema.clubs.id} → "id") → ilişkili alt sorgu kendi tablosunun id'siyle karşılaştırırdı (her kulüp
// "1 üye" görünüyordu). Dış başvuru düz metin olarak tablo adıyla yazılır.
const memberCount = sql<number>`(select count(*) from club_members cm where cm.club_id = "clubs"."id")`;
const clubs = await db
  .select({ id: schema.clubs.id, slug: schema.clubs.slug, name: schema.clubs.name, il: schema.clubs.il, members: memberCount })
  .from(schema.clubs)
  .where(eq(schema.clubs.status, "approved"))
  .orderBy(asc(schema.clubs.name));

const clubsByIl = new Map<string, { slug: string; name: string; members: number }[]>();
for (const c of clubs) {
  const match = ilBul(c.il);
  if (!match) continue;
  if (!clubsByIl.has(match)) clubsByIl.set(match, []);
  clubsByIl.get(match)!.push({ slug: c.slug, name: c.name, members: Number(c.members) });
}

// Filtreler yalnız üyede (ızgara misafire üretilmez). Seçenekler: onaylı topluluklar, yayındaki kurslar
const q = Astro.url.searchParams;
const kurslar = member
  ? await db
      .select({ id: schema.courses.id, slug: schema.courses.slug, title: schema.courses.title })
      .from(schema.courses)
      .where(eq(schema.courses.status, "published"))
      .orderBy(asc(schema.courses.title))
      .limit(200)
  : [];
const seciliKulup = member ? clubs.find((c) => c.slug === q.get("topluluk")) : undefined;
const seciliKurs = kurslar.find((k) => k.slug === q.get("kurs"));
const takip = !!member && q.get("takip") === "1";
const filtreli = !!(seciliKulup || seciliKurs || takip);

const [gorunenler, etkinlikler] = await Promise.all([
  member
    ? haritaUyeleri(member.id, { kulupId: seciliKulup?.id, kursId: seciliKurs?.id, takip })
    : new Map<string, HaritaIl>(),
  haritaEtkinlikleri(),
]);

// 81 ilin tamamı (sınır tonu için sıfırlar da gerekli); rozet yalnız veri olan illerde (istemci süzer)
const pinler = Object.entries(iller as unknown as Record<string, [number, number]>).map(([il, [lon, lat]]) => ({
  il,
  lat,
  lon,
  uye: memberByIl.get(il) ?? 0,
  kulupler: clubsByIl.get(il) ?? [],
  uyeler: gorunenler.get(il)?.uyeler ?? [],
  gorunen: gorunenler.get(il)?.toplam ?? 0,
  etkinlikler: etkinlikler.get(il) ?? [],
}));
const toplamUye = [...memberByIl.values()].reduce((a, b) => a + b, 0);
const toplamGorunen = pinler.reduce((a, p) => a + p.gorunen, 0);
const veri = { pinler, bakan: member?.handle ?? null, filtreli };
---

<ToplulukLayout title="Harita" description="Türkiye'de okuma toplulukları — şehrinde kulüp kur.">
  <section class="girih-texture -mx-4 px-4 py-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">🗺️ Harita</h1>
        <p class="mt-2 text-ink-muted">
          <strong class="text-accent" data-ticker>{clubs.length}</strong> kulüp ·
          <strong class="text-accent" data-ticker>{toplamUye}</strong> konumlu üye
        </p>
      </div>
      <a href="/kulup-kur" class="rounded-full bg-accent px-6 py-3 font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">
        Şehrinde kulüp yok mu? Kur <span class="arrow-slide">→</span>
      </a>
    </div>
  </section>

  {member ? (
    <form method="get" action={R.harita} class="mt-6 flex flex-wrap items-end gap-3 rounded-2xl border border-line bg-surface-raised p-4 text-sm" data-harita-filtre>
      <label class="grid gap-1">
        <span class="text-ink-muted">Topluluk</span>
        <select name="topluluk" class="max-w-52 rounded-lg border border-line bg-surface px-3 py-2">
          <option value="">Tümü</option>
          {clubs.map((c) => <option value={c.slug} selected={c.slug === seciliKulup?.slug}>{c.name}</option>)}
        </select>
      </label>
      <label class="grid gap-1">
        <span class="text-ink-muted">Bu kursu alanlar</span>
        <select name="kurs" class="max-w-52 rounded-lg border border-line bg-surface px-3 py-2">
          <option value="">Tümü</option>
          {kurslar.map((k) => <option value={k.slug} selected={k.slug === seciliKurs?.slug}>{k.title}</option>)}
        </select>
      </label>
      <label class="flex min-h-10 items-center gap-2 text-ink">
        <input type="checkbox" name="takip" value="1" checked={takip} class="size-4 accent-[var(--accent)]" />
        Takip ettiklerim
      </label>
      <button class="cursor-pointer rounded-full bg-accent px-5 py-2 font-medium text-surface transition-transform hover:scale-105 active:scale-[0.97]">Uygula</button>
      {filtreli && <a href={R.harita} class="py-2 text-ink-muted hover:text-accent">Temizle</a>}
      <p class="w-full text-xs text-ink-muted" data-harita-gorunen>
        {filtreli ? "Filtreye uyan" : "Haritada görünen"} <strong class="text-ink">{toplamGorunen}</strong> üye.
        {!member.mapVisibleAt && (
          <>
            {" "}Sen görünmüyorsun — <a href={R.uye.profil} class="text-accent hover:underline">profilinden "Haritada görün"ü aç</a>.
          </>
        )}
      </p>
    </form>
  ) : (
    <p class="mt-6 rounded-2xl border border-line bg-surface-raised p-4 text-sm text-ink-muted" data-harita-misafir>
      Haritada görünmeyi seçen üyeleri görmek ve onlara mesaj göndermek için{" "}
      <SignInButton mode="modal" forceRedirectUrl={R.harita} signUpForceRedirectUrl={R.harita} asChild>
        <button type="button" class="cursor-pointer font-medium text-accent hover:underline">giriş yap</button>
      </SignInButton>.
    </p>
  )}

  <div class="mt-4 overflow-hidden rounded-2xl border border-line bg-surface-raised" data-reveal>
    <div id="harita" class="h-[60vh] min-h-80 w-full sm:h-[70vh]" role="region" aria-label="Türkiye üye ve kulüp haritası"></div>
    <noscript><p class="p-4 text-sm text-ink-muted">Harita için JavaScript gerekir; aşağıdaki şehir listesini kullan.</p></noscript>
  </div>
  {/* `<` kaçışı ZORUNLU: kulüp/üye adı kullanıcı metni, kapanış etiketiyle bloktan kaçabilir */}
  <script type="application/json" id="harita-veri" set:html={JSON.stringify(veri).replace(/</g, "\\u003c")} />

  {pinler.some((p) => p.kulupler.length > 0) && (
    <ul class="mt-4 flex flex-wrap gap-2 text-sm" aria-label="Kulüp olan şehirler">
      {pinler
        .filter((p) => p.kulupler.length > 0)
        .map((p) => (
          <li>
            <a href={`/kulupler?il=${encodeURIComponent(p.il)}`} class="inline-block rounded-full border border-line px-3 py-1 text-ink hover:border-accent hover:text-accent">
              {p.il} · {p.kulupler.length} kulüp
            </a>
          </li>
        ))}
    </ul>
  )}

  <p class="mt-4 text-sm text-ink-muted">
    Konumlar il düzeyindedir; profilindeki şehir alanından beslenir. İl sayıları anonimdir: bir üye yalnız profilinde
    "Haritada görün"ü açtıysa, o da yalnız giriş yapmış üyelere adıyla gösterilir. İl tonu kulüp sayısını gösterir; rozete ya da ile dokun, kulübe katıl —
    <a href="/kulupler" class="text-accent hover:underline">tüm kulüpler</a>.
  </p>
</ToplulukLayout>

<style is:global>
  /* Leaflet sayfa tokenlarına uyar; karolar koyu temada ters çevrilir */
  .leaflet-container { font: inherit; background: var(--surface-raised); }
  .leaflet-container a { color: var(--accent); }
  .harita-rozet {
    display: flex; width: 28px; height: 28px; align-items: center; justify-content: center;
    border-radius: 9999px; border: 2px solid var(--surface); background: var(--ink); color: var(--surface);
    font-size: 12px; font-weight: 700; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s;
  }
  .harita-rozet-kulup { background: var(--accent); }
  /* Filtre açıkken rozet = filtreye uyan görünen üye sayısı */
  .harita-rozet-filtre { background: var(--surface); color: var(--accent); border-color: var(--accent); }
  .leaflet-marker-icon:hover .harita-rozet, .leaflet-marker-icon:focus-visible .harita-rozet { transform: scale(1.15); }
  .leaflet-popup-content-wrapper, .leaflet-popup-tip {
    background: var(--surface-raised); color: var(--ink); border: 1px solid var(--line);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18); border-radius: 1rem;
  }
  .leaflet-popup-content { margin: 14px 16px; line-height: 1.4; }
  .leaflet-container a.leaflet-popup-close-button { color: var(--ink-muted); }
  .leaflet-bar a { background: var(--surface-raised); color: var(--ink); border-color: var(--line); }
  /* Atıf: zorunlu ama göze batmasın — arka plansız, 9 px, yarı saydam; üzerine gelince okunur */
  .leaflet-control-attribution { background: transparent; color: var(--ink-muted); font-size: 9px; line-height: 1; opacity: 0.45; padding: 2px 4px; transition: opacity 0.15s; }
  .leaflet-control-attribution:hover { opacity: 1; }
  .leaflet-container .leaflet-control-attribution a { color: inherit; text-decoration: none; }
  [data-theme="dark"] .leaflet-tile { filter: invert(100%) hue-rotate(180deg) brightness(95%) contrast(90%); }
  /* İl sınırları: CSS, Leaflet'in inline sunum özniteliklerini ezer → tokenlar + koyu tema bedava */
  .il-sinir { fill: var(--accent); fill-opacity: 0.06; stroke: var(--accent); stroke-opacity: 0.55; stroke-width: 1; cursor: pointer; transition: fill-opacity 0.15s; }
  .il-sinir-uye { fill-opacity: 0.16; }
  .il-sinir-1 { fill-opacity: 0.32; }
  .il-sinir-2 { fill-opacity: 0.5; }
  .il-sinir:hover { fill-opacity: 0.62; stroke-opacity: 1; }
</style>

<script>
  import L from "leaflet";
  import type { FeatureCollection } from "geojson";
  import sinirlar from "@/data/il-sinirlari.json";

  type Kulup = { slug: string; name: string; members: number };
  type Uye = { h: string; ad: string; av: string | null; sv: number; ortak?: string[] };
  type Etkinlik = { yol: string; ad: string; zaman: string };
  type Pin = { il: string; lat: number; lon: number; uye: number; kulupler: Kulup[]; uyeler: Uye[]; gorunen: number; etkinlikler: Etkinlik[] };
  type Veri = { pinler: Pin[]; bakan: string | null; filtreli: boolean };

  const el = <K extends keyof HTMLElementTagNameMap>(etiket: K, sinif: string, metin?: string) => {
    const e = document.createElement(etiket);
    e.className = sinif;
    if (metin !== undefined) e.textContent = metin;
    return e;
  };
  const baglanti = (href: string, sinif: string, metin: string) => {
    const a = el("a", sinif, metin);
    a.href = href;
    return a;
  };
  const bolum = (metin: string) => el("p", "mt-3 text-xs font-semibold uppercase tracking-wide text-ink-muted", metin);

  /** Popup içeriği DOM ile kurulur: kulüp/üye/etkinlik adı kullanıcı metnidir → textContent (innerHTML yok) */
  function popupIcerigi(p: Pin, bakan: string | null): HTMLElement {
    const kap = document.createElement("div");
    kap.append(
      el("p", "font-display text-lg font-semibold text-ink", p.il),
      el("p", "mt-0.5 text-sm text-ink-muted", `${p.uye} üye · ${p.kulupler.length} kulüp`),
    );
    if (p.kulupler.length > 0) {
      const liste = el("div", "mt-2 space-y-1.5 text-sm");
      for (const k of p.kulupler) {
        const a = baglanti(`/kulup/${encodeURIComponent(k.slug)}`, "block rounded-lg border border-line px-3 py-2 text-ink hover:border-accent hover:text-accent", k.name);
        a.append(el("span", "text-xs text-ink-muted", ` · ${k.members} üye`));
        liste.append(a);
      }
      kap.append(liste);
    }
    // Üye ızgarası: yalnız "Haritada görün" rızası verenler; sunucu yalnız girişli üyeye gönderir
    if (p.uyeler.length > 0) {
      kap.append(bolum(`Haritada görünenler (${p.gorunen})`));
      const izgara = el("div", "mt-1.5 space-y-1.5 text-sm");
      izgara.dataset.haritaUyeler = p.il;
      for (const u of p.uyeler) {
        const satir = el("div", "flex items-center gap-2");
        satir.dataset.uye = u.h;
        if (u.av && u.av.startsWith("https://")) {
          const img = el("img", "size-7 shrink-0 rounded-full border border-line object-cover");
          img.src = u.av;
          img.alt = "";
          img.loading = "lazy";
          img.referrerPolicy = "no-referrer";
          satir.append(img);
        } else {
          satir.append(el("span", "flex size-7 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent", (u.ad[0] ?? "?").toLocaleUpperCase("tr")));
        }
        satir.append(
          baglanti(`/u/${encodeURIComponent(u.h)}`, "min-w-0 flex-1 truncate font-medium text-ink hover:text-accent", u.ad),
          el("span", "shrink-0 text-xs text-ink-muted", `Sv ${u.sv}`),
        );
        if (bakan && u.h !== bakan)
          satir.append(baglanti(`/uye/mesajlar/${encodeURIComponent(u.h)}`, "shrink-0 rounded-full border border-line px-2 py-0.5 text-xs text-accent hover:border-accent", "Mesaj"));
        izgara.append(satir);
        // Bakanla ortak topluluk / kurs (yalnız bakanın kendi üyeliklerinden; metin textContent)
        // div: Leaflet'in `.leaflet-popup-content p { margin }` kuralı p'yi üyeler arasında yüzdürürdü
        if (u.ortak?.length) izgara.append(el("div", "-mt-1 break-words pl-9 text-xs text-ink-muted", `Ortak: ${u.ortak.join(" · ")}`));
      }
      kap.append(izgara);
      if (p.gorunen > p.uyeler.length) kap.append(el("p", "mt-1 text-xs text-ink-muted", `+${p.gorunen - p.uyeler.length} üye daha`));
    }
    if (p.etkinlikler.length > 0) {
      kap.append(bolum("Yaklaşan etkinlikler"));
      const liste = el("div", "mt-1.5 space-y-1.5 text-sm");
      for (const e of p.etkinlikler) {
        const a = baglanti(e.yol, "block rounded-lg border border-line px-3 py-2 text-ink hover:border-accent hover:text-accent", e.ad);
        a.append(el("span", "block text-xs text-ink-muted", e.zaman));
        liste.append(a);
      }
      kap.append(liste);
    }
    if (p.kulupler.length === 0)
      kap.append(baglanti("/kulup-kur", "mt-3 inline-block text-sm font-medium text-accent hover:underline", "Bu şehirde kulüp kur →"));
    return kap;
  }

  let harita: L.Map | undefined;
  // ClientRouter gezintisinde (filtre formu dahil) eski harita bırakılır: dinleyici/karo sızıntısı olmasın
  document.addEventListener("astro:before-swap", () => {
    harita?.remove();
    harita = undefined;
  });

  document.addEventListener("astro:page-load", () => {
    const kap = document.getElementById("harita");
    if (!kap || kap.dataset.init) return;
    kap.dataset.init = "1";
    const { pinler, bakan, filtreli } = JSON.parse(document.getElementById("harita-veri")?.textContent ?? '{"pinler":[]}') as Veri;
    const pinMap = new Map(pinler.map((p) => [p.il, p]));
    const bosPin = (il: string): Pin => ({ il, lat: 0, lon: 0, uye: 0, kulupler: [], uyeler: [], gorunen: 0, etkinlikler: [] });
    // Dar ekranda popup harita kutusundan geniş olmasın (autoPan iki kenarı birden sığdıramaz → kırpılır)
    const POPUP: L.PopupOptions = { maxWidth: Math.min(280, kap.clientWidth - 76), maxHeight: 260, autoPanPadding: [16, 16] };

    const TURKIYE: L.LatLngBoundsLiteral = [[35.8, 25.6], [42.2, 44.9]];
    const map = (harita = L.map(kap, {
      center: [39.03, 35.25], // openstreetmap.org/#map=6/39.03/35.25
      zoom: 6,
      minZoom: 5,
      maxZoom: 14,
      zoomControl: false, // sol üstte popup'la çakışıyordu → sağ alta (popup yukarı açılır)
      scrollWheelZoom: false, // sayfa kaydırmasını çalmasın; haritaya odaklanınca açılır
      // Gevşek sınır: dar/dikey ekranda zoom 5 görünümü Türkiye'den geniştir; sıkı sınır popup'ın
      // autoPan'ını moveend'de geri alıp popup'ı kırpıyordu (ölçüldü). Kuzey payı geniş: popup yukarı
      // açılır ve üye ızgarası + etkinliklerle 260 px'e uzar (kuzey illerinde ~5° kaydırma gerekir).
      maxBounds: [[30, 18], [54, 52]],
      maxBoundsViscosity: 0.8,
    }));
    map.fitBounds(TURKIYE, { padding: [8, 8] }); // dar ekranda da tüm ülke görünsün (zoom konteynere göre)
    L.control.zoom({ position: "bottomright" }).addTo(map);
    map.on("focus", () => map.scrollWheelZoom.enable());
    map.on("blur", () => map.scrollWheelZoom.disable());
    // Atıf ZORUNLU (OSMF karo politikası + ODbL); "Leaflet" öneki kaldırıldı, metin küçük ve yarı saydam (CSS)
    map.attributionControl.setPrefix(false);
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(map);

    // İl sınırları (OSM, ODbL): ton = kulüp sayısı; tıklanınca aynı popup
    L.geoJSON(sinirlar as unknown as FeatureCollection, {
      style: (f) => {
        const p = pinMap.get(f?.properties?.il);
        const k = p?.kulupler.length ?? 0;
        return { className: `il-sinir il-sinir-${Math.min(k, 2)}${!k && (p?.uye ?? 0) > 0 ? " il-sinir-uye" : ""}` };
      },
      onEachFeature: (f, layer) => layer.bindPopup(() => popupIcerigi(pinMap.get(f.properties.il) ?? bosPin(f.properties.il), bakan), POPUP),
    }).addTo(map);

    for (const p of pinler) {
      // Filtre açıkken rozet yalnız filtreye uyan görünen üyesi olan ilde; değilse veri olan her ilde
      if (filtreli ? p.gorunen === 0 : p.uye === 0 && p.kulupler.length === 0 && p.etkinlikler.length === 0) continue;
      const kulup = p.kulupler.length > 0;
      // Yalnız etkinliği olan ilde (üye ve kulüp yok) sayı yerine takvim: "N üye" diye okunmasın
      const yalnizEtkinlik = !filtreli && !kulup && p.uye === 0;
      const sayi = filtreli ? p.gorunen : kulup ? p.kulupler.length : p.uye; // sayı: güvenli HTML
      const sinif = filtreli ? " harita-rozet-filtre" : kulup ? " harita-rozet-kulup" : "";
      const baslik = filtreli
        ? `${p.il}: filtreye uyan ${p.gorunen} üye`
        : yalnizEtkinlik
          ? `${p.il}: ${p.etkinlikler.length} yaklaşan etkinlik`
          : `${p.il}: ${p.uye} üye, ${p.kulupler.length} kulüp`;
      const icon = L.divIcon({
        className: "",
        html: `<span class="harita-rozet${sinif}">${yalnizEtkinlik ? "📅" : Number(sayi)}</span>`,
        iconSize: [28, 28],
        iconAnchor: [14, 14],
        popupAnchor: [0, -14],
      });
      L.marker([p.lat, p.lon], { icon, title: baslik })
        .bindPopup(() => popupIcerigi(p, bakan), POPUP)
        .addTo(map);
    }
  });
</script>
