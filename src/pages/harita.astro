---
/**
 * Türkiye haritası — Skool map'in sıfır bağımlılık karşılığı.
 * İl merkezleri lat/lon'dan basit doğrusal projeksiyonla yerleşir;
 * kulüp pinleri + il başına üye kümeleri, tıklanınca popover.
 */
import { eq, sql } from "drizzle-orm";
import ToplulukLayout from "@/layouts/ToplulukLayout.astro";
import { db, schema } from "@/db/client.ts";
import iller from "@/data/il-koordinatlari.json";

export const prerender = false;

// Projeksiyon: lon 25.5–45.5 → x 20–980; lat 42.5–35.5 → y 20–420
const W = 1000;
const H = 440;
const px = (lon: number) => 20 + ((lon - 25.5) / 20) * (W - 40);
const py = (lat: number) => 20 + ((42.5 - lat) / 7) * (H - 40);
const normalize = (s: string) => s.trim().toLocaleLowerCase("tr");

// İl başına üye sayısı (gizlilik: yalnızca il düzeyi)
const cityRows = await db
  .select({ city: schema.users.city, c: sql<number>`count(*)` })
  .from(schema.users)
  .groupBy(schema.users.city);
const memberByIl = new Map<string, number>();
for (const r of cityRows) {
  if (!r.city) continue;
  const match = Object.keys(iller).find((il) => normalize(il) === normalize(r.city!));
  if (match) memberByIl.set(match, (memberByIl.get(match) ?? 0) + Number(r.c));
}

const memberCount = sql<number>`(select count(*) from ${schema.clubMembers} where ${schema.clubMembers.clubId} = ${schema.clubs.id})`;
const clubs = await db
  .select({
    slug: schema.clubs.slug,
    name: schema.clubs.name,
    kind: schema.clubs.kind,
    place: schema.clubs.place,
    il: schema.clubs.il,
    members: memberCount,
  })
  .from(schema.clubs)
  .where(eq(schema.clubs.status, "approved"));

const clubsByIl = new Map<string, typeof clubs>();
for (const c of clubs) {
  const match = Object.keys(iller).find((il) => normalize(il) === normalize(c.il));
  if (!match) continue;
  if (!clubsByIl.has(match)) clubsByIl.set(match, []);
  clubsByIl.get(match)!.push(c);
}

const pinler = Object.entries(iller as unknown as Record<string, [number, number]>)
  .map(([il, [lon, lat]]) => ({
    il,
    x: px(lon),
    y: py(lat),
    uye: memberByIl.get(il) ?? 0,
    kulupler: clubsByIl.get(il) ?? [],
  }))
  .filter((p) => p.uye > 0 || p.kulupler.length > 0);
---

<ToplulukLayout title="Harita" description="Türkiye'de okuma toplulukları — şehrinde kulüp kur.">
  <section class="girih-texture -mx-4 px-4 py-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">🗺️ Harita</h1>
        <p class="mt-2 text-ink-muted">
          <strong class="text-accent" data-ticker>{clubs.length}</strong> kulüp ·
          <strong class="text-accent" data-ticker>{[...memberByIl.values()].reduce((a, b) => a + b, 0)}</strong> konumlu üye
        </p>
      </div>
      <a href="/kulup-kur" class="rounded-full bg-accent px-6 py-3 font-medium text-surface transition-transform hover:scale-105">
        Şehrinde kulüp yok mu? Kur <span class="arrow-slide">→</span>
      </a>
    </div>
  </section>

  <div class="relative mt-6 overflow-hidden rounded-2xl border border-line bg-surface-raised" data-reveal>
    <svg viewBox={`0 0 ${W} ${H}`} class="w-full" role="img" aria-label="Türkiye üye ve kulüp haritası">
      <!-- Stilize Türkiye silüeti (dekoratif, çini tonunda) -->
      <path
        d="M 40 210 Q 60 150 130 140 Q 170 100 250 110 Q 330 70 430 85 Q 540 60 650 80 Q 760 65 850 95 Q 930 110 965 160 Q 975 210 940 250 Q 960 290 920 320 Q 850 360 760 345 Q 660 380 560 360 Q 460 385 360 365 Q 250 380 170 340 Q 90 320 60 270 Q 35 240 40 210 Z"
        fill="var(--accent-soft)"
        stroke="var(--accent)"
        stroke-opacity="0.35"
        stroke-width="2"
      />
      {
        pinler.map((p) => (
          <g
            class="harita-pin cursor-pointer"
            data-il={p.il}
            data-uye={p.uye}
            data-kulupler={JSON.stringify(p.kulupler)}
            transform={`translate(${p.x} ${p.y})`}
          >
            {p.kulupler.length > 0 ? (
              <>
                <circle r="13" fill="var(--accent)" class="transition-transform" />
                <text y="5" text-anchor="middle" font-size="12" fill="var(--surface)" font-weight="700">
                  {p.kulupler.length}
                </text>
              </>
            ) : (
              <>
                <circle r="11" fill="var(--ink)" opacity="0.85" />
                <text y="4" text-anchor="middle" font-size="10" fill="var(--surface)" font-weight="600">
                  {p.uye}
                </text>
              </>
            )}
          </g>
        ))
      }
    </svg>

    <!-- Skool tarzı popover -->
    <div
      id="harita-pop"
      class="menu-pop pointer-events-auto absolute z-20 hidden w-64 rounded-2xl border border-line bg-surface-raised p-4 shadow-xl"
    >
      <p class="font-display text-lg font-semibold text-ink" id="pop-il"></p>
      <p class="mt-0.5 text-sm text-ink-muted" id="pop-uye"></p>
      <div id="pop-kulupler" class="mt-2 space-y-1.5 text-sm"></div>
      <a id="pop-kur" href="/kulup-kur" class="mt-3 inline-block text-sm font-medium text-accent hover:underline">
        Bu şehirde kulüp kur →
      </a>
    </div>
  </div>

  <p class="mt-4 text-sm text-ink-muted">
    Konumlar il düzeyindedir; profilindeki şehir alanından beslenir.
    Kulüp pinine tıkla, katıl — <a href="/kulupler" class="text-accent hover:underline">tüm kulüpler</a>.
  </p>
</ToplulukLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const pop = document.getElementById("harita-pop");
    if (!pop || pop.dataset.init) return;
    pop.dataset.init = "1";
    const wrap = pop.parentElement!;
    for (const pin of document.querySelectorAll<SVGGElement>(".harita-pin")) {
      pin.addEventListener("click", (e) => {
        e.stopPropagation();
        const kulupler = JSON.parse(pin.dataset.kulupler ?? "[]") as {
          slug: string; name: string; members: number; place: string;
        }[];
        document.getElementById("pop-il")!.textContent = pin.dataset.il ?? "";
        document.getElementById("pop-uye")!.textContent = `${pin.dataset.uye} üye · ${kulupler.length} kulüp`;
        const list = document.getElementById("pop-kulupler")!;
        list.innerHTML = kulupler
          .map(
            (k) =>
              `<a href="/kulup/${k.slug}" class="block rounded-lg border border-line px-3 py-2 hover:border-accent hover:text-accent">${k.name} <span class="text-xs" style="color:var(--ink-muted)">· ${k.members} üye</span></a>`,
          )
          .join("");
        document.getElementById("pop-kur")!.style.display = kulupler.length ? "none" : "inline-block";
        // pinin ekran konumuna yerleştir
        const pr = pin.getBoundingClientRect();
        const wr = wrap.getBoundingClientRect();
        pop.style.left = `${Math.min(Math.max(pr.left - wr.left - 110, 8), wr.width - 270)}px`;
        pop.style.top = `${pr.top - wr.top + 24}px`;
        pop.classList.remove("hidden");
      });
    }
    document.addEventListener("click", (e) => {
      if (!pop.contains(e.target as Node)) pop.classList.add("hidden");
    });
  });
</script>
