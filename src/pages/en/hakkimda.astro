---
import { getCollection, getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/features/projects/ProjectCard.astro";
import { localizePath, useTranslations } from "@/lib/i18n/index.ts";

const entry = await getEntry("singletons", "hakkimda.en");
if (!entry) throw new Error("singletons/hakkimda.en.mdx bulunamadı");
const { Content } = await render(entry);
const t = useTranslations("en");
const projeler = (await getCollection("projeler"))
  .filter((p) => p.data.oneCikan)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title={entry.data.title}>
  <article class="mx-auto max-w-2xl">
    <h1 class="font-display text-3xl font-semibold text-ink">{entry.data.title}</h1>
    <div class="prose prose-lg mt-6 dark:prose-invert prose-a:text-accent">
      <Content />
    </div>

    {
      projeler.length > 0 && (
        <section class="mt-10">
          <div class="flex items-baseline justify-between">
            <h2 class="font-display text-xl font-semibold text-ink">
              {t("proje.baslik")}
            </h2>
            <a
              href={localizePath("/projeler", "en")}
              class="text-sm font-medium text-accent hover:underline"
            >
              {t("proje.tumProjeler")} →
            </a>
          </div>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {projeler.map((proje) => (
              <li>
                <ProjectCard proje={proje} lang="en" />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
