---
/** Seviye rozetli avatar — topluluk genelinde tek görünüm. */
interface Props {
  name: string;
  avatarUrl?: string | null;
  level?: number;
  size?: "sm" | "md" | "lg";
}
const { name, avatarUrl, level, size = "md" } = Astro.props;
const boyut = { sm: "size-7", md: "size-10", lg: "size-14" }[size];
const rozet = { sm: "size-4 text-[9px]", md: "size-5 text-[10px]", lg: "size-6 text-xs" }[size];
---

<span class="relative inline-block shrink-0">
  {
    avatarUrl ? (
      <img src={avatarUrl} alt="" class:list={[boyut, "rounded-full border border-line object-cover"]} loading="lazy" />
    ) : (
      <span class:list={[boyut, "flex items-center justify-center rounded-full bg-accent-soft font-display font-semibold text-accent"]}>
        {name[0]?.toLocaleUpperCase("tr")}
      </span>
    )
  }
  {
    level !== undefined && (
      <span
        class:list={[rozet, "absolute -bottom-0.5 -right-0.5 flex items-center justify-center rounded-full bg-accent font-bold text-surface"]}
        title={`Seviye ${level}`}
      >
        {level}
      </span>
    )
  }
</span>
