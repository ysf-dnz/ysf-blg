---
import type { Page } from "astro";

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="mt-10 flex items-center justify-center gap-3 text-sm" aria-label="Sayfalama">
      {page.url.prev ? (
        <a href={page.url.prev} class="rounded-md border border-line px-3 py-1.5 hover:border-accent hover:text-accent">
          ←
        </a>
      ) : (
        <span class="rounded-md border border-line px-3 py-1.5 opacity-40">←</span>
      )}
      <span class="text-ink-muted">
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? (
        <a href={page.url.next} class="rounded-md border border-line px-3 py-1.5 hover:border-accent hover:text-accent">
          →
        </a>
      ) : (
        <span class="rounded-md border border-line px-3 py-1.5 opacity-40">→</span>
      )}
    </nav>
  )
}
